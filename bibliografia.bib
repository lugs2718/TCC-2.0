   issue = {8},
   journal = {Journal of the Aerospace Sciences},
   month = {8},
   pages = {969-975},
   publisher = {American Institute of Aeronautics and Astronautics (AIAA)},
   title = {On the Theory of Laminated Anisotropic Shells and Plates},
