ima",selectOne:"Selecciona una opción",selectUpTo:"Selecciona hasta {{max}}",selectOneOrMore:"Selecciona una o más",pollOptions:"Opciones de la encuesta",deletePoll:"Eliminar encuesta",expand:"Expandir encuesta",collapse:"Contraer encuesta",vote:"voto",votes:"votos",closedSuffix:" · cerrada",tapToSee:" · toca para ver",optionResultAria:"{{option}} — {{pct}}%, {{count}} votos",closedNoVotes:"Cerrada · sin votos",tapToVote:"Toca una opción para votar",seeVoters:"Ver quién votó",closeVote:"Cerrar votación",whoVoted:"Quién votó",noVotes:"Sin votos",votersError:"No se pudieron cargar los votos. Inténtalo de nuevo.",participant:"Participante",andMoreVoters:"y {{count}} más",loadMoreVoters:"Cargar {{count}} más",searchVoters:"Buscar participante…",noVotersFound:"Ningún participante encontrado",voteError:{title:"No fue posible registrar tu voto",description:"Inténtalo de nuevo en un momento."}},mention:{someone:"miembro",suggestionsAria:"Sugerencias de mención",ariaLabel:"mención a {{name}}"}}}}},mue={es:{translations:{disableAccountModal:{title:"¡Oh no! Lamentamos que te vayas.",headerDescription:"Cuéntanos por qué estás desactivando tu cuenta para que podamos evolucionar cada vez más.",footerDescription:"Cuando desactivas tu cuenta, nadie más tendrá acceso a la información registrada durante la prueba.",test_stopped_successfully:"La prueba se detuvo con éxito",cancel:"Cancelar",disable:"Desactivar cuenta",textAreaPlaceholder:"Habla un poco más (opcional)",disableOptions:{moreCompleteLmsPlataform:"Voy a otra plataforma LMS más completa",lessExpensiveLmsPlataform:"Voy a otra plataforma LMS con precio más bajo",dontWantLmsPlataform:"No quiero una plataforma LMS en este momento",otherReason:"Otros"},reasonRequired:"Por favor seleccione una razón."},trialModalDelete:{descriptions:{allInfo:"Toda la información predefinida de SophiaTech.",adminCourses:"Cursos, pistas y contenidos creados por los administradores.",adminUsers:"Usuarios registrados por los administradores.",allInfo