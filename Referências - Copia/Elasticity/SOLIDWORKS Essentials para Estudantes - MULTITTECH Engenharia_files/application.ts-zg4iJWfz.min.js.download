lidacion.com",exampleBadge:"Ejemplo",sheetTitle:"Informe de firmas",envelopeSection:"SOBRE",envelopeDescription:"Descripción del sobre",envelopeId:"ID del sobre",verificationHint:"Usa la cámara del celular para escanear el código QR y verificar la autenticidad de las firmas.",validateOnlyThisDocument:"Para validar solo este documento, informe el código:",envelopeVerificationCode:"Código de verificación del sobre:",fileSection:"ARCHIVO",hashLabel:"Hash",signedBySection:"FIRMADO POR",dateTimeLabel:"Fecha y hora:",timezoneLabel:"Zona horaria:",signedAsLabel:"Firmado como:",signedAsValue:"Firmante",signatureLabel:"Firma: Electrónica",emailLabel:"Correo electrónico:",ipLabel:"IP:",geolocationLabel:"Geolocalización:",pageIndicator:"Página 1 de 1"},validatorTab:{enableValidator:"Habilitar validador del certificado",enableValidatorToolTip:"Agrega un enlace al certificado para su validación por Twygo, asegurando su autenticidad.",toAccessCertificate:"Para validar este certificado, acceda",certificate:"Certificado"},signatureTab:{enableSignature:"Mostrar la firma del estudiante",enableSignatureToolTip:"Se mostrará un sello con la firma del estudiante en la ubicación configurada. Se imprimirán en el certificado datos como nombre, fecha, hora y dirección IP.",signatureColor:"Color de la firma",enableTechnicalSignature:"Mostrar la firma del responsable",enableTechnicalSignatureToolTip:"Cuando está activado, el certificado mostrará una firma electrónica adicional para el responsable del contenido, en la posición configurada.",colorAppliesToStudent:"Se aplica a la firma del estudiante (seleccionada)",colorAppliesToTechnical:"Se aplica a la firma del responsable (seleccionada)",colorAppliesToStudentOnly:"Se aplica a la firma del estudiante",colorAppliesToTechnicalOnly:"Se aplica a la firma del responsable",colorAppliesToBoth:"Selecciona una firma en el certificado para aplicar solo a una — sin selección, el color se aplica a las dos."},textPage:{textTitle:"Texto",addText:"Agregar t