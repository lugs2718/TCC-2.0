at best fits the tone of this model. You can hear a sample of each voice before deciding.",exampleLabel:"Sample text:",exampleText:"Hello! Welcome. In this training about strategic leadership we will explore a case study of organizational resilience and discuss the importance of assertive feedback. We will also unpack the meaning of the phrase 'active learning sharpens autonomy' and how it applies day to day. Additionally, we will cover topics such as gamification and metacognition.",loading:"Loading voices...",retry:"Try again",errors:{loadFailed:"Could not load voices. Please try again.",playFailed:"Could not play the sample. Please try again."},backgroundMusic:{title:"Background music",description:"A gentle soundtrack will play at low volume during the lessons to make the experience more dynamic.",enableLabel:"Enable music",useDefault:"Use default music",uploadMode:"Upload file",loading:"Loading music...",uploadAudioFile:"Upload audio file",noFileUploaded:"No file uploaded. Audio formats up to 15MB.",uploadSuccess:"Music uploaded successfully.",endOfAudioLabel:"When the audio ends",endOfAudioDescription:"What to do when the music ends before the video.",loopOption:"Play on loop",loopOptionDescription:"The music restarts automatically",onceOption:"Play only once",onceOptionDescription:"The music stops when it ends",errors:{loadFailed:"Could not load the music. Please try again.",playFailed:"Could not play the music. Please try again.",uploadFailed:"Could not upload the music. Please try again."}}},design:{}},share:{requiresSavedModel:"Save the model before configuring sharing",requiresSavedModelDescription:"The Share tab will be available after the first save of the model."},designTab:{requiresSavedModel:"Save the model before configuring designs",requiresSavedModelDescription:"The Design tab will be available after the first save of the model.",searchPlaceholder:"Search by design name",list:{fields:{name:"Name",partType:"Part type",format:"Format"}},types:{lesson:"Lesson",page:"Page"},filters:{onlyPages:"Pages only",onlyLessons:"Lessons only"},addMenu:{button:"Add",lesson:"Lesson",page:"Page"},actions:{preview:"Preview",edit:"Edit",duplicate:"Duplicate",delete:"Delete",confirmDeleteTitle:"Delete design",confirmDeleteMessage:"This action cannot be undone. Are you sure you want to delete?"},toast:{duplicateSuccess:"Design duplicated successfully",duplicateError:"Error duplicating the design",deleteSuccess:"Design deleted successfully",reorderSuccess:"Design order updated successfully",reorderError:"Error updating design order"},previewModal:{subtitleLesson:"Lesson preview",subtitlePage:"Page preview (use zoom and scroll to explore)",zoomIn:"Zoom in",zoomOut:"Zoom out",empty:"This design does not have a preview yet",designLabel:"Design"},reorder:{disabledTooltip:"Clear the filters to reorder the designs."},regenerate:{button:"Regenerate all",tooltip:"The brand kit has changed. Click 'Regenerate all' to update every design with the new color and font settings.",toastStarted:"Design regeneration has started. This screen will update when it completes.",error:"Could not start design regeneration",processing:"Regenerating designs...",success:"Designs regenerated successfully",failed:"Could not regenerate the designs. Please try again.",timeout:"Design regeneration is taking longer than expected. Reload the page in a few minutes to check the result.",lastAttemptFailed:"The last design regeneration failed. Click 'Regenerate all' to try again."},card:{warningTooltip:"Design pending regeneration — the brand kit has been updated"}},pageDesignForm:{newTitle:"New page",editTitle:"Edit page",headers:{create:"New design — Page",edit:"Edit design — Page"},tabs:{identification:"Identification",design:"Design"},design:{gatedTooltip:"Save the Identification tab first",gatedMessage:"Save the Identification tab to unlock the design editor."},readOnlyMessage:"This design is read-only.",identification:{fields:{name:{label:"Name",placeholder:"E.g.: Institutional opening slide"},type:{label:"Type",placeholder:"Select or type a type",tooltip:"Classify this design by part type (e.g.: Cover, Body, Conclusion). This information will be used to filter and organize your designs."},structureInstructions:{label:"Structure instructions for AI",placeholder:"Describe when and in what context this design should be used",tooltip:"Describe when and in what context this design should be used by the AI when generating the course. Use the suggested prompts below as a starting point and edit as needed."},contentInstructions:{label:"Content instructions for AI",placeholder:"Describe how the AI should structure and style the content",tooltip:"Describe how the AI should structure and style the content displayed in this design."},sequence:{label:"Sequence",placeholder:"1",tooltip:"Define the position this design should appear in the list. E.g.: 1 = first, 2 = second. If that position is already taken, this design enters it and the following ones move down automatically."}},validation:{nameRequired:"Enter the name",nameMaxLength:"Name must be at most {{max}} characters",structureInstructionsRequired:"AI structure instructions is required",structureInstructionsMaxLength:"Maximum {{max}} characters",contentInstructionsMaxLength:"Maximum {{max}} characters",sequenceRequired:"Enter the sequence",sequenceMin:"Sequence must be greater than zero"},buttons:{save:"Save",cancel:"Cancel"}},predefinedFormats:{cover:"Cover",introduction:"Introduction",body:"Body",conclusion:"Conclusion",recap:"Recap",summary:"Summary"},prompts:{structure:{cover:"Always use as the first part of any lesson.",introduction:"Apply at the beginning of the content to contextualize the topic. Ideal when there is a motivating question or learning goal to highlight.",body:"Use for expository parts with the main content. Prefer this design when the content is textual or includes a supporting image alongside.",conclusion:"Reserve for the last part of the lesson. Use when there is a call to action, final summary, or motivational closing message.",recap:"Use after content blocks to reinforce the main points already presented.",summary:"Apply at the start of the lesson to list the topics that will be covered."},content:{cover:"Should contain the lesson title centered and prominent. The text should be short, objective, and visually dominant. Prioritize clear title/subtitle hierarchy (if any) and an impactful visual that contextualizes the lesson topic.",introduction:"Briefly present the lesson topic, contextualizing the subject and making clear what will be learned. May include a provocative question, an initial problem, or a learning objective in highlight.",body:"Develop the main lesson content with clear explanations, examples, and logical organization. Prioritize objective texts, well-distributed paragraphs and, when applicable, supporting images that reinforce understanding.",conclusion:"Close the lesson with a summary of the main learnings, a reinforcement message, or a call to action (e.g., apply the content, advance to the next topic, or reflect on what was learned).",recap:"Present a synthesis of the concepts addressed previously. Prefer lists, bullets, or visual highlights that facilitate quick review and reinforce key points.",summary:"Display a clear and organized list of the main lesson topics. The text should be objective, serving as an initial guide to what will be covered throughout the content."}},toast:{createSuccess:"Page created successfully",updateSuccess:"Page updated successfully",error:"Error saving the page",designSaveSuccess:"Page design saved successfully",designSaveError:"Error saving the page design",previewSaveWarning:"Content saved, but the preview could not be generated."},toolbar:{brandKit:{label:"Brand kit",placeholder:"Select a kit"},font:{label:"Font"}}},lessonDesignForm:{headers:{create:"New design — Lesson",edit:"Edit design — Lesson"},tabs:{identification:"Identification",design:"Design"},identification:{buttons:{save:"Save",cancel:"Cancel"}},design:{gatedTooltip:"Save the Identification tab first",gatedMessage:"Save the Identification tab to unlock the design editor."},unsavedChanges:{title:"Unsaved changes",message:"You have unsaved changes in the design. If you leave this tab now, they will be lost.",cancel:"Cancel",confirm:"Leave without saving"},confirmChangesModal:{title:"Orientation change confirmation",description:"By changing the orientation of the template design, the current visual configuration will not be saved. Are you sure you want to change it?"},readOnlyMessage:"This design is read-only.",toast:{createSuccess:"Lesson created successfully",updateSuccess:"Lesson updated successfully",error:"Error saving the lesson",designSaveSuccess:"Design saved. Preview will be updated soon.",designSaveError:"Error saving the lesson design",missingDesignEditorConfigError:"This design has no editor configuration attached, so its content cannot be saved. Duplicate the model again or create a new design in this lesson.",backgroundImageUploadError:"Error uploading the background image. Please try again.",scriptSavedLocally:"Roadmap updated. Remember to save the design."}}},designEditor:{brandKitSelector:{title:"Brand kits"},panelItems:{logos:"Logos",reservedSlot:"AI Spaces"},logosTab:{title:"Logos",subtitle:"Logos for the selected kit",empty:"No logos available for this kit."},reservedSlotTab:{title:"AI Spaces",editTitle:"Edit AI space",instructionsLabel:"AI instructions",instructionsPlaceholder:"Describe what should appear in this slot",instructionsTooltip:"Describe what should be shown in this slot. The AI will use this description to generate the appropriate content.",insertText:"Insert text",insertImage:"Insert image",updateButton:"Update",imageLabel:"Image slot (AI)",textLabel:"Text slot (AI)",imageSubLabel:"Square (1024×1024)",textSubLabel:"Paragraph"},fontFamily:{brandFontsLabel:"Brand fonts",commonFontsLabel:"Common fonts"}},colorPicker:{brandColorsTitle:"Br