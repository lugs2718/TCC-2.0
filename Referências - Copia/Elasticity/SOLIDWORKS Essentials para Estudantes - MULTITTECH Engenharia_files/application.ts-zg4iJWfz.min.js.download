lado no campo "Definir página de redirecionamento" do PagSeguro em "A Página fixa de redirecionamento" e informe "transaction_id" no campo "Escolha um nome para o parâmetro" em "Redirecionamento com o código da transação" e clique em "Ativar".'}}},invalidOption:{modalHeader:"Ops! essa opção não está disponível no seu plano",modalBody:"Mude suas opções de assinatura clicando no menu assinaturas nas opções de configuração, ou entre em contanto com nossa equipe via chat.",modalFooterButton:"Ok, entendi"},confirmGatewayChange:{modalHeader:"Só é possível configurar cobrança automática com uma ferramenta",modalBody:"Para validar a integração de cobrança automática com essa ferramenta, a integração antiga será desabilitada. Tem certeza que deseja prosseguir?",modalFooterCancelButton:"Cancelar",modalFooterConfirmButton:"Sim, salvar",success:"Sucesso!",error:"Erro!"},transactionLogsTable:{list:{searchPlaceholder:"Pesquise por usuário, e-mail, ação ou código"},defaultFilters:{freeEnrollments:"Inscrições gratuitas",confirmedPayments:"Pagamentos confirmados"},gateways:{none:"Sem ferramenta (gratuita)"},date:"Data",environment:"Ambiente",gateway:"Ferramenta",type:"Tipo",action:"Ação",student:"Inscrito",user:"Usuário",userDeleted:"Usuário excluído",value:"Valor",paymentResponsability:{title:"Tipo de pessoa",tag:{userResponsability:"Pessoa física",companyResponsability:"Empresa"}},tid:"Código da transação",deleteWarning:"Os logs ficam disponíveis por 90 dias",manual_transaction:"Manual",system_event:"Sistema",actions:{new_invoice_link_generated:"Novo link de cobrança gerado com sucesso.",new_invoice_link_failed:"Novo link de cobrança gerado sem sucesso.",payment_confirmed:"Pagamento confirmado.",payment_overdued:"Cobrança vencida sem pagamento identificado."},sended:"Envio",received:"Retorno",disabledMessage:"Os logs de transação ficam disponíveis apenas para ambientes que usam cobrança automática."},validationToast:{requiredFields:"Existem campos obrigatórios não preenchidos",fil