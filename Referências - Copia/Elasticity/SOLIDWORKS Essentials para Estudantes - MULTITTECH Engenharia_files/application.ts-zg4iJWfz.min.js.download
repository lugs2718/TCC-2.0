 A aprovação pode ser realizada manualmente nesta página ou automaticamente através dos critérios de aprovação configurados no curso em: Editar > Aprovação.`},period:{label:"Selecionar período",LAST_7_DAYS:"7 dias",LAST_15_DAYS:"15 dias",LAST_30_DAYS:"30 dias",SINCE_CREATION:"Todo o período",CUSTOM_RANGE:"Personalizado",apply:"Aplicar",from:"De",to:"até"},toast:{chartOptions:"Ao menos uma opção de dados deve estar marcada para visualizar o gráfico."},workload:{workload:"Carga horária",hour:"hora",hours:"horas",total:"Planejada",performed:"Realizada"},completeRanking:{experiencePoints:"Pontos de experiência",seeCompleteRanking:"Ver ranking completo"},generalProgress:{generalProgress:"Progresso geral"},progressBySituation:{completed:"Concluídos",not_started:"Não iniciados",in_progress:"Em andamento"},certificates:{certificates:"Certificados"},dashboardStatistic:{generalStatistics:"Estatísticas gerais",courseMovement:"Movimentação do curso",averageProgressCompletion:"Progresso médio e conclusão",contentEngagement:"Engajamento por conteúdos",approvalStatus:"Situação de aprovação",peopleEngagement:"Engajamento por pessoas"},approvalStatus:{studentsApproved:"Aprovados",studentsCompleted:"Concluíram"},common:{perDay:"Dia",month:"Mês",year:"Ano"},questionsAndGradeAverage:{questions:"Questionários",gradeAverage:"Média geral"},dashboardTotals:{totalData:"Dados totais"},filter:{filteredBy:"Filtrado por",name:"Nome",department:"Área",role:"Cargo",enterprise:"Empresa",progress:"Progresso",situation:"Situação",clearFilter:"Limpar filtros",filter:"Filtrar",nameOfTheConsumerEnvironment:"Nome do ambiente",typeOfEnvironment:"Tipo de ambiente",placeholders:{name:"Selecione um nome",department:"Selecione uma área",role:"Selecione um cargo",enterprise:"Selecione uma empresa"},environments:{allEnvironments:"Todos os ambientes",internal:"Interno",external:"Externo"},progresses:{allStudents:"Todos os alunos",notStarted:"Não iniciados",started:"Iniciados",completed:"Concluídos"},situations: