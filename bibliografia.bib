@article{Guinovart2024,
   abstract = {This paper presents a comprehensive study on applying the two-scale asymptotic homogenization method to derive the effective properties of piezoelectric composite materials characterized by generalized periodicity in curvilinear coordinates. The methodology involves formulating the homogenization problem in a general curvilinear framework suitable for materials with complex geometric configurations. By systematically deriving the homogenized equations and effective coefficients, the paper provides a robust theoretical foundation for understanding the macroscopic behavior of piezoelectric composites under various loading conditions. The model's versatility is demonstrated through its application to specific curvilinear coordinate systems, including the helix coordinate system and cylindrical coordinates with wavy geometry. These examples highlight the potential of the proposed approach in analyzing and designing piezoelectric materials with intricate geometries. The state-of-the-art numerical homogenization methods have also validated the proposed homogenization method, ensuring its accuracy and robustness.},
   author = {David Guinovart and Mriganka Shekhar Chaki and Raúl Guinovart-Díaz},
   doi = {10.1016/j.compositesb.2024.111677},
   issn = {13598368},
   journal = {Composites Part B: Engineering},
   keywords = {Analytical modeling,Layered structures,Numerical analysis,Smart materials},
   month = {9},
   publisher = {Elsevier Ltd},
   title = {Two-scale asymptotic homogenization analysis of piezoelectric composite materials in generalized curvilinear coordinates},
   volume = {284},
   year = {2024}
}
@article{Tsalis2017,
   abstract = {In this paper, the analytical solution of the multi-step homogenization problem for multi-rank composites with generalized periodicity made of elastic materials is presented. The proposed homogenization scheme may be combined with computational homogenization for solving more complex microstructures. Three numerical examples are presented, concerning locally periodic stratified materials, matrices with wavy layers and wavy fiber-reinforced composites.},
   author = {Dimitrios Tsalis and Nicolas Charalambakis and Kevin Bonnay and George Chatzigeorgiou},
   doi = {10.1177/1081286515612142},
   issn = {17413028},
   issue = {4},
   journal = {Mathematics and Mechanics of Solids},
   keywords = {Analytical solution,Elasticity,Generalized periodicity,Micromechanics,Multi-step homogenization},
   month = {4},
