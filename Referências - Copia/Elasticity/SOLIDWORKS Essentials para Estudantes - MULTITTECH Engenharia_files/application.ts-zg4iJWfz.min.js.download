 La aprobación se puede realizar manualmente en esta página o automáticamente a través de los criterios de aprobación configurados en el curso en: Editar > Aprobación.`},period:{label:"Seleccionar periodo",LAST_7_DAYS:"7 días",LAST_15_DAYS:"15 días",LAST_30_DAYS:"30 días",SINCE_CREATION:"Todo el período",CUSTOM_RANGE:"Costumbre",apply:"Aplicar",from:"Del",to:"al"},toast:{chartOptions:"Se debe marcar al menos una opción de datos para ver el gráfico."},workload:{workload:"Carga horaria",hour:"hora",hours:"horas",total:"Planificado",performed:"Logrado"},completeRanking:{experiencePoints:"Puntos de experiencia",seeCompleteRanking:"Ver clasificación completa"},generalProgress:{generalProgress:"Progreso general"},progressBySituation:{completed:"Terminado",not_started:"No iniciado",in_progress:"En processo"},certificates:{certificates:"Certificados"},dashboardStatistic:{generalStatistics:"Estadísticas Generales",courseMovement:"Movimiento del curso",averageProgressCompletion:"Progreso promedio y finalización",contentEngagement:"Compromiso de contenido",approvalStatus:"Estado de aprobación",peopleEngagement:"Compromiso de la gente"},approvalStatus:{studentsApproved:"Aprobado",studentsCompleted:"concluido"},common:{perDay:"Día",month:"Mes",year:"Año"},questionsAndGradeAverage:{questions:"Cuestionarios",gradeAverage:"Promedio de calificaciones"},dashboardTotals:{totalData:"Datos totales"},filter:{filteredBy:"Filtrado por",name:"Nombre",department:"Área",role:"Cargo",enterprise:"Empresa",progress:"Progreso",situation:"Situación",clearFilter:"Borrar filtros",filter:"Filtrar",nameOfTheConsumerEnvironment:"Nombre del entorno",typeOfEnvironment:"Tipo de ambiente",placeholders:{name:"Seleccione un nombre",department:"Seleccione un área",role:"Seleccione un cargo",enterprise:"Seleccione una empresa"},environments:{allEnvironments:"Todos los ambientes",internal:"Interno",external:"Externo"},progresses:{allStudents:"Todos los estudiantes",notStarted:"No iniciados",started:"Iniciados",