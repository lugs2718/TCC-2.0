rd"},"step_04":{"default_color_infor":"*Actions Buttons, Menu icons and selections","default_color_text_infor":"*System text","description":"\\u003cp\\u003e You may customize the colors and logo on your page. Later, you may customize other parts of the product!\\u003cp\\u003e","logo_infor":"*PNG, JPG or GIF\\u003cbr\\u003e**Maximum 60px height","organization_name":"Let\'s go, give Twygo the {{name}}\'s face"},"welcome":"Welcome to Twygo!","welcome_mobile":"Welcome to"},"online_debit":"Online debit","open_public_chat_content":"Open public chat content","order_number":"Order number","ordering_of_question":"Question order","org_clone":{"coverage_entities":{"assessments_competency":"Competency assessments","assessments_performance":"Performance assessments","assessments_total":"Assessments (total)","box_placements":"Nine-box placements","campaigns":"Campaigns","communities":"Communities","cycles":"Cycles","journey_tasks":"Journey tasks","journeys":"Journeys","organization_chart_competencies":"Org chart competencies","organization_chart_roles":"Org chart roles","organization_goals":"Goals (PDI)","performance_entries":"Feedback","reward_store_categories":"Rewards store categories","reward_store_rewards":"Rewards store items","users":"Users"},"create":{"enqueued":"Clone of %{organization} queued. Track the status in the history."},"delete":{"button":"Delete organization","confirm":"Delete the cloned organization? This triggers organization exclusion (not a hard delete).","enqueued":"Exclusion triggered — the cloned organization will be deleted.","not_deletable":"Cannot delete (clone in progress, no target organization, or already deleted)."},"errors":{"demo_access_into_existing_target":"Demo access does not apply when the target is an existing organization: the clone does not reset the password of a real user at the target. Clear the demo access e-mail and password, or leave the target organization ID blank.","destination_invalid":"Invalid target organization (does not exist or is the same as the origin).","domain_creation_failed":"Could not create the default domain after %{attempts} attempts: %{reason}","domain_failure_unknown":"save returned false with no error message","feature_disabled":"Organization clone is not enabled for this organization.","generic":"An error occurred while processing the clone.","organization_required":"Enter a valid origin organization ID.","target_busy_timeout":"Target busy with another clone beyond the wait timeout."},"form":{"contract_plan":"Contract (plan) for the cloned organization","contract_plan_blank":"No contract (clone without a plan)","contract_plan_hint":"Plan used to create the new organization\'s contract (active, monthly, with the plan\'s credits). Optional.","demo_user_email":"Demo access (user e-mail at origin)","demo_user_email_hint":"E-mail of an origin organization user that becomes the demo access. The login shown on the clone details is the e-mail that user has AT THE TARGET: with anonymization on, the anonymized e-mail; with it off, the person\'s real e-mail. Blank = no demo access.","demo_user_password":"Demo access password","demo_user_password_hint":"Password to set for that user in the cloned organization. Blank = the system generates one and shows it on the clone details.","modules_hint":"Check the subsystems to copy. Unchecking does not break the clone — it just skips that item, and its coverage is ignored in the status. Note: several depend on Users (without them, profiles/assessments/PDI etc. come empty).","modules_title":"What to clone","origin_organization_id":"Origin organization ID","origin_organization_id_hint":"Enter the numeric ID of the organization to be cloned.","overwrite_existing":"Overwrite what already exists in the target","overwrite_existing_hint":"Only applies when the target is an existing org. Unchecked (default) = keeps what the target already has. Checked = overwrites identity/config/DHO with the origin data. Content is never duplicated.","preserved_user_email":"User to preserve on randomize (email)","preserved_user_email_hint":"Email of a user from the origin organization who will NOT be anonymized, so they can log into the cloned org. Blank = preserves whoever triggered the clone.","randomize":"Anonymize data (randomize)","randomize_hint":"When checked, names and emails of copied users will be anonymized.","submit":"Start clone","subtitle":"Creates a full copy of an organization into a new target organization.","target_name":"Target organization name","target_name_hint":"Name to be given to the new organization.","target_organization_id":"Target organization ID (existing)","target_organization_id_hint":"Blank = creates a new organization (default). Filled = clones INTO that existing organization (updates/merges).","title":"New organization clone"},"inactivate":{"button":"Inactivate organization","confirm":"Inactivate the cloned organization? It still exists but becomes inactive/inaccessible.","done":"Cloned organization inactivated.","not_inactivatable":"Cannot inactivate (clone in progress, no target organization, or already deleted).","target_missing":"This clone\'s target organization no longer exists."},"index":{"actions_menu":"Actions","active_banner":{"one":"%{count} clone in progress","other":"%{count} clones in progress"},"auto_refresh_note":"Auto-refreshes every 5 seconds","column_created_at":"Date","column_duration":"Duration","column_origin":"Origin organization","column_status":"Status","column_target":"Target organization","column_triggered_by":"Triggered by","empty":"No clones executed yet.","empty_async":"Organization cloning runs in the background (Sidekiq queue). As soon as you trigger one, it shows up here immediately — you don\'t need to wait for it to finish to see it. Each run goes through the statuses below:","empty_detail_hint":"Click \\"View details\\" on any run to track entity coverage and the per-module report.","empty_stuck_body":"If a run stays queued for too long, the Sidekiq queue 