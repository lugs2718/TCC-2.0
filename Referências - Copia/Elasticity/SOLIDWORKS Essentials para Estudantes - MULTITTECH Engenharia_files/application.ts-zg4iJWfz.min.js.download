lert:{message:"The informed code does not have the standard format of game tools. Do you want to save anyway?",yes:"Yes",cancel:"Cancel"},youtubeSaveConfirmation:{title:"Save confirmation",messageLink:"The link provided does not match the standard YouTube format. Do you want to save anyway?",messageEmbed:"The embed code provided does not match the expected format (iframe with YouTube embed URL). Do you want to save anyway?",cancel:"Cancel",save:"Save"}}}},Zle={en:{translations:{autoCharge:{tabTitle:"Automatic billing"},coupons:{add:{label:"+ Add",PageToolTip:"Register Coupons and Vouchers to ensure promotional discounts on enrollment sales.",voucherToolTip:"Vouchers are vouchers that guarantee a credit (in R$) for your student to use in the purchase.",couponToolTip:"Coupons are percentage values that can be deducted from the price of a sale."},tabTitle:"Coupons and vouchers",name:"Name",type:{header:"Type",coupon:"Coupon",voucher:"Voucher"},code:"Code",situation:{header:"Situation",expired:"Expired",active:"Active"},value:"Value",itensApplied:"Applied to items",validUntil:"Valid until",checkAllEvents:"Click here to see all courses.",form:{toast:{error:"Error saving coupon",fieldsWithoutFill:"There are required fields without filling",fillToSave:"Fill to save"},title:"New coupon or voucher",coupon:"Coupon",voucher:"Voucher",name:"Name",nameOf:"Name of",code:"Code",discountTen:"Discount10",eventRequired:"Select at least one item",value:"Value",appliedToItens:"Applied to items",stillNotApplied:'This {{discountType}} is not yet applied to any item. Click "add" to apply',validUntil:"Valid until",save:"Save",isRequired:"{{field}} is required",dateInPast:"The date informed cannot be less than the current date",back:"Back",type:"Type",invalidDate:"Invalid date"},ConfirmCouponDelete:{message:"If the discount is active, students who have the code will no longer be able to use it. Are you sure you want to delete it?",success:"{{discountType}} has been successfully deleted"},selectEventsCoupon:{header:"{{discountType}} applied to items",message:"This {{discountType}} is applied to the items below. To add new ones, type to search.",searchPlaceholder:"Type to search",save:"Save",coupon:"Coupon",voucher:"Voucher",success:"{{discountType}} applied to items",event:"Course",learningPath:"Learning Path",package:"Package",couponExpired:"Your students will no longer be able to use this discount. To add new items, define a new expiration date.",couponExpiredTitle:"This {{discountType}} has expired",noEvents:"No results found"},breadcumb:{subscriptionConfig:"Registration charge",new:"New"}},transactionLogs:{tabTitle:"Transaction logs"},enableSubscriptionCharging:"Enable subscription charging",selectBillingTool:"Select billing tool",save:"Save",asaas:"ASAAS",pagseguro:"PagSeguro",erede:"Rede",gatewayForms:{isRequired:"{{field}} is required",keys:{asaas_key:"API Key",boleto_deadline_days:"Boleto deadline days",email:"Email",token:"Token",erede_pv:"Filiation Number (PV)",erede_key:"Integration Key"},asaas:{apiKey:"API Key",apiSite:"Website (to be completed on Asaas)",pixAndBoleto:"Pix and Boleto",creditAndDebitCard:"Credit and Debit Card",selectPaymentMethods:"Select which methods you wish to use for charging registrations",boletoExpiration:"Specify the deadline for the boleto to expire (in business days)",asaasCreateAccount:"Or click here to create a free Asaas account",apiKeyTooltip:"Key provided by Asaas. In Asaas: after confirming your account, click on your profile picture in the top corner: Integrations > API Key > Generate new key > Copy and paste into the field below.",apiSiteTooltip:'To integrate, copy the address below and paste it into your Asaas account. To do this, go to: User menu > My account > Information > Commercial data. The data must be pasted in the "Site" field.',apiKeyPlaceholder:"Paste the API Key here",or:"Or",clickHere:"click here",toCreateAccount:"to create a free Asaas account"},pagseguro:{label:{pagseguroEmail:"PagSeguro Email",token:"PagSeguro Token",notification:"Notification",returnUrl:"Return URL"},synchronize:"Synchronize Plans with PagSeguro",placeholder:{email:"your@email.com",token:"Paste your token here"},tip:{token:'In PagSeguro, click on Integrations > Security Token. Click the "Generate Token" button. Copy and paste the token into the field below. IMPORTANT: It will not be possible to consult the token later, so save it in a secure place. If you need to generate a new token, the previous one will be invalidated and you will need to update this field again. PagSeguro considers the token to be sensitive information and advises its customers not to disclose it to third parties.',notification:'Copy the URL below, go to PagSeguro, log in, and click on Integrations > Transaction Notification. You will need to activate it by clicking the "Activated" button and paste the content of the field next to it into the "Set URL to receive notifications" field in PagSeguro.',url:'Copy the URL below, go to PagSeguro, log in, and click on Integrations > Redirect Page. You will need to activate it by clicking the "Activated" button and pasting the content of the field next to it into the "Set redirect page" field in PagSeguro under "The Fixed Redirect Page" and provide "transaction_id" in the "Choose a name for the parameter" field under "Redirect with transaction code" and click "Activate".'}},erede:{filiationNumber:"Filiation Number (PV)",integrationKey:"Integration Key",placeholder:{filiationNumber:"Paste the filiation number (PV) here",integrationKey:"Paste the integration key here"},tip:{filiationNumber:"Filiation number of your establishment with e.Rede, up to 9 digits, can be found in your profile",integrationKey:"Key generated by e.Rede. Access the admin profile at: e.Rede > Settings > Integration Key Generation and click *Generate Key and Integration*"}}},invalidOption:{modalHeader:"Oops! This option is not available in your plan",modalBody:"Change your subscription options by clicking on the subscriptions menu in the configuration settings, or contact our team via chat.",modalFooterButton:"Okay, I understand"},confirmGatewayChange:{modalHeader:"It is only possible to set up automatic billing with one tool",modalBody:"To validate the integration of automatic billing with this tool, the old integration will be disabled. Are you sure you want to proceed?",modalFooterCancelButton:"Cancel",modalFooterConfirmButton:"Yes, save",success:"Success!",error:"Error!"},transactionLogsTable:{list:{searchPlaceholder:"Search by user, email, action or code"},defaultFilters:{freeEnrollments:"Free enrollments",confirmedPayments:"Confirmed payments"},gateways:{none:"No tool (free)"},date:"Date",environment:"Environment",gateway:"Tool",type:"Type",action:"Action",student:"Enrolled",user:"User",userDeleted:"User deleted",value:"Value",paymentResponsability:{title:"Type of person",tag:{userResponsability:"Natural person",companyResponsability:"Company"}},tid:"Transaction code",deleteWarning:"Logs are available for 90 days",manual_transaction:"Manual",system_event:"System",actions:{new_invoice_link_generated:"New billing link generated successfully.",new_invoice_link_failed:"New billing link generated unsuccessfully.",payment_confirmed:"Payment confirmed.",payment_overdued:"Overdue billing without payment identified."},sended:"Send",received:"Return",disabledMessage:"Transaction logs are only available for environments that use automatic billing."},validationToast:{requiredFields:"There are required fields that are not filled in",fillToSave:"Fill in to save again"}}}},ece={en:{translations:{subscriptionPlans:{tabTitle:"Plan",planInfo:{currentPlan:"Current plan",totalsIncludeAllEnvironments:"The totals of the plan include the sum of all environments, including the additional ones.",additionalEnvironmentsTitle:"To view the plan information, visit the main environment.",additionalEnvironmentsText:"You are currently in an additional environment. The information about the use contract is only available on the main responsible environment."},progressItem:{uniqueLogins:"Unique logins per month",uniqueLoginsTooltip:"It is the count of users who access the platform within the month, regardless of the total number of registered users. The counter is reset at the beginning of each month.",activeUsers:"Active users",activeUsersTooltip:"Active users: the number of registered users who are active on the platform",diskSpace:"Disk space",diskSpaceTooltip:"Storage consumed by the files used in learning content (videos, SCORM, PDF, etc).",unlimited:"Unlimited",additionalEnvironments:"Additional environments",certificateSignatures:"Certificate signatures (monthly)",certificateSignaturesTooltip:"Certificate signatures used this month compared to the monthly limit contracted in the plan.",additionalEnvironmentsTooltip:"Number of additional environments in use compared to the total contracted in your plan."}},additionalEnvironments:{tabTitle:"Additional environments",additionalEnvironmentTabContainer:{title:"To manage other environments, access the main environment.",text:"You are currently in an additional environment, where this option is not available."}}}}},ace={en:{translations:{dashboard:{back:"Back"},score:{title:"Score",maximumScore:"Maximum",averageScore:"Average",firstPlace:"1st place"},modalWelcome:{welcome:"Welcome!",modalContent:"This is the new learning engagement dashboard! The charts you will see here display data collected from January 2023. It is not possible to view data before this period.",iGotIt:"Ok, I got it"},tips:{summaryMaximumScore:"Maximum points a student can achieve in this course.",summaryAverageScore:"Average score achieved by students in this course.",summaryFirstPlace:"Score of who is in first place in the ranking of this course.",locked:"Gamification is not enabled for your organization. To activate it, access the menu",path:"Settings > Organization > Data > Enable Gamification.",workload:{planned:"Accomplished: how many hours have already been accomplished in the course. This number is updated every time a student completes the course.",accomplished:"Planned: what was the workload registered in the course multiplied by the number of enrolled in the course."},generalProgress:"Average progress of all active course enrollees. Each entrant's individual progress can be seen at the bottom of the page under the entrant list.",certificates:"% of total active enrollees who have already obtained a certificate of completion for this course. This indicator is only updated if the course has a certificate configured",progressBySituation:{Completed:"Completed: % of active enrollees who have already completed the course.",notStarted:"Not Started: % of active course enrollees who have not yet completed any content.",ongoing:"Ongoing: % of active enrollees currently taking the course."},questionsAndAverageScore:{percentageOfCorrectAnswers:"The percentage of questionnaires is calculated based on the number of questions, correct answers and the weight of the questionnaire for the student's final approval. Ex: if a questionnaire has 10 questions and the weight of the questionnaire corresponds to 50% of the final approval, then each question is worth 5% and if the student gets all the questions right the percentage of the questionnaire will be 50%.",studentAnswers:"If a student answers the quiz more than once, only the best grade will be considered.",averageProgress:"Overall average is an average of the students' grade on the quiz. The highest grade obtained by each student is taken into account."},totalData:"Data that summarizes the current status of this course.",isManagerTotalData:"Data that summarizes the current status of this course in this environment and in additional environments.",subscribersList:"The list only displays subscribers who are currently confirmed for this course.",averageProgressAndCompletion:"Realice un seguimiento del porcentaje de inscritos que ya completaron el curso y cuál es el progreso promedio general del curso a lo largo del tiempo.",contentEngagement:"Track student engagement in the various types of course content and draw insights to plan the best content for future learning. An engagement is counted when a student completes content.",courseMovement:{heading:"See the movement in your course over time. ",newSubscribers:"New Enrollees: How many people signed up for the course. ",started:"Started: how many people started the course, that is, completed at least one content.",concluded:"Concluded: How many people have seen all of the course content."},peopleEngagement:{courseAccess:"Access to the course: unique subscribers who accessed at least one of your course's content within the selected time period.",contentConclusions:"Content conclusions: unique subscribers who completed some content during the selected time period."},approvalSituation:`See over time the number of enrollees who completed the course but still did not meet the approval criteria and how many were approved.
 Approval can be performed manually on this page or automatically through the approval criteria configured in the course at: Edit > Approval.`},period:{label:"Select period",LAST_7_DAYS:"7 days",LAST_15_DAYS:"15 days",LAST_30_DAYS:"30 days",SINCE_CREATION:"All period",CUSTOM_RANGE:"Custom",apply:"Apply",from:"From",to:"to"},toast:{chartOptions:"At least one data option must be checked to view the graph."},workload:{workload:"Workload",hour:"hour",hours:"hours",total:"Planned",performed:"Performed"},completeRanking:{experiencePoints:"Experience points",seeCompleteRanking:"Show complete ranking"},generalProgress:{generalProgress:"General progress"},progressBySituation:{completed:"Completed",not_started:"Not started",in_progress:"In progress"},certificates:{certificates:"Certificates"},dashboardStatistic:{generalStatistics:"General statistics",courseMovement:"Course movement",averageProgressCompletion:"Average progress and conclusion",contentEngagement:"Engagement by content",approvalStatus:"Approval status",peopleEngagement:"Engagement by people"},approvalStatus:{studentsApproved:"Approved",studentsCompleted:"concluded"},common:{perDay:"Day",month:"Month",year:"Year"},questionsAndGradeAverage:{questions:"Questionnaires",gradeAverage:"Grade average"},dashboardTotals:{totalData:"Total data"},filter:{filteredBy:"Filtered by",name:"Name",department:"Department",role:"Role",enterprise:"Enterprise",progress:"Progress",situation:"Situation",clearFilter:"Clear filters",filter:"Filter",nameOfTheConsumerEnvironment:"Environment name",typeOfEnvironment:"Type of environment",placeholders:{name:"Select a name",department:"Select a department",role:"Select a role",enterprise:"Select a enterprise"},environments:{allEnvironments:"All environments",internal:"Internal",external:"External"},progresses:{allStudents:"All students",notStarted:"Not started",started:"Started",completed:"Completed"},situations:{allStudents:"All students",running:"Running",approved:"Approved"}},subscribersList:{subscribersListTitle:"Subscribers list",actionMass:"Mass action",name:"Name",enterprise:"Enterprise",classManager:"Class manager",situation:"Situation",progress:"Progress",comments:"Comments",attendanceScore:"Attendance score",finalScore:"Final score",contact:"Contact",corrections:"Corrections",scoreByWeight:"Score by weight",approved:"Approved",certificates:"Certificates",history:"History",active:"Active",inactive:"Inactive",call:"Call",presenceList:"Presence list",massAction:{sendEmail:"Send email",presenceList:"Presence list",presenceListToastTitle:"Issue attendance list",resendSignatureEmail:"Resend certificate signature email",dynamicFieldsLabel:"Dynamic fields:",dynamicFieldParticipantName:"#Participant_name",dynamicFieldContentName:"#Content_name",dynamicFieldsTooltip:"Click to insert into the text",resendSignatureEmailToastTitle:"Signature email resend in progress",resendSignatureEmailTooltip:"Available only for content that requires a certificate signature",generateCertificate:"Generate certificate",approve:"Approve",approveToastTitle:"Approval",generateCertificateTooltip:"The generation of certificates is disabled for this content. Activate it in the approval settings.",massReenroll:"Re-enroll",massReenrollToastTitle:"Mass re-enrollment started"},export:{questionsPdf:"Questionnaires report in CSV",dashboardPdf:"Dashboard report in PDF"},result:{noStudentsToShow:"No students to show"}},averageProgressAndCompletion:{averageProgress:"Average progress",completion:"% of completion"},contentEngagement:{title:"Engagement by content",text:"Text",video:"Video",archives:"Archives",questions:"Questionnaires",scorm:"SCORM",games:"Games"},courseMovement:{newSubscribers:"New subscribers",started:"Started",completed:"Completed"},peopleEngagement:{courseAccess:"Access to the course",contentConclusions:"Content Conclusions"},paginator:{next:"Next",previous:"Previous"},print:{filters:{label:"Applied Filters",period:"Period",names:"Names",departments:"Department",enterprises:"Enterprise",roles:"Role",progress:"Progress",status:"Status",all_students:"All Students",not_started:"Not Started",started:"Started",completed:"Completed",0:"All Students",1:"Approved",2:"In Progress"}},...pi.en.translations}}},oce={en:{translations:{modalNews:{modalTitle:"News: artificial intelligence has arrived at Twygo. Test the BETA",askLaterButton:"Remind me later",understoodButton:"Ok, I understand"},learningPathV2LaunchDescription:{title:"News: class manager, instructor, and learning path indicators",moreUpdatesComing:"More learning path updates coming soon! Now, both instructors and class managers can be assigned to learning paths. Here's what they can do:",instructor:"Instructor:",instructorImprovements:{studentsPerfomance:`Track participants' performance. ("Learning")`,editLearningPath:'Add and edit learning path contents. ("Activities")'},classManager:"Class manager:",classManagerImprovements:{subscribeStudents:"Subscribe users to the learning path.",studentsPerfomance:'Track the performance of the participants they manage. ("Learning")'},dashboardProgressCertificate:'Additionally, the "certificates" and "progress" numbers on the dashboard now include data from the learning paths. Watch the video below for more details:'},learningPathLaunchDescription:{title:"News: issuing certificates in learning paths and changes in the additional environment",changes:"The learning path has changed! Check out the improvements:",improvements:{startDate:"Start and end date",certificates:"Custom certificates",newSpace:"New space to organize learning path activities"},additionalEnvironments:"Additional environments",additionalEnvironmentsDescription:"And that's not all! We also improved the way you manage and share content with additional environments, to make this feature even easier to use!",checkOutVideo:"Check all this out in the video below:"},newLogs:{modalTitle:"What's new: Change logs",boldText:"Now users and administrators will have access to logs of the activities that occur within the platform.",normalText:"The change log feature, which was under maintenance, is back. You will be able to track:",listItem1:"Changes in user profiles",listItem2:"Access activities (login and logout)",listItem3:"Changes within the organization",listItem4:"Changes in game rules (gamification)",listItem5:"Changes in communication rules (communities)"},sophIA:{normalText1:"Explore the BETA and see the power of",normalText2:": your assistant to create content and questionnaires magically. We want to know your opinion during the test! Your participation is essential in the development of this new product.",normalText3:"NOTE. As it is a BETA function, not everything will be perfect, but we count on your help to make this new feature even better."},newUserMassInactivation:{modalTitle:"What's new: User Mass Inactivation",boldText:"Easier user management!",normalText:'You can now deactivate or activate users in bulk by importing from the "Users" menu.',checkOutVideo:"Check out the step-by-step video below:"},newApiV2:{title:"What's new: New API and advanced indicators with Power BI",normalText1:"More data and indicators from your environment.",normalText2:"We present a new API to read the main data from the platform: users, questionnaires, certificates, courses, and much more.",normalText3:"Also enjoy the indicators directly from a template ready for Power BI.",normalText4:"Check all this out in the video below:"},newLearningPathOnPlay:{modalTitle:"Get to know Play: the ease of streaming, now in your environment and other news",seeMoreVideo:"Check out all this in the video below:",playDescription:"With Play, users will have quick and easy access to content, personalized course and trail suggestions based on their interests, as well as an easy interface that displays summaries, previews and all relevant course and trail information directly on the screen. Learning is just a click away. Now available in your environment",more:{title:"And More:",listItem1:{title:"Enrollment Packages: ",description:"New function for enrolling multiple people in the same course."},listItem2:{title:"CNPJ Enrollment: ",description:'Companies can now enroll their employees by CNPJ, and you can track it in the new "Companies" menu!'}}},twygoAcademyNotification:{modalTitle:"New support channel and T&D content for you!",firstBlock:{emoji:"💡",tAndD:"Twygo Connect",normalText1:"we created a special space for Training and Development training!",normalText2:"In the",normalText3:", you will find all our webinars and be able to enhance your skills."},secondBlock:{title:"Accessing the new environment is simple: ",normalText1:"click on “Administrator” in the upper right corner > Click on “Twygo Connect”."},thirdBlock:{title:"Support via WhatsApp: ",normalText1:"to make our service even faster, we have added support via WhatsApp! Now our official support channels are:",options:{email:"✉️ Email: suporte@twygo.com",phone:"☎️ Phone: 0800 878 9638",whatsapp:"📱 WhatsApp: +55 47 3170-0642"}},fourthBlock:{title:"👀 And there’s more: ",normalText1:"From August 6th to 8th, we will have the",tAndDConference:"T&D Conference 2024:",normalText2:"three days of lectures and debates on training and development. There’s still time to sign up to watch live or receive the recording!"}},accessTwygoAcademy:{modalTitle:"Get to Know Twygo Academy",textblock1:"📚 Twygo Academy: your new space to resolve doubts about the platform!",textblock2:"Twygo Academy is an exclusive environment where you can access content to clarify all your doubts about Twygo.",textblock3:{bold:"To access Twygo Academy, there is no need to create a new login.",normal:"Just access your environment > Click on “Administrator” > Twygo Academy."},textblock4:"🎥 Watch our explanatory video to better understand."},faceliftAndCertificate:{modalTitle:"Some things are different around here....",textblock1:"We redesigned some things to make your daily life even easier.",textblock2:{normal:"You will have more filters, dashboards, simple data extraction, and bulk actions in several areas:",bold:'"Contents", "Users", "Questionnaires", "Learning" and "Team".'},secondVideoTitle:"New certificates area",secondVideoDescription:"Managing and customizing your certificate templates is now even easier! With the new exclusive area, you can customize your certificates in a practical and organized way.",secondVideoDescription2:"Enjoy the new features! 🚀",textblock3:"🎉 Watch the video below to see all the details!"},ecossystemEnvironments:{modalTitle:"Some things are different around here....",textblock1:"More clarity and control for those who share content!",changes:{title:"Content sharing has been enhanced to offer more clarity and control. See what changed:",listItem1:{part1:"🔄 Choose between ",part2:'"Free copy" ',part3:"or ",part4:'"Controlled" ',part5:"when sharing content with another environment."},listItem2:{part1:"👁️ Clearly visualize ",part2:"which environments the content is shared in."},listItem3:{part1:"🔐 Some fields are now ",part2:"editable or protected, ",part3:"depending on the sharing format."},listItem4:{part1:"📊 Track your plan usage and additional environments through the ",part2:"Plan and subscription area."}},checkOutVideo:"Watch the video and see in practice how to take advantage of this new feature:"},ecossystemEnvironments2:{modalTitle:"News: Content Packages",textblock1:"More convenience for organizing and sharing content!",changes:{title:{part1:"With ",part2:"Content Packages ",part3:"you can create custom groupings and also share with other environments."},whatChanged:"See what you can do:",listItem1:{part1:"📦 Group courses and learning paths into ",part2:"organized packages."},listItem2:{part1:"🖼️ Customize exclusive ",part2:"banners for packages in Play."},listItem3:{part1:"🎯 Highlight packages with ",part2:"filters, categories and visibility control: ",part3:"for enrolled users, logged users, collaborators or general public."},listItem4:{part1:"🔄 Share packages with other environments ",part2:'as "Free copy" (independent) or "Controlled" (keeps updates synchronized with original content).'},checkOutVideo:"Check out the step-by-step in the video below:"}},novoVersoDoCertificado:{modalTitle:"News: more freedom and reach for your certificates",textblock1:"More flexibility and resources to make your certificates look like your brand!",changes:{title:{part1:"Check out the main news:"},listItem1:{part1:"🖼️ Custom images: ",part2:"add logos, stamps and free visual elements."},listItem2:{part1:"🔁 Configurable back: ",part2:"create front and back certificates easily and automatically include the list of activities on the back."},listItem3:{part1:"🧩 More dynamic data: ",part2:"insert fields such as location, instructors, company, frequency and much more — all updated automatically."},listItem4:{part1:"✍️ Enhanced text editor: ",part2:"customize fonts, lists and formatting with freedom."},listItem5:{part1:"🔗 Share on LinkedIn: ",part2:"allow students to share certificates directly on LinkedIn, increasing the visibility of their courses and brand."},checkOutVideo:"Watch the video and see how to take advantage of these new features:"}},publicLearningPath:{modalTitle:"New features to make your learning paths even more complete",textblock1:"More flexibility and control to create incredible learning experiences!",changes:{listItem1:{part1:"🌐 Public pages and expanded visibility: ",part2:"define if your paths will be visible to collaborators, logged users or visitors — just like in courses"},listItem2:{part1:"💳 Sell paths with integrated payment: ",part2:"activate sales directly on the platform, with support for installment payments and trial days"},listItem3:{part1:"📊 Improved reports and exports: ",part2:"export complete path and enrollment data, with new filters and fields for easier analysis"},listItem4:{part1:"🔄 Import and enroll in bulk via API V2 ",part2:"gain efficiency by creating, updating and managing paths and enrollments automatically"},checkOutVideo:"Watch the video and see how to take advantage of these new features:"}},useModeAndPlayFilters:{modalTitle:"News: customize menus and create filters in Play",textblock1:"More autonomy to organize students' experience!",changes:{title:{part1:"You can now customize the menus shown in the students' view and create custom filters in Play."},listItem1:{part1:"✏️ Edit menu name, icon, and order."},listItem2:{part1:"🔗 Create menus with external links or that redirect to other environments."},listItem3:{part1:"🎯 Build a menu with the Play look, but with filters applied — ideal to highlight specific content."},listItem4:{part1:"🧠 Admins and students can now create and save their own filters in Play!"},checkOutVideo:"Check out the step-by-step in the video below:",whatChanged:"See what changed:"}},ssoAuthentication:{modalTitle:"New: SSO Authentication",textblock1:"More security and convenience for your corporate users' login",changes:{title:{part1:"It is now possible to authenticate corporate users via SSO (Single Sign-On)."},listItem1:{part1:"🔐",part2:"Unified login",part3:": your users access Twygo using corporate credentials, without needing to create or remember another password."},listItem2:{part1:"🧩",part2:"Identity provider integration",part3:": compatible with",part4:"Microsoft Azure AD, Google Workspace, Okta",part5:"and other SAML providers."},listItem3:{part1:"🛡️",part2:"More control and security",part3:": centralized authentication, without password resets in Twygo."},importantNote:{part1:"💡",part2:"Important",part3:": check if your current plan includes the SSO authentication feature."},checkOutVideo:"Check out more details in the video below:",whatChanged:"See what changed:"}},fourFeaturesRelease:{modalTitle:"Four new features to make your day easier",items:{item1:{title:"Visual changes and flexible workload",text:"Content editing has been reorganized into tabs and gained two new fields: Experience type, the label your users will recognize each content by, and Classification, which helps segment and filter. The workload now accepts hours, minutes and seconds, and the side menu can be collapsed to free up screen space."},item2:{title:"Access hours and holidays",text:"Set up in the use mode the hours each team can use the platform, with intervals per weekday and holidays handled separately. Outside those hours, you choose what to block: the entire environment, all contents, or only the ones you select."},item3:{title:"Watermark on videos and files",text:"Display the viewer's tax ID, e-mail address, IP address or session ID as a watermark over videos and files, to discourage unauthorized recordings and sharing. You define its color and size and, on videos, its position and whether it stays fixed or moves."},item4:{title:"User registration and management through API 2.0",text:"API 2.0 now creates, updates, searches, activates, deactivates and deletes users including several at once. If you already manage people in another system, it can keep Twygo updated automatically. The details are in the documentation.",documentationButton:"View documentation"}}}}}},tce={en:{translations:{ssign:{tab_title:"Certificate signature",form:{sections:{account:"S-Sign access data",webhook:"Notification address"},labels:{serviceUrl:"S-Sign address",accessKey:"Access key",webhookAddress:"Address to receive notifications"},placeholders:{serviceUrl:"https://yourcompany.satelitti.com.br",accessKey:"Paste the key generated in your S-Sign here",accessKeyConfigured:"Key already saved. Type a new one to replace it"},tooltips:{serviceUrl:"Your S-Sign address: the subdomain Selbetti created for your company, always with https",accessKey:"Generate the key in your S-Sign, under Settings > Integration > Key, and paste it here",webhookAddress:"Copy this address and paste it into the integration settings inside S-Sign, so we receive the notification when a document is signed"},errors:{serviceUrlRequired:"Enter the S-Sign address",serviceUrlMustBeHttps:"The address must be a valid https URL",accessKeyRequired:"Enter the access key",loadFailed:"Could not load the S-Sign configuration",saveFailed:"Could not save the S-Sign configuration"},messages:{saved:"S-Sign configuration saved"}}},sso:{tab_title:"SSO Authentication via SAML",form:{sections:{metadata:"Metadata",settings:"Settings",activation:"Activation"},placeholders:{domain:"Select the default domain"},labels:{certificate:"IdP Certificate",sso_url:"SSO URL",activate:"Activate SSO",hide_login_page:"Hide login page",email_field:"Email attribute name",domain:"Domain",file_name:"File"},tooltips:{activate:"Activate SSO",sso_url:"Enter the URL provided by your identity provider (IdP) where users will be redirected when logging in via SSO.",certificate:"Paste here the certificate provided by your identity provider (IdP), necessary to validate the SAML authentication.",email_field:`Enter the name of the attribute that your identity provider uses to send the user's email (Ex.: "email", "user_email").`,domain:"Select the default domain for SSO authentication. Authentication will be enabled for all domains associated with your organization.",hide_login_page:"When enabled, the platform login page will not be shown and access will be redirected to the configured SAML provider."},errors:{invalidUrl:"Invalid URL",domain_required:"Domain is required"},success:{save:"SSO configuration saved successfully",metadata_generated:"Metadata generated successfully"},buttons:{generate:"Generate metadata",generate_again:"Generate again",generating:"Generating..."}}},api_token:{tab_title:"API key",tab_token_title:"Token",add_label:"+ Add",you_want_continue:"Are you sure you want to continue?",token_copy_success:"Token copied successfully",token_tooltip:"A token is a unique key used to identify environments in integrations with other environments or with external platforms. Be careful when sharing with third parties.",modal_confirm_regenerate:"Confirmation to regenerate",modal_body_confirmation:"The previous token can no longer be used. This action cannot be undone. Are you sure you want to regenerate?",confirm_button_title:"Regenerate",table:{name:"Key name",user:"Associated user",created_at:"Created at",situation:"Situation"},tooltips:{user:"This user will be associated with all records under this API key, to facilitate viewing the history of records created.",copy_token:"Copy key",regenerate:"Regenerate",user_table:"The user to whom all records generated by this API will be linked",add:"Your API key gives you full access to view and modify data on Twygo. Access the complete documentation via the link: https://bit.ly/twygo-api-v2"},form:{labels:{name:"Name",user:"Associated user",token:"API key"},validations:{name:{required:"Name is required",max:"name must be at most 30 characters"}},title:"API key",back:"Go back",placeholders:{name:"Write a name that helps identify the key later",user:"Select the associated user"},updated_success:"API key updated successfully",create_success:"API key created successfully",create_success_message:"Copy to use",save:"Save",cancel:"Cancel"},confirmApiKeyDelete:{message:"All queries using this API key will stop. Are you sure you want to delete?",success:"API key deleted successfully"},contractBlock:{title:"Oops! This option is not available in your plan",message:"Change your subscription options by contacting our team!",button:"Contact"},creditBlock:{admin:{title:"Credit limit reached",message:"All available credits have been used. To continue, contact support or wait for renewal.",button:"Contact"},managerInstructor:{title:"Credit limit reached",message:"All available credits have been used. To continue, contact the environment owner or wait for renewal."},student:{title:"Action unavailable right now",message:"It was not possible to complete this action right now. Contact the environment owner for more information."}},status:{inactivate:"Inactivate",modal_title:"Inactivation confirmation",modal_body:"All queries using this API key will stop."},regenerate:{success:"New API key generated successfully",error:"There was an error regenerating the API key",error_inactive:"Cannot regenerate an inactive API key",modal_title:"Confirmation to regenerate",modal_body:"All queries using this API key will stop and you will need to replace the new key at query points.",button:"Regenerate",token_disabled_title:"Unable to regenerate an inactive API key",token_disabled_message:"Activate to regenerate"},inactivate:{success:"API key successfully inactivated",error:"There was an error inactivating the API Key"},activate:{success:"API Key activated successfully",error:"There was an error activating the API Key"},copy_token:"API key copied successfully"}}}},ice={en:{translations:{extract:{title:"AI credit usage statement",title_history:"Credit history",month_label:"Month",previous_month:"Previous month",next_month:"Next month",columns:{date:"Date",origin:"Performed action",organization_name:"Environment name",user:"User",estimated_credits:"AI credits",transaction_reason:"Operation",transaction_reason_tooltip:"Indicates the type of entry (Credit package, Voucher, Bonus or Consumption) and whether it represents a credit (balance increase) or a debit (consumption).",credit_type:"Source",credit_type_tooltip:"Indicates from which wallet the consumption was debited: first the credits from the package (plan) are used, then the additional credits considered as vouchers.",period_end_date:"Expiration"},total_final_balance:"Total final balance",total_final_balance_tooltip:`Sum of all available credits (credit package + credit vouchers) for use in AI tools.
The final balance is displayed as whole numbers (with rounding), which may cause slight visual differences compared to the history sum.`,credit_package:{title:"Credit package",title_tooltip:"Credits made available monthly according to the contracted plan",deducted_balance:"Deducted balance",deducted_balance_tooltip:"Credits consumed beyond the limit in the previous month, which will be deducted from the current month's balance.",monthly_renewal:"Monthly renewal",monthly_renewal_tooltip:"Amount of credits available at the start of the month according to the contracted plan",credits_used:"Credits used",credits_used_tooltip:"Amount of credits from the monthly plan already consumed by the AI tools",final_balance:"Final balance",final_balance_tooltip:"Current available credit balance",unused_balance:"Unused balance",unused_balance_tooltip:"Monthly plan credits that were not used and expired",excess_consumption:"Excess consumption",excess_consumption_tooltip:"You consumed more credits than the available balance. The amount will be deducted from the next monthly renewal",carried_forward_tooltip:"Unused additional credits carried over from the previous month",error:"Error loading credits summary"},voucher_summary:{title:"Credit vouchers",title_tooltip:"Extra credits purchased beyond the monthly plan",initial_balance:"Initial balance",initial_balance_tooltip:"Unused additional credits carried over from the previous month",monthly_renewal:"Recurring voucher received",monthly_renewal_tooltip:"Recurring credit voucher received monthly",bonus_acquired:"Bonus acquired",bonus_acquired_tooltip:"Bonus of credits purchased this month",voucher_acquired:"Voucher acquired",voucher_acquired_tooltip:"Voucher of credits purchased this month",credits_used:"Credits used",credits_used_tooltip:"Amount of additional credits already used by the AI tools",final_balance:"Final balance",final_balance_tooltip:"Current available voucher balance",carried_forward:"Balance carried forward to next month",carried_forward_tooltip:"Unused additional credits carried over from the previous month",excess_consumption:"Excess consumption",excess_consumption_tooltip:"You consumed more credits than the available balance. The amount will be deducted from the next monthly renewal",excess_consumption_message_prefix:"This debit of",excess_consumption_message_credits_word:"credits",excess_consumption_message_suffix:"will be debited from the credit package in the next monthly renewal",error:"Error loading voucher summary"},defaultFilters:{consumptions:"Credits used",creditAdditions:"AI credit additions made",packageConsumptions:"Consumptions using credit package",voucherConsumptions:"Consumptions using voucher"},filterOptions:{transactionReason:{consumption:"Consumption",contract:"Credit package",recurring:"Recurring voucher",bonus:"Bonus/Voucher",voucher:"Voucher",expiration:"Expiration"},creditType:{contract:"Credit package",recurring:"Recurring voucher",voucher:"Voucher",bonus:"Bonus/Voucher"}}},tabs:{extract:"Extract",settings:"Settings",settings_tooltip:"Configure which environments can access AI features and which features you want to make available.",ai_credits_policy:"AI credits policy",terms_glossary:"Terms glossary",terms_glossary_tooltip:"Configure the business-specific terms that the AI should learn and be able to use."},policy:{title:"Approximate consumption table",tooltip:"The consumption values presented are approximate and may vary depending on task complexity, content size, and other factors.",columns:{action:"Action",credits:"Approximate credits",description:"Description"}},settings:{columns:{environment:"Environment",ai_access_active:"AI access active",inherit_from_primary:"Inherit from primary",actions:"Actions"},labels:{primary_environment:"Primary environment"},messages:{updated_success:"Configuration updated successfully",updated_error:"Error updating configuration"},tooltips:{inherit_from_primary_edit_disabled:"This environment is inheriting settings from the primary environment. Disable inheritance to edit."},empty:"No data to display",edit:{chooseFeaturesTitle:"Choose the AI features to enable",categories:{contentCreation:"Content creation",analysisMonitoring:"Analysis and monitoring",automationAssistance:"Automation and assistance"},categoriesTooltips:{contentCreation:"Tools to create and produce educational materials.",analysisMonitoring:"Tools for performance analysis and mapping.",automationAssistance:"Agents and tools to automate processes."},items:{canCreateContent:"Create content, in page or video format, with AI",canGenerateQuizzesFromContent:"Generate quizzes based on new files or existing activities",canGenerateActivityStructure:"Create activity structures to support content creation",canGenerateActivitySummaries:"Generate summaries for your activities",canEditPageContentWithAi:"Edit page-type content with AI",canEditLessonContentWithAi:"Edit lesson-type content with AI",canTranscribeVideo:"AI-generated automatic captions",canGenerateQuizAiFeedback:"Generate AI feedback reports for quizzes answered by end users",canImportContentForQuizGeneration:"Import files or text to automatically create quizzes",canGenerateOrgChartWithAi:"Understand imported files and generate your company’s org chart, business roles and business role competencies",canAutofillExternalTrainingsWithAi:"External records: read files with AI and auto-fill the recorded entries"},itemsTooltips:{canCreateContent:'You can access it through the Contents menu > "Create course with AI" button.',canGenerateQuizzesFromContent:'You can access it through the Learning > Contents menu, by selecting a content and clicking Activities. In the activities list, click Sophia and then "Create quiz".',canGenerateActivityStructure:'You can access it through the Learning > Contents menu, by selecting a content and clicking Activities. In the activities list, click Sophia and then "Create activities".',canGenerateActivitySummaries:'You can access it through the Learning > Contents menu, by selecting a content and clicking Activities. In the activities list, click Sophia and then "Create activity summary".',canEditPageContentWithAi:"This is related to any editing of page-type content performed after selecting an activity to edit.",canEditLessonContentWithAi:"This is related to any editing of lessons performed after selecting an activity to edit.",canTranscribeVideo:"You can access it when editing a video activity, on the Content tab.",canGenerateQuizAiFeedback:"You can define what you want the AI to analyse when creating or editing a quiz in the Quizzes menu.",canImportContentForQuizGeneration:'You can access it through the Quizzes menu > "Smart import" button.',canGenerateOrgChartWithAi:'You can access it through the Skills menu > "Org chart, business roles and Competencies".',canAutofillExternalTrainingsWithAi:'You can access it through the Learning > Records menu and then click "Add".'},contentIndexing:{validation:{periodStartRequired:"Enter the start date for the period."},syncInProgress:"A content sync is currently running. Wait until it finishes to edit indexing settings.",title:"Content indexing",titleTooltip:"Configure how the AI learns from your content. Indexing has a higher initial credit cost because of the learning phase, but makes future operations (such as the support agent, quiz generation, and other features) significantly faster and more economical.",period:{title:"Period",tooltip:"If enabled, only content uploaded to your environment within the informed period will be indexed. You can also provide only a start date, from which content will be indexed.",indexSpecific:"Index a specific period",startDateLabel:"Start date",endDateLabel:"End date",datePlaceholder:"dd/mm/yyyy",confirmationPrefix:"Selected period:",summaryOpen:"From {{date}} onwards",summaryClosed:"From {{startDate}} to {{endDate}}",limitedPeriodAlertTitle:"Limited period notice",limitedPeriodAlertDescription:"When you set both a start and an end date, the AI will learn only from content created within that specific period. New content created after the end date or updates to existing content will not be included in the AI learning."},contentType:{title:"Content type",course:"Course",trail:"Learning path",package:"Package"},assetType:{title:"Activity type",assetText:"Text",assetPage:"Page",assetLesson:"Lesson",assetStampedPdf:"Stamped PDF",assetVideo:"Video",assetFiles:"Files",assetQuiz:"Quiz (not eligible)",external_video:"External video (not eligible)",scorm:"SCORM (not eligible)",games:"Games (not eligible)"},status:{title:"Content status",inDevelopment:"In development",released:"Released",suspended:"Suspended"},exceptions:{title:"Exceptions",fieldLabel:"Contents that will not be indexed",tooltip:"Choose contents that will be ignored in indexing. Selected contents will not be indexed, even if they meet any of the criteria above.",placeholder:"Search by content name or ID"},creditsModal:{title:"Content indexing process",beforeStart:"Before starting, it is important to consider:",processingTimeTitle:"Processing time:",processingTimeDescription:"It may take some time depending on the amount of content your organization has.",creditsConsumptionTitle:"AI credits consumption:",creditsConsumptionDescription:"The initial indexing process has a higher credit cost due to AI learning from your content. However, this investment makes future operations significantly faster and cheaper.",automaticIndexingTitle:"Automatic indexing:",automaticIndexingDescription:"Once indexing is enabled, every new or updated content will be automatically learned by AI and will require AI credit cost.",agentActivationTitle:"Agent activation:",agentActivationDescription:"To activate the support agent, you need to enable it in usage mode. Go to Settings > Navigation to add the support agent.",estimatedCost:"Estimated cost:",approximateCredits:"credits (approximate)",currentBalance:"Current balance:",creditsUnit:"credits",insufficientTitle:"Insufficient balance",insufficientDescription:"It is not possible to start the indexing process. Purchase more AI credits by contacting our team!",confirmAndStart:"Confirm and start",contact:"Contact"},disableBlocked:{title:"Content indexing in use",description:"It is not possible to disable because there are configured menus currently using this feature in the use mode.",instruction:"To disable it, you must first disable or change the configuration of the following menus:",menuLabel:"Menu name:",useModeLabel:"Use mode:",path:"Go to Settings > Navigation > Select edit for the desired menu > Click the menu tab > Disable in the Menu enabled column",confirmButton:"Got it"}},supportAgent:{title:"Support agent",titleTooltip:"Support agent with automated responses, using configurable knowledge sources.",disableBlocked:{title:"Support agent in use"},sourcesTitle:"Knowledge sources",sources:{internal:"Internal",external:"External"},sourcesTooltips:{internal:"Uses your environment content as a knowledge source. To use this source, you must enable content indexing above.",external:"Uses public internet content as a knowledge source."}}}},help:{how_credits_work:"How credit consumption works",modal_title:"How credit consumption works",package_title:"Credit package",package_p1:"Monthly credits included in your package are renewed automatically at the start of each month.",package_p2:"Important: Unused monthly credits expire and are replaced by the new month's credits.",vouchers_title:"Credit vouchers",vouchers_title_tooltip:"Extra credits purchased beyond the monthly plan.",vouchers_initial_balance_tooltip:"Unused additional credits carried over from the previous month.",vouchers_p1:"Credit vouchers purchased separately are valid for one year from the date of purchase.",consumption_title:"Consumption per action",consumption_p1:"Each AI feature consumes a specific amount of credits. Consumption varies according to the complexity of the task performed.",credits_policy_tooltip:"Un