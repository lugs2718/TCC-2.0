fine una clasificación que complemente la identificación de esta jornada. Puede utilizarse como filtro y ayuda a los usuarios a encontrar elementos con características similares. Ejemplos: Básico, Avanzado, Liderazgo.",visualization:"Define quién puede visualizar la jornada.",workload:"Campo informativo. No se considera en el cálculo de progreso o aprobación.",prolong_by_tasks:"Cuando está activado, la duración sigue el período de las tareas y los campos Duración y Unidad quedan bloqueados."},situations:{development:"En desarrollo",released:"Liberado",suspended:"Suspendido",ended:"Finalizado"},visualizations:{subscribed:"Inscritos",collaborator:"Colaborador",user:"Usuarios"},duration_units:{days:"Días",weeks:"Semanas",months:"Meses"},validations:{name_required:"El nombre de la jornada es obligatorio",name_max:"El nombre debe tener como máximo {{max}} caracteres",description_max:"La descripción debe tener como máximo {{max}} caracteres",duration_required:"La duración es obligatoria",duration_min:"La duración debe ser mayor que cero"}},access:{locked_tooltip:"Guarda la jornada primero para configurar el acceso.",sections:{contact:"Contacto",subscription:"Inscripción",access:"Acceso",attachments:"Adjuntos"},fields:{update_existing_access_days:"Actualizar los días de acceso de los inscritos actuales",restrict_offhours_access:"Restringir el acceso fuera del horario comercial"},placeholders:{contact_email:"Correo del responsable"},tooltips:{update_existing_access_days:"Aplica los nuevos días de acceso a los inscritos existentes. La propagación ocurre en la fase de ejecución.",restrict_offhours_access:"Cuando está activado, el acceso queda bloqueado fuera del horario comercial de la organización."},validations:{email_invalid:"Correo electrónico inválido",access_days_min:"Los días de acceso deben ser al menos 1",access_days_max:"Los días de acceso deben ser como máximo {{max}}",attachments_message_max:"El mensaje debe tener como máximo {{max}} caracteres"}},approval:{locked