 Cancelar: El archivo no se importa y se indican las líneas con errores. 
 Actualizar: La información de los usuarios ya registrados será actualizada. 
 Ignorar: Ignora y no actualiza la información de los usuarios ya registrados.`,participantAlreadyRegistered:"Participante ya inscrito",tooltipSelectRegistration:`Define qué sucederá si el archivo tiene personas ya inscritas en este contenido: 
 Cancelar: El archivo no se importa y se indican las líneas con errores. 
 Actualizar: Los datos de las columnas del archivo reemplazan los de la inscripción, sin cambiar su situación. 
 Ignorar: Las personas ya inscritas quedan como están.`,options:{action:{cancel:"Cancelar",update:"Actualizar",ignore:"Ignorar"}}},form:{import:"Importar",isRequired:"{{field}} es obligatorio",tooManyLines:"El archivo excede el límite de líneas",fields:{scope:"Alcance",model:"Modelo",separator:"Separador",quoteChar:"Delimitador",file:"Archivo"}},historyListControl:{title:"Historial de importaciones",liveStatusError:"No fue posible actualizar el estado de las importaciones. Recargue la página para ver el resultado.",columns:{id:"Código",createdAt:"Importado en",user:"Usuario",status:"Situación",errors:"Errores"}},situation:{inProgress:"En progreso",cancel:"Cancelado",concluded:"Concluido",interrupted:"Interrumpido"},drawer:{titleHead:"Errores de importación"},listControlError:{line:"Línea de la tabla",reason:"Motivo",error:"Error",messages:"Mensajes",unexpected_error:"Error inesperado",validation_errors:"Formato de dato",error_associating_manager:"Error al asociar gerente",error_associating_team_manager:"Error al asociar gerente de equipo",duplicate_error:"Usuarios existentes",user_limit_reached:"Limite de usuarios activos",too_long:"Cantidad de caracteres",not_in_valid_options:"Validación de dato",format:"Formato de dato",required:"Campos obligatorios faltantes",invalid_chars_error:"Caracteres inválidos",invalid_phone_format:"Formato de teléfono inválido",organization_chart_role_not_found:"Función de negocio no encontrada",organization_chart_role_assign_error:"Error al asociar función de negocio",organization_chart_area_assign_error:"Error al asociar área del organigrama",organization_chart_validation_error:"Area no encontrada",sso_user_creation_not_allowed:"Creación de usuario no permitida"},modal:{header:"Confirmación para la importación",body:"La importación solo alterará los datos en este entorno {{organizationName}}. ¿Está seguro de que desea continuar?",confirm:"Confirmar",cancel:"Cancelar"},settingsFields:{required:"{{ field }} es obligatorio y no puede estar