uestions:{required:"Informe o número de perguntas de faixa de valores"},responseVisualization:{required:"Selecione a visualização de respostas"},questionDisplay:{required:"Selecione a exibição das perguntas"},minimumScore:{required:"Informe a pontuação mínima"},approvalPercentage:{required:"Informe o percentual na pontuação final"},attempts:{required:"Informe o número de tentativas"}}},image:{title:"Escolha o padrão de imagens para o modelo",description:"Selecione como as imagens serão incluídas nos cursos gerados com este modelo. Cada opção oferece diferentes benefícios para a experiência de aprendizado."},audio:{title:"Escolha a voz padrão para narrar as aulas",description:"Selecione a voz que melhor se adequa ao tom deste modelo. Você pode ouvir uma amostra de cada voz antes de escolher.",exampleLabel:"Texto de exemplo:",exampleText:"Olá! Seja muito bem-vindo. Neste treinamento sobre liderança estratégica, vamos conhecer um case de resiliência organizacional e discutir a importância do feedback assertivo. Também exploraremos juntos o significado da frase 'aprendizagem ativa aprimora a autonomia' e como ela se aplica no dia a dia. Além disso, abordaremos temas como gamificação e metacognição.",loading:"Carregando vozes...",retry:"Tentar novamente",errors:{loadFailed:"Não foi possível carregar as vozes. Tente novamente.",playFailed:"Não foi possível reproduzir a amostra. Tente novamente."},backgroundMusic:{title:"Música de fundo",description:"Uma trilha sonora suave tocará em baixo volume durante as aulas para tornar a experiência mais dinâmica.",enableLabel:"Ativar música",useDefault:"Usar música padrão",uploadMode:"Enviar arquivo",loading:"Carregando músicas...",uploadAudioFile:"Enviar arquivo de áudio",noFileUploaded:"Nenhum arquivo enviado. Formatos de áudio até 15MB.",uploadSuccess:"Música enviada com sucesso.",endOfAudioLabel:"Ao fim do áudio",endOfAudioDescription:"O que fazer quando a música terminar antes do vídeo.",loopOption:"Reproduzir em loop",loopOptionDescription:"A música reinicia automaticamente",onceOption:"Reproduzir apenas uma vez",onceOptionDescription:"A música para ao terminar",errors:{loadFailed:"Não foi possível carregar as músicas. Tente novamente.",playFailed:"Não foi possível reproduzir a música. Tente novamente.",uploadFailed:"Não foi possível enviar a música. Tente novamente."}}},design:{}},share:{requiresSavedModel:"Salve o modelo antes de configurar o compartilhamento",requiresSavedModelDescription:"A aba Compartilhar ficará disponível após a primeira gravação do modelo."},designTab:{requiresSavedModel:"Salve o modelo antes de configurar os designs",requiresSavedModelDescription:"A aba Design ficará disponível após a primeira gravação do modelo.",searchPlaceholder:"Pesquise pelo nome do design",list:{fields:{name:"Nome",partType:"Tipo de parte",format:"Formato"}},types:{lesson:"Aula",page:"Página"},filters:{onlyPages:"Só páginas",onlyLessons:"Só aulas"},addMenu:{button:"Adicionar",lesson:"Aula",page:"Página"},actions:{preview:"Pré-visualizar",edit:"Editar",duplicate:"Duplicar",delete:"Excluir",confirmDeleteTitle:"Excluir design",confirmDeleteMessage:"Essa ação não pode ser desfeita. Tem certeza que deseja excluir?"},toast:{duplicateSuccess:"Design duplicado com sucesso",duplicateError:"Erro ao duplicar o design",deleteSuccess:"Design excluído com sucesso",reorderSuccess:"Ordem dos designs atualizada com sucesso",reorderError:"Erro ao atualizar a ordem dos designs"},previewModal:{subtitleLesson:"Pré-visualização da aula",subtitlePage:"Pré-visualização da página (use zoom e role para explorar)",zoomIn:"Aumentar zoom",zoomOut:"Diminuir zoom",empty:"Este design ainda não possui pré-visualização disponível",designLabel:"Design"},reorder:{disabledTooltip:"Limpe os filtros para reordenar os designs."},regenerate:{button:"Regerar todos",tooltip:"O kit de marca foi alterado. Clique em 'Regerar todos' para atualizar todos os designs com as novas configurações de cores e fontes.",toastStarted:"A regeração dos designs foi iniciada. Esta tela será atualizada quando for concluída.",error:"Não foi possível iniciar a regeração dos designs",processing:"Regerando designs...",success:"Designs regerados com sucesso",failed:"Não foi possível regerar os designs. Tente novamente.",timeout:"A regeração dos designs está demorando mais que o esperado. Recarregue a página em alguns minutos para conferir o resultado.",lastAttemptFailed:"A última regeração dos designs falhou. Clique em 'Regerar todos' para tentar novamente."},card:{warningTooltip:"Design pendente de regeneração — o kit de marca foi atualizado"}},pageDesignForm:{newTitle:"Nova página",editTitle:"Editar página",headers:{create:"Novo design — Página",edit:"Editar design — Página"},tabs:{identification:"Identificação",design:"Design"},design:{gatedTooltip:"Salve a aba Identificação primeiro",gatedMessage:"Salve a aba Identificação para liberar o editor de design."},readOnlyMessage:"Este design é apenas para visualização.",identification:{fields:{name:{label:"Nome",placeholder:"Ex: Slide de abertura institucional"},type:{label:"Tipo",placeholder:"Selecione ou digite um tipo",tooltip:"Classifique este design por tipo de parte (ex: Capa, Corpo, Encerramento). Essa informação será utilizada para filtrar e organizar seus designs."},structureInstructions:{label:"Instruções de estrutura para a IA",placeholder:"Descreva quando e em qual contexto este design deve ser utilizado",tooltip:"Descreva em que momento e em qual contexto este design deve ser utilizado pela IA ao gerar o curso. Use os prompts sugeridos abaixo como ponto de partida e edite conforme necessário."},contentInstructions:{label:"Instruções de conteúdo para a IA",placeholder:"Descreva como a IA deve estruturar e estilizar o conteúdo",tooltip:"Descreva como a IA deve estruturar e estilizar o conteúdo exibido neste design."},sequence:{label:"Sequência",placeholder:"1",tooltip:"Defina em que posição este design deve aparecer na lista. Ex.: 1 = primeiro, 2 = segundo. Se essa posição já estiver ocupada, este design entra nela e os próximos descem automaticamente."}},validation:{nameRequired:"Informe o nome",nameMaxLength:"O nome deve ter no máximo {{max}} caracteres",structureInstructionsRequired:"Instruções de estrutura para a IA é obrigatório",structureInstructionsMaxLength:"Máximo de {{max}} caracteres",contentInstructionsMaxLength:"Máximo de {{max}} caracteres",sequenceRequired:"Informe a sequência",sequenceMin:"A sequência deve ser maior que zero"},buttons:{save:"Salvar",cancel:"Cancelar"}},predefinedFormats:{cover:"Capa",introduction:"Introdução",body:"Corpo",conclusion:"Encerramento",recap:"Recapitulação",summary:"Sumário"},prompts:{structure:{cover:"Usar sempre como primeira parte de qualquer aula.",introduction:"Aplicar no início do conteúdo para contextualizar o tema. Ideal quando há uma pergunta motivadora ou objetivo de aprendizagem a ser destacado.",body:"Utilizar para partes expositivas com conteúdo principal. Preferir este design quando o conteúdo for textual ou incluir imagem de apoio ao lado.",conclusion:"Reservar para a última parte da aula. Usar quando houver chamada para ação, resumo final ou mensagem de conclusão motivacional.",recap:"Utilizar após blocos de conteúdo para reforçar os pontos principais já apresentados.",summary:"Aplicar no início da aula para listar os tópicos que serão abordados."},content:{cover:"Deve conter o título da aula em destaque central. O texto deve ser curto, objetivo e visualmente dominante. Priorizar hierarquia clara de título e subtítulo (se houver) e um visual impactante que contextualize o tema da aula.",introduction:"Apresentar brevemente o tema da aula, contextualizando o assunto e deixando claro o que será aprendido. Pode incluir uma pergunta provocativa, um problema inicial ou um objetivo de aprendizagem em destaque.",body:"Desenvolver o conteúdo principal da aula, com explicações claras, exemplos e organização lógica. Priorizar textos objetivos, parágrafos bem distribuídos e, quando aplicável, imagens de apoio que reforcem o entendimento.",conclusion:"Finalizar a aula com um resumo dos principais aprendizados, uma mensagem de reforço ou uma chamada para ação (ex.: aplicar o conteúdo, avançar para o próximo tema ou refletir sobre o que foi aprendido).",recap:"Apresentar uma síntese dos conceitos abordados anteriormente. Preferir listas, bullets ou destaques visuais que facilitem a revisão rápida e a fixação dos pontos chave.",summary:"Exibir uma lista clara e organizada dos principais tópicos da aula. O texto deve ser objetivo, servindo como guia inicial do que será tratado ao longo do conteúdo."}},toast:{createSuccess:"Página criada com sucesso",updateSuccess:"Página atualizada com sucesso",error:"Erro ao salvar a página",designSaveSuccess:"Design da página salvo com sucesso",designSaveError:"Erro ao salvar o design da página",previewSaveWarning:"Conteúdo salvo, mas não foi possível gerar a pré-visualização."},toolbar:{brandKit:{label:"Kit de marca",placeholder:"Selecione um kit"},font:{label:"Fonte"}}},lessonDesignForm:{headers:{create:"Novo design — Aula",edit:"Editar design — Aula"},tabs:{identification:"Identificação",design:"Design"},identification:{buttons:{save:"Salvar",cancel:"Cancelar"}},design:{gatedTooltip:"Salve a aba Identificação primeiro",gatedMessage:"Salve a aba Identificação para liberar o editor de design."},unsavedChanges:{title:"Alterações não salvas",message:"Você tem alterações não salvas no design. Se sair desta aba agora, elas serão perdidas.",cancel:"Cancelar",confirm:"Sair sem salvar"},confirmChangesModal:{title:"Confirmação de alteração de orientação",description:"Ao mudar a orientação do design do modelo, a configuração atual do visual não será salva. Tem certeza que deseja alterar?"},readOnlyMessage:"Este design é apenas para visualização.",toast:{createSuccess:"Aula criada com sucesso",updateSuccess:"Aula atualizada com sucesso",error:"Erro ao salvar a aula",designSaveSuccess:"Design salvo. Preview será atualizado em breve.",designSaveError:"Erro ao salvar o design da aula",missingDesignEditorConfigError:"Este design não possui configuração de editor associada, por isso o conteúdo não pode ser salvo. Duplique o modelo novamente ou crie um novo design nesta aula.",backgroundImageUploadError:"Erro ao enviar a imagem de fundo. Tente novamente.",scriptSavedLocally:"Roteiro atualizado. Lembre de salvar o design."}}},designEditor:{brandKitSelector:{title:"Kits de marca"},panelItems:{logos:"Logotipos",reservedSlot:"Espaços IA"},logosTab:{title:"Logotipos",subtitle:"Logos do kit selecionado",empty:"Nenhum logo disponível para este kit."},reservedSlotTab:{title:"Espaços IA",editTitle:"Editar espaço IA",instructionsLabel:"Instruções para a IA",instructionsPlaceholder:"Descreva o que deve ser exibido neste espaço",instructionsTooltip:"Descreva o que deve ser exibido neste espaço. A IA usará esta descrição para gerar o conteúdo apropriado.",insertText:"Inserir texto",insertImage:"Inserir imagem",updateButton:"Atualizar",imageLabel:"Espaço para imagem (IA)",textLabel:"Espaço para texto (IA)",imageSubLabel:"Quadrado (1024×1024)",textSubLabel:"Parágrafo"},fontFamily:{brandFontsLabel:"Fontes da marca",commonFontsLabel:"Fontes comuns"}},colorPicker:{brandColorsTitle:"Cores da marca",otherColorsTitle:"Outras cores"}}}},Fse={pt:{translations:{trainingEffectiveness:{header:{title:"Eficácia de treinamentos"},tabs:{indicators:"Indicadores",models:"Modelos",assessments:"Avaliações"},indicators:{behavior:{badge:"N3 · Comportamento",title:"Índice de aplicação",description:"Mede em quantas pessoas o comportamento treinado chegou ao trabalho · % de pessoas com o comportamento aplicado, entre as avaliadas",highlightCaption:"aplicaram o que foi treinado",variation:"{{value}} p.p.",chartCaption:"% das pessoas avaliadas em cada mês · o verde é o índice de aplicação",legend:{applied:"Aplicou",partial:"Parcial",notApplied:"Não aplicou"},legendDetail:{applied:"positivo na escala",partial:"neutro"