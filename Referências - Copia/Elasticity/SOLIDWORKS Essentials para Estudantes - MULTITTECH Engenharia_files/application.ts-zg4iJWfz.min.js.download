Pagamento confirmado: inscrição confirmada.
Pagamento pendente: inscrição aguardando confirmação.
Pagamento em processamento de estorno: inscrição cancelada.
Pagamento estornado: inscrição cancelada.`,environmentStatus:"Situação da PESSOA na plataforma: Ativo (acessa o ambiente) ou Inativo (acesso desligado). Não muda a inscrição dela — continua na lista.",paymentStatus:`Quando há cobrança de inscrições por meio de ferramenta de cobranças, a situação da inscrição é automaticamente atualizada conforme a situação do pagamento:
Confirmado: inscrição confirmada.
Pendente: inscrição aguardando confirmação.
Estorno em processamento: inscrição cancelada.
Estornado: inscrição cancelada.`},registrationStatus:{confirmed:"Confirmado",pending:"Pendente",canceled:"Cancelado"},paymentStatus:{free:"Inscrição gratuita",confirmed:"Confirmado",pending:"Pendente",refundProcessing:"Estorno em processamento",refunded:"Estornado",canceled:"Cancelado"},defaultFilters:{confirmed:"Confirmados",pending:"Pendentes",canceled:"Cancelados"},actions:{history:"Histórico",edit:"Editar",delete:"Excluir",inactiveEdit:"Usuário inativo no ambiente",inactiveEditMessage:"Não é possível editar inscrição de usuário inativo no ambiente",engagedDelete:"Participante com engajamento ou transações de pagamento não pode ser excluído"},deletion:{title:"Confirmação de exclusão",confirmation:"O participante não terá mais vínculo com esse conteúdo, mas ainda será um usuário do ambiente. Tem certeza que deseja excluir?",success:"Participante excluído com sucesso",engagedTitle:"Não é possível excluir participante com engajamento",engagedDescription:"Tente cancelar a inscrição ao invés disso"},paymentHistory:{title:"Histórico de pagamentos",tooltip:"Ver histórico de pagamentos",empty:"Não há dados para exibir",loadError:"Não foi possível carregar o histórico de pagamentos.",entriesCount_one:"{{count}} registro",entriesCount_zero:"{{count}} registros",entriesCount_other:"{{count}} registros",refundInProgressNote:"Estorno em processamento",columns:{date:"Data",status:"Situação",paidValue:"Valor",installmentNumber:"Parcela",paymentMethod:"Pagamento",discountType:"Tipo de desconto",couponCode:"Código",identifiers:"Identificadores",registeredBy:"Registrado por",message:"Observação"},statuses:{confirmed:"Pagamento confirmado",pending:"Pagamento pendente",overdue:"Pagamento atrasado",refunded:"Pagamento estornado",freeEnrollment:"Inscrição gratuita",canceled:"Pagamento cancelado",enrollmentCanceled:"Inscrição cancelada",failed:"Pagamento recusado",refundFailed:"Falha no estorno"},paymentMethods:{manual:"Manual"},discountTypes:{coupon:"Cupom",voucher:"Voucher",companyGrant:"Concessão da empresa"},discountTypeLine:"Tipo: {{type}}",additionalDiscountLine:"Desconto adicional: {{value}} ({{percentage}}%)",additionalDiscountValueLine:"Desconto adicional: {{value}}",identifiers:{transaction:"Transação",refund:"Reembolso",error:"Erro"}}},subscriptions:{columns:{environment:"Ambiente",subscriptionDate:"Inscrito em",situationEnvironment:"Situação da inscrição",journeySituation:"Situação na jornada",label:"Etiqueta",situation:"Situação",situationOptions:{confirmed:"Confirmado",rejected:"Cancelado",pending:"Pendente",desisted:"Desistente",unknown:"Desconhecido",desisted:"Desistente"}},default_filters:{confirmed:"Confirmados",pending:"Pendentes",rejected:"Cancelados",desisted:"Desistentes"}},kinds:{learning_path:"trilha",course:"curso",package:"pacote"},identification:{copilot:{generate_title_prompt:"Gere um título para o meu curso e aplique direto no campo, sem me apresentar opções.",generate_description_prompt:"Gere uma descrição para o meu curso e aplique direto no campo, sem me apresentar opções."},sections:{data:"Dados",publico:"Público",chat:"Chat",settings:"Configurações",additional_info:"Informações complementares",dados_basicos:"Dados básicos",acesso_visibilidade:"Acesso e visibilidade",conteudo:"Conteúdo",notificacoes:"Notificações"},fields:{name:"Nome",description:"Descrição",code:"Código",experience_type:"Tipo de experiência",synchronism:"Sincronismo",classification:"Classificação",situation:"Situação",situation_options:{development:"Em desenvolvimento",released:"Liberado",suspended:"Suspenso"},visualization:"Quem pode ver (visualização)",visualization_options:{users:"Usuários",subscribers:"Inscritos",public:"Público",collaborators:"Colaborador"},restrict_access_period:"Restringir período de acesso",datetime_start:"Início do acesso",datetime_end:"Término do acesso (suspensão automática)",workload:"Carga horária",categories:"Categorias",notify_on_first_activity:"Enviar informação ao concluir a primeira atividade",notify_on_release:"Notificar usuários sobre liberação deste conteúdo",enable_twygo_chat:"Habilitar chat no conteúdo",event_type:"Tipo",outlet:"Canal",mode:"Modalidade",website:"Website",hashtag:"Hashtag",require_confirmation:"Exigir confirmação de inscrição",allow_group_registration:"Permitir registro de grupo de inscrições",allow_subscription_by:"Permitir inscrição por:",allow_individual_registrations:"Pessoa física",allow_company_registrations:"Pessoa jurídica (empresa com CNPJ)",age:"Idade",difficulty:"Dificuldade",tone_of_voice:"Tom de voz",target_audience:"Público alvo"},default_learning_experience:{course:"Curso",learning_path:"Trilha",package:"Pacote"},placeholder:{name:"Nome do {{kind_name}}",description:"Escreva a descrição do {{kind_name}}",categories:"Escreva os nomes das categorias separadas por vírgula",code:"Digite o código",workload:"HH:MM:SS",website:"https://exemplo.com",hashtag:"#hashtag",experience_type:"Digite ou selecione o tipo da experiência",classification:"Digite ou selecione a classificação",age:"Ex: 18-25 anos, 26-35 anos, Todas as idades...",difficulty:"Ex: Iniciante, Intermediário, Avançado, Especialista...",tone_of_voice:"Ex: Formal, Casual, Motivacional, Técnico",target_audience:"Ex: Iniciantes, Vendedores, Engenheiros..."},tooltip:{visualization:`Inscritos Somente usuários inscritos no conteúdo podem visualizar.

Colaborador Usuários marcados como colaboradores e usuários inscritos podem visualizar.

Usuários Qualquer usuário autenticado no seu ambiente pode visualizar.

Público Todos podem visualizar, incluindo visitantes sem login.`,require_confirmation:"Se habilitado, exigirá que o administrador confirme a inscrição de cada participante que se inscrever no pacote.",allow_group_registration:"Habilitar essa opção permite que uma pessoa adquira várias inscrições de uma só vez em um conteúdo, por meio de um grupo de inscrições.",allow_subscription_by:"Restringe quem pode se inscrever neste conteúdo: empresas, pessoas físicas ou ambas. Essa configuração afeta a tela de inscrição: se ambas as opções estiverem selecionadas, será solicitado ao usuário que escolha entre pessoa física ou jurídica durante a inscrição.",restrict_access_period:"Ao habilitar, você pode definir datas e horários específicos para início e término do acesso ao conteúdo.",datetime_start:"Define quando o acesso ao conteúdo será liberado para os usuários. Antes desse horário, a inscrição ainda pode ser realizada, mas o conteúdo permanece indisponível para visualização.",datetime_end:"Define até quando o conteúdo ficará acessível para os usuários. Após essa data e horário, a situação do conteúdo é automaticamente alterada para Suspenso.",workload:"Informe a carga horária no formato HHHH:MM:SS (horas:minutos:segundos)",notify_on_first_activity:"Um e-mail será enviado para o contato configurado neste conteúdo quando os usuários concluírem a primeira atividade.",notify_on_release:"Um e-mail será enviado para todos os usuários ativos do seu ambiente informando sobre a liberação deste conteúdo.",classification:"Defina uma classificação que complemente a identificação deste conteúdo. Ela poderá ser utilizada como filtro e ajudará os usuários a encontrarem itens com características semelhantes. Exemplos: Básico, Avançado, Evento ao vivo.",experience_type:"Escolha o rótulo que melhor representa este conteúdo para seus usuários. Ele serve para personalizar a forma como seus usuários verão e reconhecerão o conteúdo, funcionando como um identificador do tipo de experiência. Exemplos: Curso, Transmissão, Materiais."},options:{outlet:{in_company:"Em companhia",open:"Aberto",other:"Outros"},event_types:{talk:"Palestra",fair:"Feira",congress:"Congresso",other:"Outros",training:"Treinamento",webinar:"Webinar"},classification:{live:"Ao vivo",recorded:"Gravado",hybrid:"Híbrido"},synchronism:{live:"Ao vivo",recorded:"Gravado"},mode:{in_person:"Presencial",online:"Online"},notify:{yes:"Sim",no:"Não"}},validation:{datetime_required:"Preencha data e hora completas",datetime_end_after_start:"O término do acesso deve ser posterior ao início do acesso",workload_format:"{{field}} deve estar no formato HHHH:MM:SS (horas:minutos:segundos)",workload_integer:"{{field}} deve ser um número inteiro",workload_limit:"{{field}} deve ser menor ou igual a 0010:00:00",classification_invalid:"A classificação deve ter no máximo 30 caracteres",learning_experience_invalid:"O tipo de experiência deve ter no máximo 30 caracteres",access_end_expired_message:"Não é possível liberar o conteúdo com uma data de término anterior à data/hora atual.",no_emoji:"Caracteres inválidos. Remova símbolos/emojis e evite colar textos de outros locais"}},registrations:{mass_actions_confirmation:{update_to_confirmed_message:"A ação atualizar para confirmados será aplicada para {{count}} participantes",update_to_pending_message:"A ação atualizar para pendentes será aplicada para {{count}} participantes",update_to_cancelled_message:"A ação atualizar para cancelados será aplicada para {{count}} participantes",event_id:"Evento",update_to_confirmed:"Atualizar para confirmados",update_to_pending:"Atualizar para pendentes",update_to_cancelled:"Atualizar para cancelados",update_payment_status:"Atualizar situação do pagamento",update_expiration_date:"Atualizar data de expiração da inscrição",delete_participants:"Excluir participantes",update_title:"Atualização",default_message:"A ação será aplicada para {{count}} inscrições",update_to_desisted:"Atualizar para desistentes",update_to_desisted_message:"A ação atualizar para desistentes será aplicada para {{count}} inscrições",recalculate_progress:"Recalcular progresso",recalculate_progress_message:"O progresso será recalculado para {{count}} inscrições",recalculate_progress_title:"Recálculo de progresso",update_label:"Alterar a etiqueta",update_label_message:"A nova etiqueta será aplicada para {{count}} inscrições",update_label_title:"Alteração de etiqueta",update_label_field:"Alterar para",update_label_placeholder:"Informe a nova etiqueta",update_label_required:"Informe a nova etiqueta",update_label_max:"A etiqueta deve ter no máximo 255 caracteres"}},beforeUnload:{message:"É possível que as alterações feitas não sejam salvas."},header:{kinds:{0:{new:"Novo curso",edit:"Editar curso"},3:{new:"Nova trilha",edit:"Editar trilha"},4:{new:"Novo pacote",edit:"Editar pacote"}}},contents:{name:"Conteúdo",kind:"Tipo",learning_experience:"Tipo de experiência",situation:"Situação",actions:{delete:"Excluir"},save:"Salvar",mirrorPackageLockedTooltip:"Os conteúdos de um pacote recebido como espelho não podem ser alterados neste ambiente.",cancel:"Cancelar",apply:"Aplicar",cannotBeAddedToPackage:"Conteúdos com questões para corrigir (“Texto” e/ou “Arquivo”) ou chat ao vivo não podem ser incluídos em pacotes."},modal:{title:"Selecione os conteúdos que farão parte do pacote",search:"Pesquise pelo nome ou ID",apply:"Aplicar",cancel:"Cancelar",noResults:"Nenhum resultado encontrado",course:"Curso",event:"Evento",track:"Trilha",package:"Pacote",deleteContent:"O conteúdo será removido deste pacote. Tem certeza que deseja excluir?",error:"Erro ao buscar conteúdos"},steps:{file_upload:"Arquivo",content_course:"Dados",identification:"Identificação",assessment_settings:"Questionário",course_description:"Descrição",generated_activities:"Atividades",audio_selection:"Áudio",image_options:"Imagem"},charge:{sections:{payment:"Pagamento",trial_period:"Período de arrependimento",installments_table:"Simulação de parcelas"},fields:{payment_enabled:"Habilitar pagamento",subscription_value:"Valor",installments_number:"Número de parcelas",addition:"Acréscimo(%)",enable_trial_days:"Habilitar período de arrependimento",trial_days:"Quantidade de dias"},tooltip:{payment_enabled:"Quando habilitado, o pagamento integrado será disponibilizado para este conteúdo, permitindo que os alunos realizem o pagamento online.",payment_enabled_package:"Cobra o valor abaixo na inscrição, pela ferramenta configurada em Configurações > Cobrança de inscrição. Desligado, a inscrição é gratuita.",installments_number:"Número de parcelas disponíveis no momento do pagamento. Mínimo 1 e máximo 12.",addition:"Percentual de juros que será acrescido a partir da segunda parcela.",enable_trial_days:"Permite que o aluno solicite o cancelamento e o reembolso automático do valor pago dentro do período configurado.",trial_days:"Quantidade de dias, a partir da inscrição, em que o aluno poderá exercer o direito de arrependimento.",additional_info:"O texto informado será exibido ao lado da parcela, na página de pagamento."},installments:{minimum_value_error:"Não é possível ter valores de parcela menores do que R$ 5,00",info_placeholder:"Informações adicionais"}},payment:{installment_nr:"Parcela",installment_value:"Valor da parcela",total_value:"Valor total",additional_info:"Informações adicionais"},course_description_form:{confirm_navigation:{title:"Confirmação de retorno",message:"Tem certeza que deseja voltar? As informações preenchidas podem ser perdidas."}},back:"Voltar",next:"Próximo",previous:"Anterior",generate:"Gerar",regenerate:"Gerar novamente",data_loss_modal:{title:"Confirmação de retorno",message:"Voltar para a etapa anterior fará com que a importação de arquivos seja descartada e o processamento tenha que ser realizado novamente. Deseja continuar?",cancel:"Cancelar",confirm:"Voltar mesmo assim"},form:{location:{fields:{inform_physical_address:"Informar endereço físico para a realização do conteúdo",place:"Local",zip_code:"CEP",address:"Endereço",address_number:"Número",address2:"Complemento",neighborhood:"Bairro",city:"Cidade",state:"Estado",country:"País"},placeholder:{place:"Digite o local",zip_code:"00000-000",address:"Digite o endereço",address_number:"Digite o número",address2:"Digite o complemento",neighborhood:"Digite o bairro",city:"Digite a cidade",state:"Digite o estado",country:"Selecione o país"},validation:{zip_code_format:"CEP deve estar no formato 00000-000 ou 00000000",address_required:"Endereço é obrigatório quando endereço físico está habilitado",city_required:"Cidade é obrigatória quando endereço físico está habilitado",state_required:"Estado é obrigatório quando endereço físico está habilitado",country_required:"País é obrigatório quando endereço físico está habilitado"},messages:{success:"Localização salvo com sucesso",error:"Erro ao salvar localização",content_not_found:"Conteúdo não encontrado"}},course_name:"Tema",target_audience:"Público-alvo",number_of_activities:"Número de atividades",activity_type:"Tipo de atividades",objective:"Objetivo do curso",include_assessments:"Incluir questionário",add_more_data:"Adicionar mais dados",all_fields_added:"Todos os campos adicionados",activity_type_options:{page:"Página",lesson:"Aula"},access:{sections:{contact:"Contato",subscription:"Inscrição",access_period:"Acesso fora de horário",validity:"Vigência",attachments:"Anexos"},fields:{email:"E-mail do responsável",allow_subscription_by:"Permitir registro de inscrição por",require_subscription_confirmation:"Exigir confirmação de inscrição",allow_enrollment_package_registrations:"Permitir registro de grupo de inscrições",allow_individual_registrations:"Pessoa física",allow_company_registrations:"Pessoa jurídica (empresa com CNPJ)",days_to_expire:"Dias de acesso individual (vigência)",update_inscriptions:"Atualizar dias de acesso individual dos inscritos atuais",update_courses_days_to_expire:"Substituir os dias de acesso dos cursos pelos definidos na trilha",has_recertification:"Permitir reinscrição",block_registrations_without_active_grant:"Bloquear inscrição de empresas sem concessão ativa",block_registrations_without_registered_company:"Bloquear inscrição de empresas sem cadastro",restrict_access_period:"Restringir o acesso fora do horário configurado no modo de uso",allow_attachments:"Habilitar o envio de anexos na inscrição",attachment_description:"Mensagem de solicitação de anexos"},placeholder:{email:"Seu e-mail do responsável",days_to_expire:"Informe os dias",attachment_description:"Descreva a documentação ou arquivos a serem enviados"},tooltip:{allow_subscription_by:"Restringe quem pode se inscrever neste conteúdo: empresas, pessoas físicas ou ambos. Essa configuração afeta a tela de inscrição: se ambas as opções estiverem selecionadas, será solicitado ao usuário que escolha entre pessoa física ou jurídica durante a inscrição.",email:"Aparece na página pública do conteúdo como canal de dúvidas sobre a inscrição.",allow_attachments:"Ativa o envio de arquivos pelos inscritos.",days_to_expire:"Define a quantidade de dias após a inscrição em que o usuário terá acesso ao conteúdo.",validity:"Como o prazo é calculado. O pacote tem dois relógios e vale o que vencer primeiro: o período de acesso, igual para todos os inscritos, e os dias de acesso individual, que correm por pessoa a partir da inscrição. Dias em 0 significam sem limite por dias, valendo só o período. Enquanto a pessoa acessa pelo pacote, o prazo do pacote prevalece sobre a vigência própria dos conteúdos do acervo. Conteúdo que estiver em mais de um pacote da pessoa vale pelo acesso mais longo.",package_days_to_expire:"Número de dias de acesso que cada pessoa ganha a partir da inscrição no pacote. 0 significa sem limite por dias, valendo só o período de acesso.",update_inscriptions:"Ao alterar a vigência do conteúdo, permite aplicar essa mudança aos inscritos atuais, atualizando a data de expiração individual de cada um. A nova data de expiração será calculada a partir da data de inscrição.",update_individual_access_days_for_current_subscribers:"Ao alterar a vigência do conteúdo, permite aplicar essa mudança aos inscritos atuais, atualizando a data de expiração individual de cada um. A nova data de expiração será calculada a partir da data de inscrição.",update_courses_days_to_expire:"Ao alterar a vigência do conteúdo, permite aplicar essa mudança aos cursos vinculados, substituindo os dias de acesso individuais de cada curso. A nova data de expiração de cada curso será calculada conforme a vigência definida na trilha.",restrict_access_period:"Para que esta configuração seja efetiva é necessário que os horários de acesso estejam configurados no seu ambiente. Essa configuração pode ser realizada no menu Navegação > Modo de uso.",has_recertification:"Permite que alunos aprovados, com curso concluído ou data de expiração vencida se reinscrevam para refazer o conteúdo e renovar a certificação.",block_registrations_without_active_grant:"Só empresas com concessão ativa que alcance este conteúdo conseguem se inscrever (Empresas > Concessões). Concessão em outros conteúdos não vale. A regra também se aplica à pessoa física que informa a empresa nos dados profissionais.",block_registrations_without_registered_company:"Quando ativo, apenas empresas já cadastradas neste ambiente podem se inscrever em conteúdos. Se o CNPJ informado não for encontrado, a inscrição é bloqueada e a empresa não é cadastrada automaticamente. A regra também se aplica à pessoa física que informa a empresa nos dados profissionais."},validation:{email:"Informe um e-mail válido",positive_number:"Informe um número positivo",allow_at_least_one:"Selecione pelo menos uma modalidade de inscrição",attachment_description_required:"A mensagem de solicitação é obrigatória se o envio de anexos estiver habilitado"},errors:{event_id_required:"ID do evento é obrigatório"}},additional_fields:{age:{label:"Idade",placeholder:"Ex: 18-25 anos, 26-35 anos, Todas as idades..."},difficulty:{label:"Dificuldade",placeholder:"Ex: Iniciante, intermediário, Avançado, Especialista..."},tone_of_voice:{label:"Tom de voz",placeholder:"Ex: Formal, Casual, Motivacional, Técnico, Profissional..."},user_profile:{label:"Perfil do público",placeholder:"Ex: Profissionais em início de liderança..."},language:{label:"Idioma",placeholder:"Selecione o idioma",options:{portuguese:"Português",english:"Inglês",spanish:"Espanhol"}},additional_information:{label:"Informações adicionais",placeholder:"Ex: Informações específicas sobre o contexto, requisitos especiais, metodologia preferida..."},workload:{label:"Carga horária sugerida",placeholder:"HH:MM:SS"},has_questionnaire:{label:"Incluir questionário",options:{0:"Não",1:"Sim"}},questionCount:{label:"Nº de perguntas exibidas",tooltip:"Quantidade de perguntas que os alunos irão responder, limitado ao máximo de 100 perguntas."},alternativesPerQuestion:{label:"Nº alternativas por pergunta"},multipleChoiceQuestions:{label:"Múltipla escolha"},singleChoiceQuestions:{label:"Única escolha"},openTextQuestions:{label:"Aberta/Texto"},valueRangeQuestions:{label:"Faixa de valores",tooltip:"Os alunos colocam variações de 1 até 5 para cada pergunta elaborada"},showLimitApproval:{label:"Configurar visualização das respostas e percentual de aprovação"},responseVisualization:{label:"Visualização de respostas",tooltip:"Selecione como o usuário irá visualizar a correção do questionário, podendo ser, apenas a nota, as opções que ele respondeu ou as respostas corretas da questão",options:{score_only:"Exibir apenas nota",only_answered:"Exibir respondidas",answered_and_correct:"Exibir respondidas e respostas corretas"}},questionDisplay:{label:"Exibição das perguntas",tooltip:"Selecione como as perguntas serão exibidas em cada tentativa do questionário",options:{different_questions:"Exibir perguntas diferentes a cada tentativa",same_questions:"Exibir as mesmas perguntas nas tentativas",random_questions:"Exibir perguntas aleatoriamente",follow_order:"Exibir perguntas conforme ordem pré-definida"}},minimumScore:{label:"Pontuação mínima (%)",tooltip:"Informe o percentual mínimo de acertos para obter a aprovação no questionário"},approvalPercentage:{label:"% na pontuação final",tooltip:"Esse campo serve para você que usa mais do que um questionário no conteúdo e quer que eles tenham percentuais diferentes na soma total de todos os questionários"},attempts:{label:"Tentativas",tooltip:"Número máximo de tentativas permitidas para o questionário. Se for 0(zero) = tentativas infinitas",options:{unlimited:"Ilimitado",1:"1",2:"2",3:"3",5:"5",10:"10"}},requiredQuestions:{label:"Perguntas obrigatórias",tooltip:"Participante não pode concluir um questionário sem responder as perguntas obrigatórias"},allowParticipantComments:{label:"Permitir que o participante comente as questões",tooltip:"Permite que o participante adicione comentários nas respostas"},allowInstructorOpinion:{label:"Permitir parecer do instrutor",tooltip:"Permite que o instrutor adicione comentários nas respostas"},requireApprovalToComplete:{label:"Exigir aprovação para concluir a atividade",tooltip:"Quando habilitado, a atividade só será concluída após a aprovação do inscrito no questionário. Enquanto não for aprovado (ou estiver aguardando correção), a atividade ficará pendente, sem registrar progresso e pontuação. Questionários do tipo pesquisa são concluídos ao serem finalizados, independentemente deste parâmetro."},questionnaireQuantity:{label:"Quantidade de questionários",tooltip:"A quantidade de questionários que serão criados usando a mesma configuração. É considerado a partir da quantidade total de atividades que podem ser criadas do curso",options:{one_per_course:"1 para todo o curso",one_per_phase:"1 por etapa",at_end_of_course_and_each_phase:"Ao final do curso e em cada etapa"}}},placeholder:{course_name:"Ex: Marketing Digital, Programação Python, Fotografia...",target_audience:"Ex: Iniciantes, Vendedores, Engenheiros...",objective:"Ex: Capacitar os alunos a entender os fundamentos da programação Python."},values_radio_of_assessments:{0:"Não, apenas conteúdos das aulas",1:"Sim, incluir questionários ao final das atividades"},assessment_settings:{include_assessments:"Configurações de avaliação"},question_count:{label:"Número de perguntas",placeholder:"Ex: 5"},required_questions:{label:"Perguntas obrigatórias",tooltip:"Participante não pode concluir um questionário sem responder as perguntas obrigatórias"},file_upload:{file_upload_header:"Envie os arquivos que serão usados para criar o curso",additional_orientation:"Envie documentos com no máximo 100 páginas."},content_details:{success:"Atividades geradas com sucesso",include_content_details:"Informe os dados básicos do curso que você deseja criar"},generated_activities_form:{select_activities:"Selecione as atividades que deseja incluir"},audio_selection:{title:"Escolha a voz para narrar suas aulas",description:"Selecione a voz que melhor se adequa ao tom do seu curso. Você pode ouvir uma amostra de cada voz antes de escolher.",example_text:"Texto de exemplo:",description_example:"Olá! Seja muito bem-vindo. Neste treinamento sobre liderança estratégica, vamos conhecer um case de resiliência organizacional e discutir a importância do feedback assertivo. Também exploraremos juntos o significado da frase 'aprendizagem ativa aprimora a autonomia' e como ela se aplica no dia a dia. Além disso, abordaremos temas como gamificação e metacognição.",voice_selected:"Voz selecionada:",play_sample:"Ouvir amostra",duration:"Duração",no_audios:"Nenhuma voz disponível",loading:"Carregando vozes de áudio...",loading_title:"Carregando os áudios de exemplo",loading_description:"Isso pode levar alguns segundos",errors:{load_failed:"Erro ao carregar vozes de áudio. Tente novamente.",play_failed:"Erro ao reproduzir áudio. Tente novamente."}},error:"Erro ao salvar o formulário",success:"Formulário salvo com sucesso",validation:{theme:{required:"O tema do curso é obrigatório e não pode ficar vazio"},targetAudience:{required:"O público alvo é obrigatório e não pode ficar vazio"},numberOfLessons:{required:"O número de aulas é obrigatório e não pode ficar vazio",min:"O número de aulas deve ser maior que 0",max:"O número de aulas deve ser menor que 30"},objective:{required:"O objetivo do curso é obrigatório e não pode ficar vazio"},activityType:{required:"Selecione pelo menos um tipo de atividade"},hasQuestionnaire:{required:"A opção de incluir avaliações é obrigatória"},questionCount:{required:"A quantidade de perguntas é obrigatória",min:"A quantidade de perguntas deve ser pelo menos 1",max:"A quantidade de perguntas deve ser no máximo 50",integer:"A quantidade de perguntas deve ser um número inteiro"},alternativesPerQuestion:{min:"A quantidade de alternativas deve ser pelo menos 2"},requiredQuestions:{required:"A opção de perguntas obrigatórias é obrigatória"},maxQuestionsPerType:"A soma total dos tipos de perguntas não pode exceder 100",minQuestionsPerType:"O número de perguntas por tipo é menor que o total de perguntas exibidas ao aluno"},loader_steps:{loader_title:"Gerando o nome e a descrição do curso",loader_description:"Isso pode levar alguns segundos",loader_activities:"Gerando a sugestão de atividades...",loader_course:"Gerando o curso..."},sections:{questionnaire_settings:"Configurações do questionário",questionnaire_settings_description:"Ajuste os parâmetros para a avaliação do questionário do tipo prova.",questionsPerType:{label:"Quantidade de perguntas geradas por tipo",tooltip:"Insira a quantidade desejada de perguntas a serem distribuídas para o aluno. A soma de cada tipo deve ser igual ou maior ao valor inserido da quantidade de perguntas exibidas. A quantidade de perguntas não pode exceder 100"},limitApproval:"Aprovações e limites",comments:"Comentários"}},ai_generator_error:{title:"Oh não!",message0:"Tivemos uma falha inesperada ao gerar esse resultado para você.",message1:"Tente novamente em alguns instantes. Se o erro continuar, entre em contato com o suporte pelo chat.",retry:"Tentar novamente",retry_in:"Tentar novamente em {{time}}",max_retries_message0:"Após várias tentativas, não foi possível concluir o processo.",max_retries_message1:"Nosso time de suporte está disponível no chat para resolver isso com você."},new_with_ai:{creation_type:{quick:{title:"Assistente de criação",description:"Defina alguns parâmetros e a IA monta o curso passo a passo."},import:{title:"Importar arquivo",description:"Envie documentos e transforme-os em curso automaticamente."}}},edit_with_ai:{generating_course:"Gerando seu curso",description:"A Soph.ia está criando um curso personalizado com base nas suas respostas. Esse processo pode levar algum tempo, mas não se preocupe: você pode continuar usando seu ambiente normalmente. Assim que tudo estiver pronto, você receberá uma notificação.",theme:"Nome:",minute:"minuto",minutes:"minutos",estimated_time:"Tempo estimado restante:",progress:"Progresso",initial_data_creation:"Iniciando criação do curso...",analyzing_themes:"Analisando tema e público-alvo...",structuring_modules:"Estruturando módulos e aulas...",creating_content:"Criando conteúdos de aulas...",creating_lesson:"Criando conteúdos de aulas...",creating_questionnaire:"Elaborando avaliações e exercícios...",creating_images:"Aplicando imagens...",finalizing_course:"Finalizando e otimizando curso...",proceed_to_edition:"Prosseguir para edição",creation_completed:"A Soph.ia concluiu a criação do seu curso",proceed_to_edition_description:"Agora você pode revisar e personalizar os conteúdos de acordo com as necessidades do seu ambiente"},identification_form:{success_title:"Título do curso gerado com sucesso",success_title_description:"O título do curso foi gerado com sucesso. Você pode agora revisar e personalizar conforme necessário.",success_description:"Descrição do curso gerada com sucesso",success_description_description:"A descrição do curso foi gerada com sucesso. Você pode agora revisar e personalizar os conteúd