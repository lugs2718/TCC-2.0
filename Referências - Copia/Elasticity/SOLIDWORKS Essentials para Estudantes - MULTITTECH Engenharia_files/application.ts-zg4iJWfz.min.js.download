sões de conteúdo"},paginator:{next:"Próximo",previous:"Anterior"},print:{filters:{label:"Filtros aplicados",period:"Período",names:"Nomes",departments:"Área",enterprises:"Empresa",roles:"Cargo",progress:"Progresso",status:"Situação",all_students:"Todos os estudantes",not_started:"Não iniciados",started:"Iniciados",completed:"Concluidos",0:"Todos os alunos",1:"Aprovados",2:"Em andamento"}},...pi.pt.translations}}},Rne={pt:{translations:{modalNews:{modalTitle:"Novidades: a inteligência artificial chegou na Twygo. Teste o BETA",askLaterButton:"Ver mais tarde",understoodButton:"Ok, entendi"},learningPathV2LaunchDescription:{title:"Novidades: gestor de turma, instrutor e indicadores da trilha",moreUpdatesComing:"Mais atualizações das trilhas saindo do forno! Agora, tanto os instrutores quanto os gestores de turma podem ser atribuídos para trilhas. Veja o que eles podem fazer:",instructor:"Instrutor:",instructorImprovements:{studentsPerfomance:'Acompanhar o desempenho dos participantes. ("Aprendizagem")',editLearningPath:'Adicionar e editar conteúdos da trilha. ("Atividades")'},classManager:"Gestor de turma:",classManagerImprovements:{subscribeStudents:"Inscrever usuários na trilha.",studentsPerfomance:'Acompanhar o desempenho dos participantes que ele gerencia. ("Aprendizagem")'},dashboardProgressCertificate:'Além disso, os números de "certificados" e "progresso" no dashboard agora incluem dados das trilhas. Assista ao vídeo abaixo para mais detalhes:'},learningPathLaunchDescription:{title:"Novidades: emissão de certificados nas trilhas e alterações no ambiente adicional",changes:"A trilha mudou! Confira as melhorias:",improvements:{startDate:"Data de início e término",certificates:"Certificados personalizados",newSpace:"Novo espaço para organizar as atividades de uma trilha"},additionalEnvironments:"Ambientes adicionais",additionalEnvironmentsDescription:"E não é só isso! Também melhoramos a maneira como você gerencia e compartilha conteúdos com ambientes adicionais, para tornar essa funcionalidade ainda mais simples de usar!",checkOutVideo:"Confira tudo isso no vídeo abaixo:"},newLogs:{modalTitle:"Novidades: Registros de alterações",boldText:"Agora usuários e administradores terão acesso aos registros das movimentações que acontecem dentro da plataforma. ",normalText:"A funcionalidade de registros de alteração, que estava em manutenção, voltou. Vai ser possível acompanhar:",listItem1:"Alterações nos cadastros de usuário",listItem2:"Movimentações de acesso (login e logout)",listItem3:"Alterações dentro da organização",listItem4:"Alterações nas regras do jogo (gamificação)",listItem5:"Alterações nas regras de comunicação (comunidades)"},sophIA:{normalText1:"Explore o BETA e veja o poder da",normalText2:": a sua assistente para criar conteúdos e questionários em um passe de mágica. Queremos saber a sua opinião durante o teste! Sua participação é fundamental no desenvolvimento dessa novidade.",normalText3:"OBS. Por ser uma função BETA, nem tudo estará perfeito, mas contamos com a sua ajuda para tornar essa novidade ainda melhor"},newUserMassInactivation:{modalTitle:"Novidade: Inativação em massa",boldText:"Mais facilidade para gerenciar usuários!",normalText:'Agora é possível inativar ou ativar usuários em massa, pela importação do menu "Usuários".',checkOutVideo:"Confira o passo a passo no vídeo abaixo:"},newApiV2:{title:"Novidade: Nova API e indicadores avançados com Power BI",normalText1:"Mais dados e indicadores do seu ambiente.",normalText2:"Apresentamos uma nova API para leitura dos principais dados da plataforma: usuários, questionários, certificados, cursos e muito mais.",normalText3:"Aproveite também os indicadores direto de um template pronto para Power BI.",normalText4:"Confira tudo isso no vídeo abaixo:"},newLearningPathOnPlay:{modalTitle:"Conheça o Play: a facilidade do streaming, agora no seu ambiente e outras novidades",seeMoreVideo:"Confira tudo isso no vídeo abaixo:",playDescription:"Com o Play os usuários terão acesso rápido e fácil aos conteúdos, sugestões personalizadas de cursos e trilhas baseadas nos seus interesses, além de uma interface fácil que exibe resumos, prévias e todas as informações relevantes dos cursos e trilhas diretamente na tela. O aprendizado a um clique de distância. Já disponível no seu ambiente",more:{title:"E ainda:",listItem1:{title:"Pacotes de Inscrição: ",description:"nova função para inscrição de várias pessoas em um mesmo curso."},listItem2:{title:"Inscrição por CNPJ: ",description:'empresas agora podem inscrever seus colaboradores por CNPJ e você acompanha no novo menu "Empresas"!'}}},twygoAcademyNotification:{modalTitle:"Novo canal de suporte e conteúdos sobre T&D para você!",firstBlock:{emoji:"💡",tAndD:"Twygo Connect",normalText1:"criamos um espaço especial para capacitação sobre Treinamento e Desenvolvimento! ",normalText2:"No",normalText3:", você encontrará todos os nossos webinars e poderá aprimorar suas habilidades."},secondBlock:{title:"Para acessar o novo ambiente é simples: ",normalText1:"clique em “Administrador” no canto superior direito > Clique sobre “Twygo Connect”."},thirdBlock:{title:"Suporte via WhatsApp: ",normalText1:"para tornar nosso atendimento ainda mais ágil, adicionamos o suporte via WhatsApp! Agora nossos canais oficiais de suporte são:",options:{email:"✉️ E-mail: suporte@twygo.com",phone:"☎️ Telefone: 0800 878 9638",whatsapp:"📱 WhatsApp: +55 47 3170-0642"}},fourthBlock:{title:"👀 E tem mais: ",normalText1:"De 06 a 08 de agosto, teremos o",tAndDConference:"T&D Conference 2024:",normalText2:"três dias de palestras e debates sobre treinamento e desenvolvimento. Ainda dá tempo de se inscrever para ver ao vivo ou receber a gravação!"}},accessTwygoAcademy:{modalTitle:"Conheça a Academia Twygo",textblock1:"📚 Academia Twygo: seu novo espaço para tirar dúvidas sobre a plataforma!",textblock2:"A Academia Twygo é um ambiente exclusivo onde você pode acessar conteúdos para esclarecer todas as suas dúvidas sobre a Twygo.",textblock3:{bold:"Para acessar a Academia Twygo, não é necessário criar um novo login.",normal:"Basta acessar pelo seu ambiente > Clicar em “Administrador” > Academia Twygo."},textblock4:"🎥 Assista ao nosso vídeo explicativo para entender melhor."},faceliftAndCertificate:{modalTitle:"Algumas coisas estão diferentes por aqui.... ",textblock1:"Redesenhamos algumas coisas para facilitar ainda mais o seu dia a dia.",textblock2:{normal:"Você terá mais filtros, dashboards, extração de dados simples e ações em massa em várias áreas:",bold:"“Conteúdos”, “Usuários”, “Questionários”, “Aprendizagem” e “Equipe”."},secondVideoTitle:"Nova área para certificados",secondVideoDescription:"Gerenciar e personalizar seus modelos de certificado ficou ainda mais fácil! Com a nova área exclusiva, você pode customizar seus certificados de forma prática e organizada.",secondVideoDescription2:"Aproveite as novidades! 🚀",textblock3:"🎉 Confira o vídeo abaixo para ver todos os detalhes!"},ecossystemEnvironments:{modalTitle:"Algumas coisas estão diferentes por aqui....",textblock1:"Mais clareza e controle para quem compartilha conteúdos!",changes:{title:"O compartilhamento de conteúdos foi aprimorado para oferecer mais clareza e controle. Veja o que mudou:",listItem1:{part1:"🔄 Escolha entre ",part2:"“Cópia livre” ",part3:"ou ",part4:"“Controlada” ",part5:"ao compartilhar um conteúdo com outro ambiente."},listItem2:{part1:"👁️ Visualize de forma clara ",part2:"em quais ambientes o conteúdo está compartilhado."},listItem3:{part1:"🔐 Alguns campos agora são ",part2:"editáveis ou protegidos, ",part3:"dependendo do formato de compartilhamento."},listItem4:{part1:"📊 Acompanhe o uso do seu plano e os ambientes adicionais através da área de ",part2:"Plano e assinatura."}},checkOutVideo:"Assista ao vídeo e veja na prática como aproveitar essa novidade:"},ecossystemEnvironments2:{modalTitle:"Novidade: Pacotes de conteúdos",textblock1:"Mais praticidade para organizar e compartilhar conteúdos!",changes:{title:{part1:"Com os ",part2:"Pacotes de conteúdos ",part3:"você pode criar agrupamentos personalizados e também compartilhar com outros ambientes."},whatChanged:"Veja o que é possível fazer:",listItem1:{part1:"📦 Agrupe cursos e trilhas em ",part2:"pacotes organizados."},listItem2:{part1:"🖼️ Personalize banners ",part2:"exclusivos para os pacotes no Play."},listItem3:{part1:"🎯 Destaque pacotes com ",part2:"filtros, categorias e controle de visibilidade: ",part3:"para inscritos, usuários logados, colaboradores ou público geral."},listItem4:{part1:"🔄 Compartilhe pacotes com outros ambientes ",part2:'como "Cópia livre" (independente) ou "Controlada" (mantém as atualizações sincronizadas com o conteúdo original).'},checkOutVideo:"Confira o passo a passo no vídeo abaixo:"}},novoVersoDoCertificado:{modalTitle:"Novidade: mais liberdade e alcance para seus certificados",textblock1:"Mais flexibilidade e recursos para deixar seus certificados com a cara da sua marca!",changes:{title:{part1:"Confira as principais novidades:"},listItem1:{part1:"🖼️ Imagens personalizadas: ",part2:"adicione logos, selos e elementos visuais livres."},listItem2:{part1:"🔁 Verso configurável: ",part2:"crie certificados frente e verso com facilidade e inclua automaticamente a lista de atividades no verso."},listItem3:{part1:"🧩 Mais dados dinâmicos: ",part2:"insira campos como local, instrutores, empresa, frequência e muito mais — tudo atualizado automaticamente."},listItem4:{part1:"✍️ Editor de texto aprimorado: ",part2:"personalize fontes, listas e formatação com liberdade."},listItem5:{part1:"🔗 Compartilhamento no LinkedIn: ",part2:"permita que alunos compartilhem certificados diretamente no LinkedIn, ampliando a visibilidade dos seus cursos e da sua marca."},checkOutVideo:"Assista ao vídeo e veja como aproveitar essas novidades:"}},publicLearningPath:{modalTitle:"Novidades para deixar suas trilhas ainda mais completas",textblock1:"Mais flexibilidade e controle para criar experiências de aprendizagem incríveis!",changes:{listItem1:{part1:"🌐 Páginas públicas e visualização ampliada: ",part2:"defina se suas trilhas serão exibidas para colaboradores, usuários logados ou visitantes — assim como nos cursos"},listItem2:{part1:"💳 Venda de trilhas com pagamento integrado: ",part2:"ative vendas diretamente pela plataforma, com suporte a pagamento parcelado e dias de teste"},listItem3:{part1:"📊 Relatórios e exportações aprimorados: ",part2:"exporte dados completos de trilhas e inscrições, com novos filtros e campos para facilitar a análise"},listItem4:{part1:"🔄 Importação e inscrições em massa via API V2 ",part2:"ganhe eficiência ao criar, atualizar e gerenciar trilhas e inscrições de forma automatizada"},checkOutVideo:"Assista ao vídeo e veja como aproveitar essas novidades:"}},useModeAndPlayFilters:{modalTitle:"Novidade: personalize menus e crie filtros no Play",textblock1:"Mais autonomia para organizar a experiência dos alunos!",changes:{title:{part1:"Agora é possível personalizar os menus exibidos na visão dos alunos e criar filtros personalizados no Play."},listItem1:{part1:"✏️ Edite o nome, ícone e ordem dos menus."},listItem2:{part1:"🔗 Crie menus com links externos ou que direcionem para outros ambientes."},listItem3:{part1:"🎯 Monte um menu com visual do Play, mas com filtros aplicados — ideal para dar foco a determinados conteúdos."},listItem4:{part1:"🧠 Administradores e alunos agora podem criar e salvar seus próprios filtros no Play!"},checkOutVideo:"Confira o passo a passo no vídeo abaixo:",whatChanged:"Veja o que mudou:"}},ssoAuthentication:{modalTitle:"Novidade: Autenticação SSO",textblock1:"Mais segurança e praticidade para o login dos seus usuários corporativos",changes:{title:{part1:"Agora é possível autenticar usuários corporativos via SSO (Single Sign-On)."},listItem1:{part1:"🔐",part2:"Login unificado",part3:": seus usuários acessam a Twygo usando as credenciais corporativas, sem precisar criar ou lembrar outra senha."},listItem2:{part1:"🧩",part2:"Integração com provedores de identidade",part3:": compatível com",part4:"Microsoft Azure AD, Google Workspace, Okta",part5:"e outros provedores SAML."},listItem3:{part1:"🛡️",part2:"Mais controle e segurança",part3:": autenticação centralizada, sem redefinições de senha na Twygo."},importantNote:{part1:"💡",part2:"Importante",part3:": verifique se o seu plano atual inclui o recurso de autenticação via SSO."},checkOutVideo:"Confira mais detalhes no vídeo abaixo:",whatChanged:"Veja o que mudou:"}},fourFeaturesRelease:{modalTitle:"Quatro novidades para facilitar o seu dia a dia",items:{item1:{title:"Mudanças visuais e carga horária flexível",text:"A edição de conteúdos foi reorganizada em abas e ganhou dois campos novos: Tipo de experiência, o rótulo pelo qual seus usuários vão reconhecer cada conteúdo, e Classificação, que ajuda a segmentar e filtrar. A carga horária agora aceita horas, minutos e segundos, e o menu lateral pode ser recolhido pra sobrar mais espaço de tela."},item2:{title:"Horário de acesso e feriados",text:"Configure no modo de uso os horários em que cada equipe pode usar a plataforma, com intervalos por dia da semana e feriados à parte. Fora do horário, você escolhe o que bloquear: o ambiente inteiro, todos os conteúdos ou apenas os que você marcar."},item3:{title:"Marca d'água em vídeos e arquivos",text:"Estampe a identificação de quem está acessando CPF, e-mail, IP ou ID da sessão sobre vídeos e arquivos, para inibir gravações e compartilhamentos não autorizados. Você define cor e tamanho e, nos vídeos, a posição e se a marca fica fixa ou em movimento."},item4:{title:"Cadastro e gestão de usuários pela API 2.0",text:"Agora a API 2.0 cria, atualiza, busca, ativa, inativa e exclui usuários inclusive vários de uma vez. Se você já gerencia pessoas em outro sistema, ele pode manter a Twygo atualizada automaticamente. Os detalhes estão na documentação.",documentationButton:"Ver documentação"}}}}}},Dne={pt:{translations:{selectOrderType:"Tipo de avanço",free:"Livre",mandatory:"Sequência obrigatória",selectOrderTypeTip:"No avanço livre os inscritos na trilha poderão escolher em qual ordem eles farão as atividades. No avanço de sequência obrigatória eles terão de seguir a ordem definida abaixo.",destroyMessage:"Ao completar essa ação, os inscritos não poderão mais realizar essa atividade por essa trilha. Tem certeza que deseja excluir?",destroyFirstActivity:"A exclusão pode alterar o progresso e aprovação dos inscritos na trilha. Tem certeza que deseja continuar?",titles:{addActivities:"Adicionar atividades"},search:{label:"Buscar atividade",typeHere:"Digite aqui",add:"Adicionar",noResult:"Nenhum resultado encontrado",tooltip:"Caso a trilha seja compartilhada externamente, ou esteja como pública, cursos recebidos como controlados não serão exibidos."},buttons:{back:"Voltar",save:"Salvar",cancel:"Cancelar"},notReleasedContentModal:{title:"Existem cursos não liberados na sua trilha",message:'Existem cursos "Em desenvolvimento" e/ou "Suspenso" na sua trilha. Os alunos não conseguirão fazer esses cursos enquanto não estiverem como "Liberados". Tem certeza que deseja prosseguir com a criação da trilha?',confirm:"Continuar mesmo assim",cancel:"Cancelar"},labels:{order:"Ordem",name:"Nome",kind:"Tipo",learningExperience:"Tipo de experiência",activityWeight:"Peso",approvalRequired:"Obrigatório para aprovação",approvalCriteria:"Critério para aprovação",situation:"Situação"},SelectOptions:{approvalCriteria:{byConclusion:"Concluído",byApproval:"Aprovado",byCertificate:"Certificado"}},ToolTips:{approvalRequiredHelp:"Marcar essa coluna demonstra que esse conteúdo é obrigatório para o inscrito ser aprovado na trilha.",approvalCriteriaHelp:"Selecione o critério que o inscrito precisa atingir para ser aprovado em cada item. Para ser aprovado na trilha ele precisa obter aprovação em todos os itens obrigatórios para aprovação.",activityWeightHelp:"O peso influencia no progresso do inscrito na trilha. Atividades com peso 0 não são consideradas para o progresso na trilha."},changeApprovalCriteriaModal:{title:"Confirmação de alteração",body:`Ao salvar alterações os inscritos poderão ter as aprovações alteradas de acordo com os novos critérios. 
 Tem certeza que deseja continuar?`,buttons:{confirm:"Confirmar",cancel:"Cancelar"}},changeActivityWeightModal:{title:"Confirmação de alteração de peso",body:"Ao salvar as alterações os inscritos terão o progresso recalculado de acordo com o novo peso. Tem certeza que deseja continuar?",buttons:{confirm:"Confirmar",cancel:"Cancelar"}},AddConfirmationModal:{title:"Confirmação de alteração",message:`Ao salvar alterações os inscritos terão o progresso recalculado. 
 Tem certeza que deseja continuar?`,buttons:{confirm:"Confirmar",cancel:"Cancelar"}},sharedParticipantsWarningModal:{title:"Não é possível vincular o curso à trilha",partner_names_message:"Os inscritos abaixo estão atualmente participando desse curso por meio do(s) ambiente(s) adicional(is) {{partnerNames}}.",current_env_message:"O acesso desses inscritos a esse curso está restrito a esse(s) ambiente(s) específico(s), impossibilitando qualquer vinculação dos inscritos ao curso no ambiente atual {{organizationName}}.",participants:"Inscritos:",buttons:{understood:"Ok, entendi"}},cantDestroyTooltipLabel:"Esta atividade não pode ser excluída pois já possui engajamento de inscritos ou faz parte de um conteúdo compartilhado como 'cópia controlada'."}}},zne={pt:{translations:{buttons:{delete:"Excluir"}}}},Lne={pt:{translations:{navigation:{previous:"Anterior",next:"Próximo"}}}},Nne={pt:{translations:{pdiKpiPanel:{filterField:"Indicador",errors:{loadFailed:"Não foi possível carregar os indicadores do PDI."},cards:{in_progress:{label:"Em andamento",help:"PDIs aprovados pelo líder de equipe e em execução. Mostra o número e o % sobre os PDIs do recorte."},pending_approval:{label:"Pendente de aprovação",help:"PDIs que o colaborador enviou e que aguardam a aprovação do líder de equipe."},without_active_pdi:{label:"Sem PDI ativo/cadastrado",help:"Colaboradores do recorte sem PDI ativo, incluindo quem está com o PDI vazio (não preenchido). O % é sobre o total de colaboradores."},overdue_actions:{label:"Ações atrasadas",help:"Ações com o prazo de conclusão vencido e ainda não concluídas, nos PDIs ativos."},average_progress:{label:"Progresso médio",help:"Média do progresso das ações dos PDIs que estão em andamento."},completed_actions:{label:"Ações concluídas",help:"Ações marcadas como concluídas nos PDIs ativos. Mostra o número e o % sobre o total de ações."},completed_on_time_actions:{label:"Ações concluídas no prazo",help:"Ações concluídas dentro do prazo de conclusão. É um subconjunto das ações concluídas."}}}}}},Mne={pt:{translations:{ssign:{tab_title:"Assinatura de certificados",form:{sections:{account:"Dados de acesso ao S-Sign",webhook:"Endereço de aviso"},labels:{serviceUrl:"Endereço do S-Sign",accessKey:"Chave de acesso",webhookAddress:"Endereço para receber os avisos"},placeholders:{serviceUrl:"https://suaempresa.satelitti.com.br",accessKey:"Cole aqui a chave gerada no seu S-Sign",accessKeyConfigured:"Chave já cadastrada. Digite uma nova para substituir"},tooltips:{serviceUrl:"Endereço do seu S-Sign: o subdomínio que a Selbetti criou para a sua empresa, sempre com https",accessKey:"Gere a chave no seu S-Sign, em Configurações > Integração > Chave, e cole aqui",webhookAddress:"Copie este endereço e cole na configuração da integração dentro do S-Sign, para recebermos o aviso quando um documento for assinado"},errors:{serviceUrlRequired:"Informe o endereço do S-Sign",serviceUrlMustBeHttps:"O endereço precisa ser uma URL https válida",accessKeyRequired:"Informe a chave de acesso",loadFailed:"Não foi possível carregar a configuração do S-Sign",saveFailed:"Não foi possível salvar a configuração do S-Sign"},messages:{saved:"Configuração do S-Sign salva"}}},sso:{tab_title:"Autenticação SSO via SAML",form:{sections:{metadata:"Metadados",settings:"Configurações",activation:"Ativação"},placeholders:{domain:"Selecione o domínio padrão"},labels:{certificate:"Certificado do IdP",sso_url:"URL do SSO",activate:"Ativar SSO",hide_login_page:"Esconder tela de login",email_field:"Nome do atributo do e-mail",domain:"Domínio",file_name:"Arquivo"},tooltips:{activate:"Ativar SSO",sso_url:"Insira aqui a URL fornecida pelo seu provedor de identidade (IdP) para onde os usuários serão direcionados ao realizar login via SSO.",certificate:"Cole aqui o certificado fornecido pelo seu provedor de identidade (IdP), necessário para validar a autenticação via SAML.",email_field:'Informe o nome do atributo que o seu provedor de identidade utiliza para enviar o e-mail 