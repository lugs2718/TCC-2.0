ampaign}\\u003c/b\\u003e campaign has started. You have an open IDP: \\u003cb\\u003e%{pdi_title}\\u003c/b\\u003e (status: \\u003cb\\u003e%{pdi_status}\\u003c/b\\u003e).\\u003cbr\\u003e\\u003cbr\\u003eBy \\u003cb\\u003e%{end_date}\\u003c/b\\u003e, review and update the actions, or complete this IDP and create a new one. This task also appears on your dashboard.","cta":"Open my IDP","subject":"IDP · %{campaign}: update your IDP by %{end_date}"}},"completed":{"body":"\\u003cb\\u003e%{collaborator}\\u003c/b\\u003e completed the IDP with \\u003cb\\u003e%{progress} of the actions completed\\u003c/b\\u003e and awaits your \\u003cb\\u003evalidation\\u003c/b\\u003e.","cta":"Validate completion","message_label":"Comment","next_step":"Validate the completion or reopen the IDP with a justification so the employee can continue.","subject":"%{collaborator} completed the IDP and awaits your validation"},"greeting":"Hello, %{name}.","rejected":{"body":"\\u003cb\\u003e%{leader}\\u003c/b\\u003e \\u003cb\\u003erejected\\u003c/b\\u003e your IDP.","cta":"Adjust my IDP","message_label":"Justification","next_step":"You can edit the IDP and send it for approval again.","subject":"your IDP was rejected"},"reopened":{"body":"Your IDP was \\u003cb\\u003ereopened\\u003c/b\\u003e by \\u003cb\\u003e%{who}\\u003c/b\\u003e and is back \\u003cb\\u003eIn progress\\u003c/b\\u003e.","cta":"Open my IDP","message_label":"Justification","next_step":"You can edit the actions again.","subject":"your IDP was reopened"},"returned":{"body":"\\u003cb\\u003e%{leader}\\u003c/b\\u003e returned your IDP for \\u003cb\\u003eadjustment\\u003c/b\\u003e.","cta":"Adjust my IDP","message_label":"Comment","next_step":"Make the adjustments and send the IDP for approval again.","subject":"your IDP was returned for adjustment"},"subject_prefix":{"with_campaign":"IDP · %{campaign}: %{subject}","without_campaign":"IDP: %{subject}"},"submitted":{"body":"\\u003cb\\u003e%{collaborator}\\u003c/b\\u003e sent the IDP for your \\u003cb\\u003eapproval\\u003c/b\\u003e.","cta":"Review IDP","next_step":"Review the actions and choose one option: \\u003cb\\u003eapprove\\u003c/b\\u003e, \\u003cb\\u003ereturn for adjustment\\u003c/b\\u003e or \\u003cb\\u003ereject with a justification\\u003c/b\\u003e.\\u003cbr\\u003e\\u003cbr\\u003eWhile it waits, the employee can create new actions but cannot remove existing ones.","subject":"%{collaborator} sent the IDP for your approval"},"validated":{"body":"\\u003cb\\u003e%{leader}\\u003c/b\\u003e validated the completion of your IDP. Its status is now \\u003cb\\u003eCompleted\\u003c/b\\u003e and it stays in your history.","cta":"See my IDP","next_step":"Whenever you want, create a new IDP.","subject":"the completion of your IDP was validated"}}},"main":"Main","maintenance":{"description":"Due to a scheduled maintenance, the platform will undergo instability and may be unavailable on Friday (August 6th) from 20:00 until Saturday (August 7th) at 12:00.","message":"We inform you that on 08/02/2022 we will carry out preventive maintenance in the period between 00:00h and 02:00h, where the platform may be unstable for a few minutes.","ok":"Got it!","site_message":"The platform is unavailable, we are performing maintenance. Return forecast: at 8 am on Sunday, 03/07.","title":"Attention"},"maintenance_access_profile":"Maintenance of access profiles","make_sure_file_extension_csv":"An error occurred while importing. Make sure the file extension is .csv","manage_events":"Events / Courses Management","manager":"Manager","manager_not_allowed":"Manager not allowed","manager_not_found":"Could not find the Manager with id: %{id}","manual_score":{"add_btn":"Add points","created_at":"Made in","made_by":"Person who made","messages":{"fail":{"create":"Failed to add points","permission":"I\'m sorry, your profile does not have the necessary permission!"},"success":{"create":"Total score"}},"scores_assigned":"Scores awarded","title":"Manual scoring"},"manufacturing_industry":"Manufac