            Combinaciones de color basadas en reglas matemáticas de la rueda cromática:

            Análoga: colores cercanos en la rueda (±30°)

            Monocromática: variaciones del mismo color

            Complementaria: colores opuestos (180°)

            Complementaria dividida: color base + 2 adyacentes al opuesto

            Triádica: 3 colores equidistantes (120°)

            Tetrádica: 4 colores equidistantes (90°)

            Personalizada: posicionamiento libre`,title:"Tipo de armonía",base:"Base",addColor:"Añadir color",removeColor:"Quitar color",lockTooltip:"Bloquear color (se mantiene al recalcular la armonía)",unlockTooltip:"Desbloquear color",types:{custom:"Personalizado",analogous:"Análoga",monochromatic:"Monocromática",triad:"Tríada",complementary:"Complementaria",splitComplementary:"Complementaria dividida",tetradic:"Tetrádica"},palette:{primary:"Primaria",secondary:"Secundaria",tertiary:"Terciaria",quaternary:"Cuaternaria",quinary:"Quinaria"}}},searchPlaceholder:"Pesquise por función de negocio o descripción",massActions:{vinculateCompetencies:{label:"Vincular competencias",fieldLabel:"Competencias",placeholder:"Seleccione las competencias para vincular a las funciones",toastTitle:"Competencias vinculadas a las funciones"},mergeItems:{label:"Fusionar funciones de negocio",fieldLabel:"Función de destino",placeholder:"Seleccione la función que recibirá los vínculos",descriptionLabel:"Descripción de la función seleccionada",descriptionEmpty:"La función seleccionada no tiene descripción",toastTitle:"Funciones de negocio fusionadas"},destroyItems:{label:"Eliminar funciones de negocio",toastTitle:"Funciones de negocio eliminadas"}},user_organization_chart_roles:{list:{columns:{first_name:"Nombre",email:"Correo electrónico",role:"Cargo",adherence:"Adherencia",readiness:"Preparación",interest_type:"Tipo",interest_type_tooltip:"Define cómo el usuario se relaciona con la función de negocio: Ejecutor ejecuta actividades, Sucesor está preparado para asumir, e Interesado sigue la función de negocio."},actions:{edit:"Editar",delete:"Eliminar",add:"Incluir"},itemLabel:"usuarios",messages:{delete:{confirmation:"Esta acción no se puede deshacer. ¿Está seguro de que desea eliminar el vínculo con este usuario?",success:"Usuario eliminado de la función de negocio con éxito"},updateInterestType:{success:"Tipo de interés actualizado con éxito"},add:{success:"Usuarios agregados a la función de negocio con éxito"}},search:{placeholder:"Buscar por nombre o correo electrónico"},drawer:{title:"Agregar personas",confirmButton:"Vincular",interestTypeLabel:"Tipo de interés",filters:{area:"Filtrar por área"},tabs:{people:"Personas",suggestions:"Sugerencias"},actions:{search_people:"Buscar personas"}}},interest_types:{executor:"Ejecutor",successor:"Sucesor",interested:"Interesado"},readiness:{ready_now:"Listo ahora",six_to_twelve:"6 a 12 meses",twelve_to_twenty_four:"12 a 24 meses",future:"Futuro"},messages:{index:{organization_chart_role_id_required:"El ID de la función de negocio es obligatorio",organization_chart_role_not_found:"Función de negocio no encontrada"},destroy:{success:"Usuario eliminado de la función de negocio con éxito",error:"Error al eliminar usuario de la función de negocio",not_found:"Relación no encontrada"},updateInterestType:{success:"Tipo de interés actualizado con éxito",error:"Error al actualizar tipo de interés"}}},competencies:{list:{columns:{name:"Nombre",description:"Descripción",type:"Tipo",classification:"Clasificación",importance_level:"Nivel de importancia",importance_level_tooltip:`Defina el nivel de importancia de esta competencia para la función de negocio:

Nivel 1: Nada importante
