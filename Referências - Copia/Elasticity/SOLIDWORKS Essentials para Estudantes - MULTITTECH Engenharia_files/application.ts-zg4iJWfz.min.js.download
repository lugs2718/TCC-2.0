aron"},peopleEngagement:{courseAccess:"Acceso al curso",contentConclusions:"Contenido Conclusiones"},paginator:{next:"Siguiente",previous:"Anterior"},print:{filters:{label:"Filtros aplicados",period:"Período",names:"Nombres",departments:"Área",enterprises:"Empresa",roles:"Cargo",progress:"Progreso",status:"Situación",all_students:"Todos los estudiantes",not_started:"No iniciados",started:"Iniciados",completed:"Completados",0:"Todos los alumnos",1:"Aprobados",2:"En progreso"}},...pi.es.translations}}},Aue={es:{translations:{modalNews:{modalTitle:"Noticias: la inteligencia artificial ha llegado a Twygo. Prueba la BETA",askLaterButton:"Recordarme después",understoodButton:"Ok, entendido"},learningPathV2LaunchDescription:{title:"Novedades: gestor de clase, instructor e indicadores del camino de aprendizaje",moreUpdatesComing:"¡Más actualizaciones de los caminos de aprendizaje en camino! Ahora, tanto los instructores como los gestores de clase pueden ser asignados a caminos de aprendizaje. Veamos qué pueden hacer:",instructor:"Instructor:",instructorImprovements:{studentsPerfomance:'Seguir el rendimiento de los participantes. ("Aprendizaje")',editLearningPath:'Agregar y editar contenidos del camino de aprendizaje. ("Actividades")'},classManager:"Gestor de clase:",classManagerImprovements:{subscribeStudents:"Inscribir usuarios en el camino de aprendizaje.",studentsPerfomance:'Seguir el rendimiento de los participantes que gestiona. ("Aprendizaje")'},dashboardProgressCertificate:'Además, los números de "certificados" y "progreso" en el tablero ahora incluyen datos de los caminos de aprendizaje. Mira el video a continuación para más detalles:'},learningPathLaunchDescription:{title:"Novedades: emisión de certificados en las rutas y cambios en el ambiente adicional",changes:"¡La ruta cambió! ¡Mira las mejoras!",improvements:{startDate:"Fecha de inicio y fin",certificates:"Certificados personalizados",newSpace:"Nuevo espacio para organizar las actividades de una ruta"},additionalEnvironments:"Ambientes adicionales",additionalEnvironmentsDescription:"¡Y no es solo eso! También mejoramos la forma en que gestionas y compartes contenidos con ambientes adicionales, para hacer que esta funcionalidad sea aún más fácil de usar!",checkOutVideo:"¡Mira todo esto en el video a continuación!"},newLogs:{modalTitle:"Novedades: Registros de cambios",boldText:"Ahora los usuarios y administradores tendrán acceso a los registros de las actividades que ocurren dentro de la plataforma.",normalText:"La funcionalidad de registro de cambios, que estaba en mantenimiento, ha vuelto. Podrás hacer un seguimiento de:",listItem1:"Cambios en perfiles de usuario",listItem2:"Actividades de acceso (inicio de sesión y cierre de sesión)",listItem3:"Cambios dentro de la organización",listItem4:"Cambios en las reglas del juego (gamificación)",listItem5:"Cambios en las reglas de comunicación (comunidades)"},sophIA:{normalText1:"Explora la BETA y descubre el poder de",normalText2:": tu asistente para crear contenido y cuestionarios mágicamente. ¡Queremos saber tu opinión durante la prueba! Su participación es esencial en el desarrollo de este nuevo producto.",normalText3:"NOTA. Al ser una función BETA no todo será perfecto, pero contamos con tu ayuda para mejorar aún más esta nueva característica."},newUserMassInactivation:{modalTitle:"Novedades: Desactivación Masiva",boldText:"¡Gestión de usuarios más fácil!",normalText:'Ahora puedes desactivar o activar usuarios en masa importando desde el menú "Usuarios".',checkOutVideo:"Consulta el video paso a paso a continuación:"},newApiV2:{title:"Novedades: Nueva API y indicadores avanzados con Power BI",normalText1:"Más datos e indicadores de tu entorno.",normalText2:"Presentamos una nueva API para leer los principales datos de la plataforma: usuarios, cuestionarios, certificados, cursos y mucho más.",normalText3:"Disfruta también de los indicadores directamente desde una plantilla lista para Power BI.",normalText4:"¡Mira todo esto en el video a continuación!"},newLearningPathOnPlay:{modalTitle:"Conoce Play: la facilidad del streaming, ahora en tu entorno y otras novedades",seeMoreVideo:"Consulta todo esto en el video a continuación:",playDescription:"Con Play, los usuarios tendrán acceso rápido y fácil al contenido, sugerencias personalizadas de cursos y senderos según sus intereses, así como una interfaz sencilla que muestra resúmenes, vistas previas y toda la información relevante sobre cursos y senderos directamente en la pantalla. Aprendizaje está a sólo un clic de distancia. Ahora disponible en tu entorno",more:{title:"Y además:",listItem1:{title:"Paquetes de registro: ",description:"Nueva función para inscribir a varias personas en el mismo curso."},listItem2:{title:"Registro por el CNPJ: ",description:'¡Las empresas ahora pueden registrar a sus empleados a través del CNPJ y usted puede seguirlos en el nuevo menú "Empresas"!'}}},twygoAcademyNotification:{modalTitle:"¡Nuevo canal de soporte y contenido sobre T&D para ti!",firstBlock:{emoji:"💡",tAndD:"Círculo T&D",normalText1:"¡hemos creado un espacio especial para la capacitación en Entrenamiento y Desarrollo!",normalText2:"En el",normalText3:", encontrarás todos nuestros seminarios web y podrás mejorar tus habilidades."},secondBlock:{title:"Acceder al nuevo entorno es simple: ",normalText1:"haz clic en “Administrador” en la esquina superior derecha > Haz clic en “Círculo T&D”."},thirdBlock:{title:"Soporte vía WhatsApp: ",normalText1:"para que nuestro servicio sea aún más rápido, hemos añadido soporte vía WhatsApp! Ahora nuestros canales oficiales de soporte son:",options:{email:"✉️ Correo electrónico: suporte@twygo.com",phone:"☎️ Teléfono: 0800 878 9638",whatsapp:"📱 WhatsApp: +55 47 3170-0642"}},fourthBlock:{title:"👀 Y hay más: ",normalText1:"Del 6 al 8 de agosto, tendremos la",tAndDConference:"Conferencia T&D 2024:",normalText2:"tres días de conferencias y debates sobre entrenamiento y desarrollo. ¡Aún estás a tiempo de inscribirte para ver en vivo o recibir la grabación!"}},accessTwygoAcademy:{modalTitle:"Conozca la Academia Twygo",textblock1:"📚 Academia Twygo: ¡su nuevo espacio para resolver dudas sobre la plataforma!",textblock2:"La Academia Twygo es un entorno exclusivo donde puede acceder a contenido para aclarar todas sus dudas sobre Twygo.",textblock3:{bold:"Para acceder a la Academia Twygo, no es necesario crear un nuevo inicio de sesión.",normal:'Simplemente acceda a su entorno > Haga clic en "Administrador" > Academia Twygo.'},textblock4:"🎥 Vea nuestro video explicativo para entender mejor."},faceliftAndCertificate:{modalTitle:"Algunas cosas son diferentes por aquí....",textblock1:"Rediseñamos algunas cosas para hacer tu día a día aún más fácil.",textblock2:{normal:"Tendrás más filtros, paneles, extracción simple de datos y acciones en masa en varias áreas:",bold:'"Contenidos", "Usuarios", "Cuestionarios", "Aprendizaje" y "Equipo".'},secondVideoTitle:"Nueva área de certificados",secondVideoDescription:"¡Gestionar y personalizar tus plantillas de certificados ahora es aún más fácil! Con la nueva área exclusiva, puedes personalizar tus certificados de forma práctica y organizada.",secondVideoDescription2:"¡Disfruta de las nuevas funcionalidades! 🚀",textblock3:"🎉 ¡Mira el video a continuación para ver todos los detalles!"},ecossystemEnvironments:{modalTitle:"Algunas cosas están diferentes por aquí....",textblock1:"¡Más claridad y control para quien comparte contenidos!",changes:{title:"El intercambio de contenidos ha sido mejorado para ofrecer más claridad y control. Vea lo que cambió:",listItem1:{part1:"🔄 Elija entre ",part2:'"Copia libre" ',part3:"o ",part4:'"Controlada" ',part5:"al compartir un contenido con otro entorno."},listItem2:{part1:"👁️ Visualice de forma clara ",part2:"en qué entornos el contenido está compartido."},listItem3:{part1:"🔐 Algunos campos ahora son ",part2:"editables o protegidos, ",part3:"dependiendo del formato de intercambio."},listItem4:{part1:"📊 Acompañe el uso de su plan y los entornos adicionales a través del área de ",part2:"Plan y suscripción."}},checkOutVideo:"¡Mire el video y vea en la práctica cómo aprovechar esta novedad:"},ecossystemEnvironments2:{modalTitle:"Novedad: Paquetes de contenidos",textblock1:"¡Más practicidad para organizar y compartir contenidos!",changes:{title:{part1:"Con los ",part2:"Paquetes de contenidos ",part3:"puedes crear agrupaciones personalizadas y también compartir con otros entornos."},whatChanged:"Ve lo que es posible hacer:",listItem1:{part1:"📦 Agrupa cursos y rutas en ",part2:"paquetes organizados."},listItem2:{part1:"🖼️ Personaliza banners ",part2:"exclusivos para los paquetes en Play."},listItem3:{part1:"🎯 Destaca paquetes con ",part2:"filtros, categorías y control de visibilidad: ",part3:"para inscritos, usuarios logueados, colaboradores o público general."},listItem4:{part1:"🔄 Comparte paquetes con otros entornos ",part2:'como "Copia libre" (independiente) o "Controlada" (mantiene las actualizaciones sincronizadas con el contenido original).'},checkOutVideo:"Consulta el paso a paso en el video a continuación:"}},novoVersoDoCertificado:{modalTitle:"Novedad: más flexibilidad y alcance para tus certificados",textblock1:"Más flexibilidad y recursos para dejar tus certificados con la cara de tu marca!",changes:{title:{part1:"Confira las principales novidades:"},listItem1:{part1:"🖼️ Imágenes personalizadas: ",part2:"agregue logos, sellos y elementos visuales libres."},listItem2:{part1:"🔁 Verso configurable: ",part2:"cree certificados frente y verso con facilidad e incluya automáticamente la lista de actividades en el reverso."},listItem3:{part1:"🧩 Más datos dinámicos: ",part2:"inserte campos como local, instructores, empresa, frecuencia y mucho más — todo actualizado automáticamente."},listItem4:{part1:"✍️ Editor de texto mejorado: ",part2:"personalice fuentes, listas y formato con libertad."},listItem5:{part1:"🔗 Compartir en LinkedIn: ",part2:"permita que los alumnos compartan certificados directamente en LinkedIn, aumentando la visibilidad de sus cursos y su marca."},checkOutVideo:"Mire el video y vea cómo aprovechar estas novedades:"}},publicLearningPath:{modalTitle:"Novedades para dejar tus rutas aún más completas",textblock1:"Más flexibilidad y control para crear experiencias de aprendizaje increíbles!",changes:{listItem1:{part1:"🌐 Páginas públicas y visualización ampliada: ",part2:"define si tus rutas serán visibles para colaboradores, usuarios logueados o visitantes — así como en los cursos"},listItem2:{part1:"💳 Venta de rutas con pago integrado: ",part2:"activa ventas directamente en la plataforma, con soporte para pagos parcelados y días de prueba"},listItem3:{part1:"📊 Relatórios y exportaciones mejorados: ",part2:"exporta datos completos de rutas y inscripciones, con nuevos filtros y campos para facilitar la análisis"},listItem4:{part1:"🔄 Importación y inscripciones en masa via API V2 ",part2:"gana eficiencia al crear, actualizar y gestionar rutas y inscripciones de forma automatizada"},checkOutVideo:"Mira el video y vea cómo aprovechar estas novidades:"}},useModeAndPlayFilters:{modalTitle:"Novedad: personaliza menús y crea filtros en Play",textblock1:"¡Más autonomía para organizar la experiencia de los alumnos!",changes:{title:{part1:"Ahora es posible personalizar los menús que se muestran en la vista de los alumnos y crear filtros personalizados en Play."},listItem1:{part1:"✏️ Edita el nombre, el ícono y el orden de los menús."},listItem2:{part1:"🔗 Crea menús con enlaces externos o que dirijan a otros entornos."},listItem3:{part1:"🎯 Arma un menú con el aspecto de Play, pero con filtros aplicados — ideal para destacar determinados contenidos."},listItem4:{part1:"🧠 ¡Administradores y alumnos ahora pueden crear y guardar sus propios filtros en Play!"},checkOutVideo:"Consulta el paso a paso en el video a continuación:",whatChanged:"Mira lo que cambió:"}},ssoAuthentication:{modalTitle:"Novedad: Autenticación SSO",textblock1:"Más seguridad y practicidad para el inicio de sesión de tus usuarios corporativos",changes:{title:{part1:"Ahora es posible autenticar usuarios corporativos vía SSO (Single Sign-On)."},listItem1:{part1:"🔐",part2:"Inicio de sesión unificado",part3:": tus usuarios acceden a Twygo usando las credenciales corporativas, sin necesidad de crear o recordar otra contraseña."},listItem2:{part1:"🧩",part2:"Integración con proveedores de identidad",part3:": compatible con",part4:"Microsoft Azure AD, Google Workspace, Okta",part5:"y otros proveedores SAML."},listItem3:{part1:"🛡️",part2:"Más control y seguridad",part3:": autenticación centralizada, sin redefiniciones de contraseña en Twygo."},importantNote:{part1:"💡",part2:"Importante",part3:": verifica si tu plan actual incluye la función de autenticación vía SSO."},checkOutVideo:"Consulta más detalles en el video a continuación:",whatChanged:"Ve lo que cambió:"}},fourFeaturesRelease:{modalTitle:"Cuatro novedades para facilitar tu día a día",items:{item1:{title:"Cambios visuales y carga horaria flexible",text:"La edición de contenidos se reorganizó en pestañas y ganó dos campos nuevos: Tipo de experiencia, la etiqueta por la cual tus usuarios reconocerán cada contenido, y Clasificación, que ayuda a segmentar y filtrar. La carga horaria ahora acepta horas, minutos y segundos, y el menú lateral puede recogerse para tener más espacio de pantalla."},item2:{title:"Horario de acceso y feriados",text:"Configura en el modo de uso los horarios en que cada equipo puede usar la plataforma, con intervalos por día de la semana y feriados aparte. Fuera del horario, tú eliges qué bloquear: el ambiente completo, todos los contenidos o solo los que marques."},item3:{title:"Marca de agua en videos y archivos",text:"Muestra el documento, correo electrónico, IP o ID de sesión de quien accede como marca de agua sobre videos y archivos, para inhibir grabaciones y comparticiones no autorizadas. Tú defines su color y tamaño y, en los videos, su posición y si queda fija o en movimiento."},item4:{title:"Registro y gestión de usuarios por la API 2.0",text:"Ahora la API 2.0 crea, actualiza, busca, activa, inactiva y elimina usuarios incluso varios a la vez. Si ya gestionas personas en otro sistema, este puede mantener Twygo actualizada automáticamente. Los detalles están en la documentación.",documentationButton:"Ver documentación"}}}}}},Pue={es:{translations:{ssign:{tab_title:"Firma de certificados",form:{sections:{account:"Datos de acceso a S-Sign",webhook:"Dirección de aviso"},labels:{serviceUrl:"Dirección de S-Sign",accessKey:"Clave de acceso",webhookAddress:"Dirección para recibir los avisos"},placeholders:{serviceUrl:"https://suempresa.satelitti.com.br",accessKey:"Pegue aquí la clave generada en su S-Sign",accessKeyConfigured:"Clave ya registrada. Escriba una nueva para reemplazarla"},tooltips:{serviceUrl:"Dirección de su S-Sign: el subdominio que Selbetti creó para su empresa, siempre con https",accessKey:"Genere la clave en su S-Sign, en Configuración > Integración > Clave, y péguela aquí",webhookAddress:"Copie esta dirección y péguela en la configuración de la integración dentro de S-Sign, para que recibamos el aviso cuando se firme un documento"},errors:{serviceUrlRequired:"Informe la dirección de S-Sign",serviceUrlMustBeHttps:"La dirección debe ser una URL https válida",accessKeyRequired:"Informe la clave de acceso",loadFailed:"No se pudo cargar la configuración de S-Sign",saveFailed:"No se pudo guardar la configuración de S-Sign"},messages:{saved:"Configuración de S-Sign guardada"}}},sso:{tab_title:"Autenticación SSO via SAML",form:{sections:{metadata:"Metadatos",settings:"Configuraciones",activation:"Activación"},placeholders:{domain:"Seleccione el dominio predeterminado"},labels:{certificate:"Certificado del IdP",sso_url:"URL del SSO",activate:"Activar SSO",hide_login_page:"Ocultar página de inicio de sesión",email_field:"Nombre del atributo del correo electrónico",domain:"Dominio",file_name:"Archivo"},tooltips:{activate:"Activar SSO",sso_url:"Ingrese aquí la URL proporcionada por su proveedor de identidad (IdP) a donde se dirigirá a los usuarios cuando inicien sesión a través de SSO.",certificate:"Pegue aquí el certificado proporcionado por su proveedor de identidad (IdP), necesario para validar la autenticación a través de SAML.",email_field:'Informe el nombre del atributo que su proveedor de identidad utiliza para enviar el correo electrónico del usuario (Ej.: "email", "user_email").',domain:"Seleccione el dominio predeterminado para la autenticación a través de SSO. La autenticación se habilitará en todos los dominios asociados a su organización.",hide_login_page:"Al habilitar, la pantalla de inicio de sesión de la plataforma no se mostrará y el acceso se redirigirá al proveedor SAML configurado."},errors:{invalidUrl:"URL inválida",domain_required:"El dominio es obligatorio"},success:{save:"Configuración de SSO guardada correctamente",metadata_generated:"Metadatos generados correctamente"},buttons:{generate:"Generar metadatos",generate_again:"Generar de nuevo",generating:"Generando..."}}},api_token:{tab_token_title:"Token",tab_title:"Clave API",add_label:"+ Agregar",you_want_continue:"¿Estás seguro de que quieres continuar?",token_copy_success:"Token copiado exitosamente",token_tooltip:"Un token es una clave única que se utiliza para identificar entornos en integraciones con otros entornos o con plataformas externas. Tenga cuidado al compartir con terceros.",modal_confirm_regenerate:"Confirmación para regenerar",modal_body_confirmation:"El token anterior ya no se puede utilizar. Esta acción no se puede deshacer. ¿Estás seguro de que quieres realizar?",confirm_button_title:"Regenerar",table:{name:"Nombre clave",user:"Usuario asociado",created_at:"Creado en",situation:"Situación"},tooltips:{user:"Este usuario se asociará con todos los registros bajo esta clave API, para facilitar la visualización del historial de registros creados.",copy_token:"Copiar clave",regenerate:"Regenerado",user_table:"El usuario al que se vincularán todos los registros generados por esta API",add:"Su clave API le brinda acceso completo para ver y modificar datos en Twygo. Accede a la documentación completa a través del enlace: https://bit.ly/twygo-api-v2"},form:{labels:{name:"Nombre",user:"Usuario asociado",token:"Clave API"},validations:{name:{required:"El nombre es obligatorio",max:"El nombre debe tener un máximo de 30 caracteres."}},title:"Clave API",back:"Volver",placeholders:{name:"Escribe un nombre que ayude a identificar la clave más adelante.",user:"Seleccione el usuario asociado"},updated_success:"Clave API actualizada correctamente",create_success:"Clave API creada correctamente",create_success_message:"Copiar para usar",save:"Ahorrar",cancel:"Cancelar"},confirmApiKeyDelete:{message:"Todas las consultas que utilicen esta clave API se detendrán. ¿Estas seguro que quieres borrarlo?",success:"Clave API eliminada exitosamente"},contractBlock:{title:"¡Vaya! Esta opción no está disponible en tu plan",message:"¡Cambia tus opciones de suscripción contactando a nuestro equipo!",button:"Contato"},creditBlock:{admin:{title:"Límite de créditos alcanzado",message:"Se utilizaron todos los créditos disponibles. Para continuar, contacta con soporte o espera la renovación.",button:"Contacto"},managerInstructor:{title:"Límite de créditos alcanzado",message:"Se utilizaron todos los créditos disponibles. Para continuar, contacta con el responsable del entorno o espera la renovación."},student:{title:"Acción no disponible en este momento",message:"No fue posible completar esta acción ahora. Contacta con el responsable del entorno para más información."}},status:{inactivate:"Inactivar",modal_title:"Confirmación de inactivación",modal_body:"Todas las consultas que utilicen esta clave API se detendrán."},regenerate:{success:"Nueva clave API generada con éxito",error:"Se produjo un error al regenerar la clave API",error_inactive:"No se puede regenerar una clave API inactiva",modal_title:"Confirmación para regenerar",modal_body:"Todas las consultas que utilicen esta clave API se detendrán y deberá reemplazar la nueva clave en los puntos de consulta.",button:"Regenerar",token_disabled_title:"No se puede regenerar una clave API inactiva",token_disabled_message:"Activar para regenerar"},inactivate:{success:"Clave API desactivada exitosamente",error:"Hubo un error al desactivar la clave API"},activate:{success:"Clave API activada exitosamente",error:"Hubo un error al activar la clave API"},copy_token:"Clave API copiada correctamente"}}}},Tue={es:{translations:{extract:{title:"Estado de uso de créditos de IA",title_history:"Historial de créditos",month_label:"Mes",previous_month:"Mes anterior",next_month:"Mes siguiente",columns:{date:"Fecha",origin:"Acción realizada",organization_name:"Nombre del ambiente",user:"Usuario",estimated_credits:"Créditos de IA",transaction_reason:"Operación",transaction_reason_tooltip:"Indica el tipo de registro (Paquete de créditos, Voucher, Bono o Consumo) y si representa un aumento de saldo (créditos añadidos) o una disminución (consumo).",credit_type:"Fuente",credit_type_tooltip:"Indica de qué cartera se debitó el consumo: primero se utilizan los créditos del paquete (plan) y, después, los créditos adicionales considerados como vouchers.",period_end_date:"Vencimiento"},total_final_balance:"Saldo final total",total_final_balance_tooltip:`Suma de todos los créditos disponibles (paquete de créditos + vouchers de créditos) para uso en las herramientas de IA.
