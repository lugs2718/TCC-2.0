rs":"Parceiros","pdi":"PDI","performance":"Desempenho","performance_development":"Desenvolvimento","performance_evaluations":"Avaliações a Preencher","performance_leader_dashboard":"Painel do Líder","plans":"Planos","plans_and_goals":"Planos e metas","play":"Catálogo de conteúdos","portfolio":"Portfólio","process_architecture":"Arquitetura de Processos","process_documentation":"Processos","process_portal":"Portal de processos","processes":"Processos","professional_profile":"Perfil Profissional","question_lists":"Questionário","recommended":"Recomendados","records":"Registros","reference_documents":"Documentos de Referência","research":"Pesquisas","reward_store":"Loja de prêmios","reward_store_categories":"Categorias","reward_store_overview":"Visão geral","reward_store_redemptions":"Resgates","reward_store_rewards":"Prêmios","reward_store_settings":"Configurações da loja","reward_store_wallet":"Moedas","roles":"Funções de negócio","running":"Em andamento","school_contents":"Conteúdos da Escola","settings":"Configurações","settings_ai":"Controle de IA","settings_appearance":"Aparência","settings_autopilot":"Piloto automático","settings_billing":"Cobrança de inscrição","settings_communication":"Comunicação","settings_game_rules":"Regras do Jogo","settings_integrations":"Integrações","settings_organization":"Organização","settings_panels":"Painéis","settings_plan":"Plano e assinatura","settings_profiles":"Perfis e permissões","settings_security":"Segurança","shared_events":"Compartilhamentos","signin":"Entrar","signup":"Cadastre-se","skills":"Skills","subscribe":"Inscritos","subscription":"Assinatura","succession_continuity":"Continuidade","succession_continuity_actions":"Ações de resposta","succession_continuity_analysis":"Análise individual","succession_continuity_dashboard":"Dashboard geral","succession_continuity_individual_analysis":"Análise individual","succession_continuity_parameters":"Parâmetros","succession_continuity_response_actions":"Ações de resposta","suggested_events":"Eventos Sugeridos","team":"Equipe","team_leader_feedback_log":"Feedback e anotações","team_leader_journey_agenda":"Agenda","team_leader_journey_executions":"Execuções","team_leader_journey_standard":"Jornada padrão","team_leader_journeys":"Jornadas","team_leader_management_group":"Gestão de time","team_leader_nine_box_view":"9-Box","team_leader_pdi":"PDI","team_leader_performance_development":"Desenvolvimento","team_leader_plans_and_goals":"Planos e metas","team_leader_succession":"Continuidade","team_leader_succession_actions":"Ações de resposta","team_leader_succession_analysis":"Análise individual","team_leader_succession_dashboard":"Dashboard geral","team_learning":"Aprendizagem","team_management_group":"Gestão de time","team_records":"Registros da equipe","team_training_effectiveness":"Eficácia de treinamentos","toggle_menu":"Expandir ou retrair menu","trail":"Minhas Trilhas","training_effectiveness":"Eficácia de treinamentos","user_panels":"Painéis do usuário","users":"Usuários","versions_history":"Histórico de versões","view_plans":"Veja nossos planos","visualize_documentation":"Visualizar documentação"},"menu_tag":"Menu","message_duplicate_record_email":"Usuário já se está associado na trilha: %{duplicate_record_email}","message_instructor":"Seu instrutor do curso %{event_name} lhe enviou uma mensagem:\\u003cbr/\\u003e","message_onboarding_step_1":"Para começar a usar, precisamos criar sua conta, por favor informe seus dados.","message_onboarding_step_2":"Estamos concluindo seu cadastro, agora precisamos dos dados da sua organização e pronto.","message_students":"Mensagem para o(s) aluno(s):","migration_partner_message":{"maintenance_notice":"\\u003cstrong\\u003eATENÇÃO:\\u003c/strong\\u003e A migração do seu ambiente adicional está programada para sexta, 26/06 a partir das \\u003cstrong\\u003e19h\\u003c/strong\\u003e! Seu ambiente ficará indisponível de \\u003cstrong\\u003esexta (26/06)\\u003c/strong\\u003e às \\u003cstrong\\u003e19h\\u003c/strong\\u003e até \\u003cstrong\\u003edomingo (28/06)\\u003c/strong\\u003e às \\u003cstrong\\u003e8h\\u003c/strong\\u003e. Algumas configurações não serão migradas, portanto é essencial verificar os detalhes.","maintenance_notice_fallback":"Aviso de manutenção programada: A plataforma ficará indisponível em data e horário a serem informados.","maintenance_notice_link_text":"Saber mais","maintenance_notice_modal":{"description":"Aqui você encontrará as informações, incluindo o que será migrado, os benefícios, o que não será transferido e orientações importantes para acompanhar o processo.","intro":"Realizaremos uma migração de dados no seu ambiente adicional no dia 26/06.","sections":[{"title":"O que está sendo migrado","items":["Cursos","Trilhas","Pacotes","Configurações gerais","Inscrições","Usuários","Engajamento","Aprendizagem (Progresso, Desempenho, Pontuação)","Certificados","Todas as demais configurações da plataforma"]},{"title":"Quais os benefícios da migração","items":["Possibilidade de compartilhar conteúdos entre seus ambientes escolhendo o formato de cópia livre ou cópia controlada","Possibilidade de criar conteúdos e questionários diretamente pelo ambiente adicional","Possibilidade de utilizar as nossas ferramentas de IA no ambiente adicional","Ambiente preparado para receber futuras atualizações da Twygo"]},{"title":"Por que a migração está sendo feita","items":["Novas funcionalidades estão chegando na Twygo","Ambientes antigos não receberão essas atualizações","Em breve, algumas funcionalidades antigas não terão mais atualizações, deixando o ambiente adicional defasado"]},{"title":"Mudanças","items":["Conteúdos que possuírem questionários com perguntas do tipo \\"Texto\\" ou \\"Arquivo\\" serão migrados para o ambiente adicional no modelo \\"Cópia livre\\". Ou seja, o conteúdo original permanecerá no ambiente principal com todo o seu histórico, e será realizada uma cópia do conteúdo para o ambiente adicional que agora poderá editá-lo por completo."]},{"title":"O que NÃO será migrado","items":["Se você utilizava a opção \\"Comunidades\\" no seu ambiente adicional, essas informações não serão migradas, portanto todas as notícias, discussões e interações deste menu não serão transferidas."],"note":"Porém, no novo ambiente, o uso dessa funcionalidade permanecerá disponível e você poderá criar novas comunidades normalmente."},{"title":"Orientações finais","items":["Esta migração é necessária para que seu ambiente esteja atualizado e compatível com todas as novas funcionalidades.","A migração de dados será realizada apenas no seu ambiente adicional, o ambiente principal não terá nenhuma alteração.","Caso tenha algum impedimento para a migração nesta data ou tenha dúvidas adicionais sobre o processo, entre em contato com a equipe de Suporte Twygo através do chat ou pelo e-mail suporte@twygo.com."]}]},"maintenance_notice_modal_title":"Migração do ambiente adicional – Twygo"},"min_length_json_error":"Forneça pelo menos 1 Aluno e 1 Conteúdo.","minimum_quantity_for_plan":"A quantidade mínima para este plano é ","minimum_term_for_plan":"O prazo mínimo para este plano é ","minimum_time_permanence":{"clock_title":"Tempo mínimo de permanência para concluir esse conteúdo.","modal_content":"Ao sair dessa tela o contador de tempo mínimo de permanência será zerado. Tem certeza que deseja sair?","modal_title":"O contador de tempo de permanência será zerado"},"missing_answer_information":"É necessária a marcação e/ou preenchimento de ao menos uma resposta","missing_email_and_password":"A solicitação deve conter o email e a senha do usuário.","missing_required_parameters":"Parâmetros obrigatórios ausentes: idioma e tipo de termo","model":{"event_contents":{"authenticationsucceeded_access_requested_resource_is_denied":"A autenticação foi bem sucedida, mas o acesso ao recurso solicitado é negado.","webinar_attendance_created_sucessfull":"Chamada criada com sucesso.","webinar_dont_populate_attendee":"Ocorreu um erro e não foi possível d