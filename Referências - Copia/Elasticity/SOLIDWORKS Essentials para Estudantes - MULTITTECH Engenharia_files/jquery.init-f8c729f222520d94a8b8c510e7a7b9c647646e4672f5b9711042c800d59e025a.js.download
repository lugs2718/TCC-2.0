                    width: this.$element[0].offsetWidth,
                    height: this.$element[0].offsetHeight
                });

                // Medida de contorno para tips #send_email_to_admin_tip
                // Por algums motivo esta perdendo a referência no offset
                if (pos.left == 0 && pos.top == 0) {
                    pos.top = $("#" + this.$element.prop("id")).offset().top
                    pos.left = $("#" + this.$element.prop("id")).offset().left
                    pos.width = $("#" + this.$element.prop("id")).get(0).offsetWidth
                    pos.height = $("#" + this.$element.prop("id")).get(0).offsetHeight
                }

                var actualWidth = $tip[0].offsetWidth,
                    actualHeight = $tip[0].offsetHeight,
                    gravity = maybeCall(this.options.gravity, this.$element[0]);

                var tp;
                switch (String(gravity).charAt(0)) {
                    case 'n':
                        // Ajuste de -60 para compensar deslocamento da window causado pelos componentes react
                        topChat = pos.top - 60

                        tp = {top: topChat + pos.height + this.options.offset, left: pos.left + pos.width / 2 - actualWidth / 2};
                        break;
                    case 's':
                        tp = {top: pos.top - actualHeight - this.options.offset, left: pos.left + pos.width / 2 - actualWidth / 2};
                        break;
                    case 'e':
                        tp = {top: pos.top + pos.height / 2 - actualHeight / 2, left: pos.left - actualWidth - this.options.offset};
                        break;
                    case 'w':
                        tp = {top: pos.top + pos.height / 2 - actualHeight / 2, left: pos.left + pos.width + this.options.offset};
                        break;
                    case 'z':
                        topChat = pos.top
                        tp = {top: topChat - pos.height - actualHeight * 2, left: pos.left - 200}
                        break;
                }

                if (String(gravity).length == 2) {
                    if (String(gravity).charAt(1) == 'w') {
                        if(this.options.artia_element == 'menu') {
                            tp.left = pos.left - 10;
                        } else {
                            tp.left = pos.left + pos.width / 2 - 15;
                        }
                    } else {
                        tp.left = pos.left + pos.width / 2 - actualWidth + 15;
                    }
                }

                $tip.css(tp).addClass('tipsy-' + gravity).addClass('tipsy-' + this.$element.attr("id"));

                $tip.find('.tipsy-arrow')[0].className = 'tipsy-arrow tipsy-arrow-' + String(gravity).charAt(0);
                if (this.options.className) {
                    $tip.addClass(maybeCall(this.options.className, this.$element[0]));
