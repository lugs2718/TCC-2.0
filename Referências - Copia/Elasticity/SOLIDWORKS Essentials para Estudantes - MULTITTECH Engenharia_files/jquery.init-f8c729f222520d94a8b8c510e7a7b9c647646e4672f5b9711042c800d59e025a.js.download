						for(var j = 0; j < sub_vals.length; j++){
							var v_data = {};
							v_data[opts.selectedValuesProp] = sub_vals[j].trim();
							if(sub_vals[j].trim() != ""){
								add_selected_item(v_data, "000" + i + j);
							}
						}
					}
					prefill_value = opts.preFill;
