							} else {
								var regx = new RegExp("(?!<[^<>]*)(" + query + ")(?![^<>]*>)", "g");
							}
							
							if(opts.resultsHighlight){
								this_data[opts.selectedItemProp] = this_data[opts.selectedItemProp].replace(regx,"<em>$1</em>");
							}
							if(!opts.formatList){
