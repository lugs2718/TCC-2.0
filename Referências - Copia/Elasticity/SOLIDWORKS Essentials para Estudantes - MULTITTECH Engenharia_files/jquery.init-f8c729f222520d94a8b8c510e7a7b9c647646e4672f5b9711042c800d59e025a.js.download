ration_completed":"Regerações concluídas — As regerações dos designs do modelo %{model_name} foram concluídas."},"import_agent":{"questionnaire_imported":"Questionário importado com sucesso!","questionnaire_imported_description":"Seu questionário foi importado e está pronto para visualização."},"migrations":{"historic_bank":"Aviso de manutenção agendada. Devido a melhorias na infraestrutura, podem ocorrer instabilidades entre sábado (10/05) às 22h e domingo (11/05) às 07h.","hubspot":"Estamos migrando nossa plataforma de suporte para proporcionar a melhor experiência possível para você! Caso perceba qualquer instabilidade durante esse processo, por favor, envie sua solicitação para suporte@twygo.com. Ah, e lembre-se: nosso time está disponível de segunda à sexta, durante o horário comercial. Estamos aqui para ajudar!","microservices":"Aviso de manutenção agendada. O chat ficará indisponível de sexta-feira (16/08/24) às 22 horas até sábado (17/08/24) às 08 horas para atualização de tecnologia.","mysql":"Manutenção agendada. A plataforma ficará indisponível de 09/02/2024 (sexta-feira) das 22:00 até 10/02/2024 (sábado) às 18:00 (horário de Brasília) para melhorias no nosso banco de dados.","rails_7":{"api":"Serviço indisponível devido à manutenção programada. Retorno do serviço em 25/07/2026 às 23:59 (-3 GTM).","login":"Não é possível realizar o login. Plataforma em manutenção programada. Retorno dos serviços em 25/07/2026 às 23:59 (-3 GTM).","main_notification":"Aviso de manutenção programada. A plataforma ficará indisponível no sábado (25/07/26) das 16:00 horas até às 23:59 horas, para a realização de melhorias, atualizações de segurança e otimização do sistema."},"scheduled_maintenance":"Aviso de manutenção programada. A plataforma ficará indisponível no sábado (25/07/26) das 16:00 horas até às 23:59 horas, para a realização de melhorias, atualizações de segurança e otimização do sistema."},"organization_chart_archives":{"processing":{"default_file_name":"o arquivo","error_content":"Não foi possível concluir a indexação do arquivo %{file_name}. Envie o arquivo novamente para tentar processar.","error_title":"Erro na indexação do documento","success_content":"O arquivo %{file_name} foi processado e está disponível com resumo gerado pela IA.","success_title":"Documento indexado com sucesso"}},"pdi":{"in_app":{"admin_acted":{"content":"%{admin} (administrador) atuou no PDI de %{colab}","title":"Admin atuou no PDI de %{colab}"},"aprovado":{"content":"Seu PDI do ciclo %{ciclo} foi aprovado","title":"PDI aprovado"},"aprovado_lider":{"content":"Você aprovou o PDI de %{colab}","title":"PDI aprovado"},"campaign_deadline_warning":{"content":"A campanha %{campaign} termina em %{end_date}. Confira se você tem ações em aberto ou atrasadas e atualize a situação delas.","title":"A campanha %{campaign} termina em 14 dias"},"campaign_started":{"create":{"content":"A campanha %{campaign} começou. Crie seu PDI até %{end_date}.","title":"Crie seu PDI"},"update":{"content":"A campanha %{campaign} começou. Atualize seu PDI, ou conclua e crie um novo, até %{end_date}.","title":"Atualize seu PDI"}},"cancelado":{"content":"%{actor} cancelou seu PDI. Ele não conta mais nos indicadores","title":"PDI cancelado"},"cancelado_lider":{"content":"Você cancelou o PDI de %{colab}","title":"PDI cancelado"},"concluido":{"content":"%{colab} concluiu o PDI e aguarda sua validação","title":"PDI aguardando sua validação"},"devolvido":{"content":"%{actor} devolveu seu PDI para ajustes","title":"PDI devolvido para ajustes"},"devolvido_lider":{"content":"Você devolveu o PDI de %{colab} para ajustes","title":"PDI devolvido para ajustes"},"nao_iniciado_lembrete":{"content":"%{actor} lembrou que você ainda não criou seu PDI. Acesse Desenvolvimento e comece o seu.","title":"Crie seu PDI"},"reaberto":{"content":"Seu PDI foi reaberto e voltou para Em andamento. Você pode editá-lo de novo","title":"PDI reaberto"},"reaberto_lider":{"content":"Você reabriu o PDI de %{colab}","title":"PDI reaberto"},"reativado":{"content":"Seu PDI foi reativado e voltou para Em andamento","title":"PDI reativado"},"reativado_lider":{"content":"Você reativou o PDI de %{colab}","title":"PDI reativado"},"reprovado":{"content":"%{actor} reprovou seu PDI","title":"PDI reprovado"},"reprovado_lider":{"content":"Você reprovou o PDI de %{colab}","title":"PDI reprovado"},"submetido":{"content":"%{colab} enviou um PDI para sua aprovação","title":"Novo PDI para aprovação"},"sugestao_criada":{"content":"Uma nova sugestão de conteúdo foi criada no seu PDI","title":"Nova sugestão no seu PDI"},"sugestao_pendente_7d":{"content":"Você tem uma sugestão pendente de decisão há mais de 7 dias","title":"Sugestão pendente no seu PDI"},"validado":{"content":"Seu PDI foi validado pelo seu líder de equipe e está concluído","title":"PDI concluído"},"validado_lider":{"content":"Você validou a conclusão do PDI de %{colab}","title":"PDI concluído"}}},"performance":{"in_app":{"actor_system":"Sistema","calibrate_team":{"content":"%{actor} pede que você avalie sua equipe na campanha %{campaign}.","title":"Avalie sua equipe"},"consensus_validation":{"disagreed":{"content":"%{collaborator} discordou do resultado do consenso de desempenho.","title":"Discordância do consenso"},"pending":{"content":"O consenso da sua avaliação de desempenho foi finalizado. Confira o resultado e registre se você concorda ou discorda.","title":"Conferência do consenso"}},"feedback_received":{"content":"%{actor} registrou um feedback para você. Acesse para visualizar.","title":"Você recebeu um feedback"},"indicate_led_pairs":{"content":"%{actor} pede que você indique os pares de avaliação dos seus liderados na campanha %{campaign}.","title":"Indique os pares dos seus liderados"},"init_performance":{"content":"%{actor} informa que o ciclo da campanha %{campaign} foi iniciado. Acompanhe o seu andamento.","title":"Ciclo de desempenho iniciado"},"manual_reminder":{"content":"Você ainda não respondeu a avaliação de %{evaluatee} na campanha %{campaign}. Prazo: %{due_date}.","self_content":"Você ainda não respondeu a sua autoavaliação na campanha %{campaign}. Prazo: %{due_date}.","title":"Lembrete de avaliação pendente"},"nine_box_model_recalculated":{"content":"Os ciclos em andamento que usavam o modelo \\"%{model}\\" foram recalculados com a escala nova. Quem foi movido à mão na calibração continua na caixa onde foi colocado.","title":"Recálculo do 9-box concluído"},"peer_performance":{"content":"%{actor} pede que você avalie seus pares na campanha %{campaign}.","title":"Avalie seus pares"},"subordinate_performance":{"content":"%{actor} pede que você avalie sua liderança na campanha %{campaign}.","title":"Avalie sua liderança"}}},"pop_up":{"login_monthly_limit":"Não foi possível prosseguir com o login, faça contato com o administrador do ambiente."},"question_list_ai_form":{"error_body":"Nosso time de suporte está disponível no chat para resolver isso com você.","error_title":"Ocorreu um erro na geração do seu questionário","success_body":"Acesse o questionário criado com base nas atividades que você selecionou","success_title":"Questionário gerado"},"screen_top":{"admin":{"active_users_limit":"O limite de usuários ativos foi atingido. Faça um upgrade para aumentar o limite da sua conta.","active_users_warning":"Seu plano atingiu 90% dos usuários ativos cadastrados. Faça um upgrade ou libere mais acessos inativando usuários.","logins_limit":"O limite de usuários com logins no mês foi atingido. Faça um upgrade para aumentar o limite de logins.","logins_warning":"De acordo com a média de acessos na sua organização, estimamos que seu plano ultrapassará o limite de logins no mês corrente. Contrate mais acessos para evitar o bloqueio de novos logins.","storage_limit":"O armazenamento atingiu 100%. Faça um upgrade do seu plano ou libere espaço apagando conteúdos não utilizados.","storage_limit_additional":"O armazenamento atingiu 100%. Entre em contato com o administrador do ambiente principal para fazer um upgrade ou libere mais espaço apagando conteúdos não utilizados.","storage_warning":"Seu plano atingiu 90% do espaço de armazenamento. Para evitar o bloqueio de upload de novos conteúdos, solicite mais armazenamento ou libere espaço apagando conteúdos não utilizados.","warning_clone_in_progress":"Seu ambiente está quase pronto! Em instantes, conteúdos e informações serão adicionados automaticamente para que você tenha uma experiência completa. Você pode continuar navegando enquanto isso.","warning_trial_days_left":"Você ainda tem %{days_left} dias para testar a Twygo. Para não perder os dados do seu teste e continuar usando a plataforma, faça contato com o nosso time comercial."},"clone":{"got_it":"Entendido"},"external":{"warning_clone_in_progress":"Seu ambiente está quase pronto! Em instantes, conteúdos e informações serão adicionados automaticamente para que você tenha uma experiência completa. Você pode continuar navegando enquanto isso."},"external_user":{"active_users_limit":"Não foi possível prosseguir com o cadastro, faça contato com o administrador da organização."},"instructor":{"storage_limit":"O armazenamento atingiu 100%, entre em contato com o administrador da organização.","storage_limit_additional":"O armazenamento atingiu 100%. Entre em contato com o administrador para fazer um upgrade ou libere mais espaço apagando conteúdos não utilizados."},"manager_class":{"active_users_limit":"O limite de usuários foi atingido. Entre em contato com o administrador da organização.","active_users_limit_additional_environment":"O limite de usuários foi atingido. Entre em contato com o administrador do ambiente."}},"studio_copilot":{"activity_not_generated":"A atividade \\"%{activity}\\" não foi gerada. Tente novamente.","generation_failed_generic":"A geração com IA foi interrompida por uma falha. Tente novamente.","generation_failed_title":"Falha na geração com IA","slides_failed_title":"Falha na geração de slides","template_design_without_content":"A atividade \\"%{activity}\\" não foi gerada: o design do modelo \\"%{template}\\" não tem conteúdo.","template_without_designs":"O modelo \\"%{template}\\" não possui nenhum design de aula ou página."}},"notify_certificate":"Notificar Certificação","number":{"currency":{"format":{"delimiter":".","format":"%u %n","precision":2,"separator":",","significant":false,"strip_insignificant_zeros":false,"unit":"R$"}},"format":{"delimiter":".","precision":3,"round_mode":"default","separator":",","significant":false,"strip_insignificant_zeros":false},"human":{"decimal_units":{"format":"%n %u","units":{"billion":"Billion","million":"Million","quadrillion":"Quadrillion","thousand":"mil","trillion":"Trillion","unit":""}},"format":{"delimiter":".","precision":2,"significant":true,"strip_insignificant_zeros":true},"storage_units":{"format":"%n %u","units":{"byte":{"one":"Byte","other":"Bytes"},"eb":"EB","gb":"GB","kb":"KB","mb":"MB","pb":"PB","tb":"TB"}}},"percentage":{"format":{"delimiter":".","format":"%n%"}},"precision":{"format":{"delimiter":"."}}},"number_registered_is_greater":"Número de inscrições informadas é maior que o limite (%{limit}).","oauth":{"complete_to_register":"Complete suas informações para finalizar seu cadastro."},"obs":"Observações","oi_paggo":"Oi Paggo","on_off_lights":"Apagar/Acender as luzes","on_topics_found_by":"Nenhum tópico encontrado para a busca por","onboarding":{"email_invalid":"E-mail já cadastrado","step_01":{"description":"\\u003cp\\u003ePara começar a usar a Twygo, precisamos criar uma organização.\\u003c/p\\u003e \\u003cp\\u003eNela você poderá oferecer cursos personalizados para os seus alunos.\\u003c/p\\u003e","name":"Seu nome","name_placeholder":"Nome completo","organization_name":"Nome da sua organização","organization_url":"URL na Twygo","organization_url_tip":"Sem espaço em branco ou caracter especial"},"step_02":{"organization_phone":"Telefone","organization_phone_placeholder":"(99) 9 9999-9999","organization_site":"Site","organization_site_placeholder":"http://seudominio.com","organization_users":"Número de alunos","user_email":"E-mail","user_email_placeholder":"nome@seudominio.com"},"step_03":{"confirm_password":"Confirma Senha","description":"\\u003cp\\u003eEstamos concluindo seu cadastro, por favor informe uma senha.\\u003cbr\\u003e\\u003csmall\\u003e* Mínimo 6 caracteres\\u003c/small\\u003e\\u003c/p\\u003e","password":"Senha"},"step_04":{"default_color_infor":"* Botões de Ações, icones de menu e seleções","default_color_text_infor":"* Texto do sistema","description":"\\u003cp\\u003eVocê pode personalizar as cores e a logo da sua página. Mais tarde, você pode customizar outras partes do produto!\\u003c/p\\u003e","logo_infor":"* PNG, JPG ou GIF\\u003cbr\\u003e ** Maxima de 60px de altura","organization_name":"Vamos lá, deixe a Twygo com a cara da {{name}}"},"welcome":"Bem vindo à Twygo!","welcome_mobile":"Bem vindo ao"},"online_debit":"Débito online (TEF)","open_public_chat_content":"Abrir chat público do conteúdo","order_number":"NÂº Ordem","ordering_of_question":"Ordenação da Questão","org_clone":{"coverage_entities":{"assessments_competency":"Avaliações de competência","assessments_performance":"Avaliações de desempenho","assessments_total":"Avaliações (total)","box_placements":"Posicionamentos nine-box","campaigns":"Campanhas","communities":"Comunidades","cycles":"Ciclos","journey_tasks":"Tarefas de jornada","journeys":"Jornadas","organization_chart_competencies":"Competências do organograma","organization_chart_roles":"Funções do organograma","organization_goals":"Metas (PDI)","performance_entries":"Feedbacks","reward_store_categories":"Categorias da loja de prêmios","reward_store_rewards":"Prêmios da loja","users":"Usuários"},"create":{"enqueued":"Clone de %{organization} enfileirado. Acompanhe o status no histórico."},"delete":{"button":"Excluir organização","confirm":"Excluir a organização clonada? Isso dispara a exclusão da organização (não é hard-delete).","enqueued":"Exclusão disparada — a organização clonada será excluída.","not_deletable":"Não é possível excluir (clone em andamento, sem organização destino, ou já excluído)."},"errors":{"demo_access_into_existing_target":"Acesso de demonstração não é aplicável quando o destino é uma organização existente: o clone não redefine a senha de um usuário real do destino. Limpe o e-mail e a senha do acesso de demonstração ou deixe o ID da organização destino em branco.","destination_invalid":"Organização destino inválida (não existe ou é igual à origem).","domain_creation_failed":"Não foi possível criar o domínio padrão após %{attempts} tentativas: %{reason}","domain_failure_unknown":"save retornou false sem mensagem de erro","feature_disabled":"O clone de organização não está habilitado para esta organização.","generic":"Ocorreu um erro ao processar o clone.","organization_required":"Informe um ID de organização origem válido.","target_busy_timeout":"Destino ocupado por outro clone além do tempo limite de espera."},"form":{"contract_plan":"Contrato (plano) da organização clonada","contract_plan_blank":"Sem contrato (clonar sem plano)","contract_plan_hint":"Plano usado para criar o contrato da nova organização (ativo, mensal, com créditos do plano). Opcional.","demo_user_email":"Acesso de demonstração (e-mail do usuário na origem)","demo_user_email_hint":"E-mail de um usuário da organização origem que virará o acesso de demonstração. O login exibido no detalhe do clone é o e-mail que esse usuário tem NO DESTINO: com Anonimização ligada, o e-mail anonimizado; com ela desligada, o e-mail real da pessoa. Em branco = sem acesso de demonstração.","demo_user_password":"Senha do acesso de demonstração","demo_user_password_hint":"Senha a definir para esse usuário na organização clonada. Em branco = o sistema gera uma senha e mostra no detalhe do clone.","modules_hint":"Marque os subsistemas a copiar. Desmarcar não derruba o clone — só não copia esse item, e a cobertura dele é ignorada no status. Atenção: vários dependem de Usuários (sem eles, perfis/avaliações/PDI etc. vêm vazios).","modules_title":"O que clonar","origin_organization_id":"ID da organização origem","origin_organization_id_hint":"Informe o ID numérico da organização que será clonada.","overwrite_existing":"Sobrescrever o que já existe no destino","overwrite_existing_hint":"Só vale quando o destino é uma org existente. Desmarcado (padrão) = mantém o que o destino já tem. Marcado = sobrescreve identidade/config/DHO com os dados da origem. Conteúdo nunca é duplicado.","preserved_user_email":"Usuário a preservar no randomize (e-mail)","preserved_user_email_hint":"E-mail de um usuário da organização origem que NÃO será anonimizado, para conseguir logar na org clonada. Em branco = preserva quem disparou o clone.","randomize":"Anonimizar dados (randomize)","randomize_hint":"Quando marcado, nomes e e-mails dos usuários copiados serão anonimizados.","submit":"Iniciar clone","subtitle":"Cria uma cópia completa de uma organização em nova organização destino.","target_name":"Nome da organização destino","target_name_hint":"Nome que será dado à nova organização criada.","target_organization_id":"ID da organização destino (existente)","target_organization_id_hint":"Em branco = cria uma organização nova (padrão). Preenchido = clona PARA DENTRO dessa organização existente (atualiza/mescla).","title":"Novo clone de organização"},"inactivate":{"button":"Inativar organização","confirm":"Inativar a organização clonada? Ela continua existindo, mas fica inativa/inacessível.","done":"Organização clonada inativada.","not_inactivatable":"Não é possível inativar (clone em andamento, sem organização destino, ou já excluído).","target_missing":"A organização destino deste clone não existe mais."},"index":{"actions_menu":"Ações","active_banner":{"one":"%{count} clone em andamento","other":"%{count} clones em andamento"},"auto_refresh_note":"Atualiza automaticamente a cada 5 segundos","column_created_at":"Data","column_duration":"Duração","column_origin":"Organização origem","column_status":"Status","column_target":"Organização destino","column_triggered_by":"Disparado por","empty":"Nenhum clone executado ainda.","empty_async":"O clone de organização roda em segundo plano (fila Sidekiq). Assim que você disparar um, ele aparece aqui imediatamente — não é preciso aguardar terminar para vê-lo. Cada execução passa pelos status abaixo:","empty_detail_hint":"Clique em \\"Ver detalhes\\" em qualquer execução para acompanhar a cobertura por entidade e o relatório por módulo.","empty_stuck_body":"Se uma execução ficar parada na fila por muito tempo, a fila do Sidekiq pode não estar sendo consumida. Verifique se os workers do Sidekiq estão ativos.","empty_stuck_title":"Travou em \\"Na fila\\"?","legend":{"completed":"finalizado com sucesso, sem alertas.","degraded":"finalizado, mas alguns itens foram pulados ou falharam — confira o detalhe.","failed":"interrompido por erro — veja a mensagem no detalhe.","queued":"aguardando na fila — um worker do Sidekiq ainda vai pegar o job.","running":"em execução agora — copiando dados da origem para o destino."},"new_button":"Novo clone","pagination_summary":"Exibindo %{shown} de %{total}","polling_hint":"Há execuções na fila ou em andamento. Esta página atualiza automaticamente a cada 5 segundos.","refresh_button":"Atualizar","show_link":"Ver detalhes","subtitle":"Histórico de clones executados via sys admin.","title":"Clones de Organização"},"menu":{"index":"Clones de Organização"},"modules":{"access_profiles":"Permissionamento (perfis e administradores)","assessments":"Avaliações (competência e desempenho)","box_placements":"Nine Box","branding":"Identidade visual (logo, cores e imagens)","certificates":"Certificado (template e configuração)","communities":"Comunidades internas (participantes e regras de entrada automática)","companies":"Empresas (com endereços)","competency_events":"Eventos de competência","content":"Conteúdo de aprendizagem (cursos, trilhas, comunidades)","cycles_campaigns":"Ciclos e campanhas","feature_flags":"Feature flags (Flipper)","gamification":"Gamificação (troféus e configurações)","journeys":"Jornadas (fases, tarefas, equipe e execuções)","nine_box_models":"Modelos de 9-box","org_config":"Configuração da org (campos, página, tags)","orgchart":"Organograma (funções e competências)","pdi":"PDI (metas)","performance_entries":"Feedbacks","question_lists":"Listas de questões","reward_store":"Loja de prêmios (moeda, catálogo, carteiras e resgates)","succession":"Sucessão","use_modes":"Modo de uso (menus)","user_assignments":"Atribuições de usuário","users":"Usuários"},"recover":{"cannot_revert":"Nada para reverter (este clone não chegou a criar organização).","help":"O clone falhou no meio. Você pode manter a organização parcial e continuar de onde parou (só completa o que faltou), ou reverter (excluir a organização criada). Atenção: ao retomar um clone randomizado, o usuário preservado volta ao padrão (quem disparou o clone).","not_recoverable":"Só é possível recuperar um clone que falhou.","resume_button":"Manter organização e continuar","resume_confirm":"Continuar o clone reusando a organização já criada?","resume_enqueued":"Clone re-enfileirado — vai continuar de onde parou.","revert_button":"Reverter (excluir organização)","revert_confirm":"Excluir a organização parcial criada por este clone? Isso dispara a exclusão da organização.","revert_enqueued":"Reversão disparada — a organização criada será excluída.","title":"Recuperação"},"report_modules":{"access_profiles":"Permissionamento (perfis e administradores)","assessments":"Avaliações","box_placements":"Posicionamentos nine-box","branding":"Identidade visual","certificates":"Certificado","communities":"Comunidades","companies":"Empresas","competency_events":"Eventos de competência","content":"Conteúdo de aprendizagem","cycles_campaigns":"Ciclos e campanhas","demo_access":"Acesso de demonstração","feature_flags":"Feature flags (Flipper)","gamification":"Gamificação","journeys":"Jornadas","nine_box_models":"Modelos de 9-box","org_config":"Configuração da org","orgchart":"Organograma","pdi":"PDIs","performance_entries":"Feedbacks","question_lists":"Listas de questões","reward_store":"Loja de prêmios","succession":"Sucessões","user_assignments":"Atribuições de usuário"},"show":{"contract_plan":"Contrato (plano):","coverage_entity":"Entidade","coverage_origin":"Origem","coverage_pct":"Cobertura","coverage_target":"Destino","coverage_title":"Cobertura por entidade","created_at":"Iniciado em","demo_access_help":"Use estas credenciais para entrar na organização clonada. A senha foi definida por este clone e vale apenas nesta organização — ela não altera a senha do usuário na organização de origem.","demo_access_login":"Login (e-mail no destino):","demo_access_origin_email":"Usuário escolhido na origem:","demo_access_password":"Senha:","demo_access_title":"Acesso de demonstração","edit_plan_button":"Editar plano","failed_title":"O clone falhou.","false":"Não","mailer_block_note":"Envio de e-mail BLOQUEADO nesta organização clonada: os usuários copiados são pessoas reais e receberiam e-mail de boas-vindas com senha. Para liberar quando o ambiente for usado de verdade, desative o bloqueio nas configurações da organização.","mirror_note":"Cursos do tipo espelho (compartilhados de outra organização) não são clonados — eles pertencem à organização de origem do compartilhamento e são somente leitura. Alertas relacionados a esses cursos são esperados e não indicam falha no clone.","no_contract_plan":"(sem contrato — nenhum plano selecionado)","no_domain":"(sem domínio — org não acessível por link ainda)","origin_organization":"Organização origem","polling_hint":"A página atualiza automaticamente a cada 5 segundos enquanto o clone está em andamento.","randomize":"Anonimização","report_copied":"Copiados","report_failed":"Falhas","report_more":"... e mais %{count} itens","report_skipped":"Pulados","report_title":"Relatório por módulo","status":"Status:","target_organization":"Organização destino","title":"Detalhes do clone","triggered_by":"Disparado por","true":"Sim"},"statuses":{"completed":"Concluído","degraded":"Concluído com alertas","failed":"Falhou","queued":"Na fila","reverted":"Revertido","running":"Em andamento"}},"organization":{"consumer_type":{"external":"Externo","internal":"Interno"}},"organization_access":{"blocked_message":"A plataforma está temporariamente indisponível. Previsão de retorno: %{return_weekday} às %{return_time}.","blocked_message_fallback":"A plataforma está temporariamente indisponível. Previsão de retorno a ser informada."},"organization_activation_inactivation":"Inativar?","organization_activation_inactivation_explication":"Informe o ID da organização no campo acima para ver seu status.","organization_chart_archive_types":{"messages":{"index":{"organization_missing":"Organização não encontrada.","success":"Tipos de documento carregados com sucesso."}}},"organization_chart_archives":{"actions":{"delete":"Excluir documento","download":"Baixar documento"},"list":{"fields":{"name":"Nome","situation":"Situação","size":"Tamanho","summary":"Resumo","type":"Tipo","uploadDate":"Data de envio"}},"messages":{"createType":{"error":"Não foi possível criar o tipo do documento.","name_required":"O nome do tipo de documento é obrigatório.","organization_missing":"Organização não encontrada.","success":"Tipo de documento criado com sucesso."},"delete":{"cannot_delete_in_processing":"O documento está em processamento e não pode ser excluído.","error":"Não foi possível excluir o documento.","not_found":"Documento não encontrado.","success":"Documento excluído com sucesso."},"download":{"archive_not_found":"Arquivo não encontrado.","error":"Não foi possível baixar o documento. Tente novamente.","file_not_found":"Arquivo não disponível para download."},"updateType":{"error":"Não foi possível atualizar o tipo do documento.","not_found":"Tipo de documento não encont