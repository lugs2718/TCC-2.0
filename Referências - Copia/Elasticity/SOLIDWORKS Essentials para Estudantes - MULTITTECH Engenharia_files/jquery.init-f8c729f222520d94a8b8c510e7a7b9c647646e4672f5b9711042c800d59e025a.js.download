untas","live":"Ao vivo","loading_video":"Carregando o vídeo...","locale_en":"Inglês","locale_es":"Espanhol","locale_pt-BR":"Português","locate_yourself":"Localize-se:","location":"Localização:","loggable":{"deleted_object":"Este registro foi excluído da base da empresa."},"logged_out_in":"Será deslogado em","logger":{"not_found":"Nenhum log resgistrado"},"login":"Login","login_access":"Já se cadastrou na Twygo ?","login_access_button":"Faça login em vez disso","login_fail_with_integration":"Você não possuí uma conta integrada com esse serviço, selecione a opção de cadastro.","login_users_limit":{"logins_limit_reached":"Não foi possível prosseguir com o login, faça contato com o administrador do ambiente."},"logistics":"Logística","logout":"Logout","logout_not_within_list_ip":"O seu IP não está dentro da lista permitida pela organização","logs":{"action":"Ação","actions":{"activate":"Ativação","add_comment":"Adicionar comentário","approval":"Aprovação automática pelo curso","approve":"Aprovação pelo administrador","cancel":"Cancelamento","cancel_approval":"Revogação da aprovação","complete":"Completar conteúdo","create":"Criação","delete":"Exclusão","destroy":"Exclusão","generate_certificate":"Administrador gerou o certificado","inactivate":"Inativação","incomplete":"Marcou o conteúdo como incompleto","index":"Acessar a página de aprender","reboot":"Reiniciar o curso","request_certificate":"Certificado gerado automaticamente","rm_comment":"Remover comentário","save_attempt":"Encerrar o questionário","select_questions":"Responder questionário","show":"Visualizar conteúdo","update":"Atualização"},"created_at_end":"Data de término","created_at_start":"Data de início","not_found":"Nenhum resultado encontrado.","sort_asc":"Crescente","sort_by":"Ordenar por","sort_desc":"Decrescente"},"mail_description":"Para você completar o seu cadastro e ter acesso a um mundo de eventos por favor, confirme o seu e-mail no link abaixo:","mail_description_password_recover":"Digite seu e-mail no campo abaixo para iniciar o processo de validação dos seus dados e recuperação de senha.","mailer":{"notification_description":"O seu relatório foi gerado, clique no botão abaixo para baixar","notification_header":"Central de Notificações","notification_label":"Baixar: ","user_suspicious_use":{"admin_action_message":"Se você reconhecer essa atividade como legítima, é possível reativar a conta diretamente pela lista de usuários do ambiente.\\u003cbr\\u003eVocê também pode entrar em contato com o nosso time de suporte para mais informações.","admin_ip_label":"IP identificado","admin_main_message":"Identificamos uma atividade incomum na conta do usuário \\u003cstrong\\u003e%{user_name}\\u003c/strong\\u003e, e por medidas de segurança ele foi \\u003cstrong\\u003eautomaticamente inativado\\u003c/strong\\u003e.","admin_subject":"%{organization_name} - Usuário inativado por atividade suspeita","admin_user_cpf_label":"CPF","admin_user_email_label":"E-mail","admin_user_id_label":"ID","admin_user_info_title":"Informações do usuário","admin_user_name_label":"Nome","admin_welcome":"Olá, %{user_name}","contact_message":"Para solicitar mais informações ou a reativação da sua conta, entre em contato com o administrador do ambiente.","detected_action_label":"Ação detectada","environment_label":"Ambiente","ip_label":"IP","main_message":"Detectamos uma atividade suspeita em sua conta e por questões de segurança ela foi \\u003cstrong\\u003etemporariamente inativada\\u003c/strong\\u003e.","registered_info_title":"Informações registradas","user_subject":"%{organization_name} - Conta temporariamente inativada por segurança","user_welcome":"Olá, %{user_name}"}},"mailers":{"pdi":{"approved":{"body":"\\u003cb\\u003e%{leader}\\u003c/b\\u003e aprovou o seu PDI. A situação agora é \\u003cb\\u003eEm andamento\\u003c/b\\u003e.","cta":"Abrir meu PDI","next_step":"Registre o progresso das ações conforme avança. Se criar uma ação nova, ela volta para aprovação.","subject":"seu PDI foi aprovado"},"campaign_context":"Campanha \\u003cb\\u003e%{campaign}\\u003c/b\\u003e · prazo até \\u003cb\\u003e%{end_date}\\u003c/b\\u003e","campaign_notice":{"create":{"body":"A campanha \\u003cb\\u003e%{campaign}\\u003c/b\\u003e começou e você ainda não tem um PDI em aberto.\\u003cbr\\u003e\\u003cbr\\u003eCrie o seu até \\u003cb\\u003e%{end_date}\\u003c/b\\u003e e envie para aprovação. Essa tarefa também aparece no seu painel.","cta":"Criar meu PDI","subject":"PDI · %{campaign}: crie seu PDI até %{end_date}"},"deadline_warning":{"body":"A campanha \\u003cb\\u003e%{campaign}\\u003c/b\\u003e termina em \\u003cb\\u003e%{end_date}\\u003c/b\\u003e.\\u003cbr\\u003e\\u003cbr\\u003eConfira se você tem ações em aberto ou atrasadas e atualize a situação delas. Se já concluiu tudo, conclua o PDI e envie para validação.","cta":"Revisar meu PDI","subject":"PDI · %{campaign}: a campanha termina em 14 dias"},"update":{"body":"A campanha \\u003cb\\u003e%{campaign}\\u003c/b\\u003e começou. Você tem um PDI em aberto: \\u003cb\\u003e%{pdi_title}\\u003c/b\\u003e (situação: \\u003cb\\u003e%{pdi_status}\\u003c/b\\u003e).\\u003cbr\\u003e\\u003cbr\\u003eAté \\u003cb\\u003e%{end_date}\\u003c/b\\u003e, revise e atualize as ações, ou conclua esse PDI e crie um novo. Essa tarefa também aparece no seu painel.","cta":"Abrir meu PDI","subject":"PDI · %{campaign}: atualize seu PDI até %{end_date}"}},"completed":{"body":"\\u003cb\\u003e%{collaborator}\\u003c/b\\u003e concluiu o PDI com \\u003cb\\u003e%{progress} das ações concluídas\\u003c/b\\u003e e aguarda a sua \\u003cb\\u003evalidação\\u003c/b\\u003e.","cta":"Validar conclusão","message_label":"Comentário","next_step":"Valide a conclusão ou reabra o PDI com uma justificativa para o colaborador continuar.","subject":"%{collaborator} concluiu o PDI e aguarda sua validação"},"greeting":"Olá, %{name}.","rejected":{"body":"\\u003cb\\u003e%{leader}\\u003c/b\\u003e \\u003cb\\u003ereprovou\\u003c/b\\u003e o seu PDI.","cta":"Ajustar meu PDI","message_label":"Justificativa","next_step":"Você pode editar o PDI e enviá-lo de novo para aprovação.","subject":"seu PDI foi reprovado"},"reopened":{"body":"O seu PDI foi \\u003cb\\u003ereaberto\\u003c/b\\u003e por \\u003cb\\u003e%{who}\\u003c/b\\u003e e voltou para \\u003cb\\u003eEm andamento\\u003c/b\\u003e.","cta":"Abrir meu PDI","message_label":"Justificativa","next_step":"Você já pode editar as ações de novo.","subject":"seu PDI foi reaberto"},"returned":{"body":"\\u003cb\\u003e%{leader}\\u003c/b\\u003e devolveu o seu PDI para \\u003cb\\u003eajuste\\u003c/b\\u003e.","cta":"Ajustar meu PDI","message_label":"Comentário","next_step":"Faça os ajustes e envie o PDI de novo para aprovação.","subject":"seu PDI foi devolvido para ajuste"},"subject_prefix":{"with_campaign":"PDI · %{campaign}: %{subject}","without_campaign":"PDI: %{subject}"},"submitted":{"body":"\\u003cb\\u003e%{collaborator}\\u003c/b\\u003e enviou o PDI para a sua \\u003cb\\u003eaprovação\\u003c/b\\u003e.","cta":"Analisar PDI","next_step":"Revise as ações e escolha uma opção: \\u003cb\\u003eaprovar\\u003c/b\\u003e, \\u003cb\\u003edevolver para ajuste\\u003c/b\\u003e ou \\u003cb\\u003ereprovar com justificativa\\u003c/b\\u003e.\\u003cbr\\u003e\\u003cbr\\u003eEnquanto aguarda, o colaborador pode criar novas ações, mas não pode remover as existentes.","subject":"%{collaborator} enviou o PDI para sua aprovação"},"validated":{"body":"\\u003cb\\u003e%{leader}\\u003c/b\\u003e validou a conclusão do seu PDI. A situação agora é \\u003cb\\u003eConcluído\\u003c/b\\u003e e ele fica no seu histórico.","cta":"Ver meu PDI","next_step":"Quando quiser, crie um novo PDI.","subject":"a conclusão do seu PDI foi validada"}}},"main":"Principal","maintenance":{"description":"Devido a uma manutenção programada, a plataforma passará por instabilidades, podendo ficar indisponível na sexta-feira (dia 06 de Agosto) a partir das 20h, até o sábado (dia 07 de Agosto) às 12h.","message":"Informamos que no dia 02/08/2022 iremos realizar uma manutenção preventiva no período entre 00:00h e 02:00h, onde a plataforma poderá ficar instável por alguns minutos.","ok":"Entendi!","site_message":"A plataforma está indisponível, estamos realizando uma manutenção. Previsão de retorno: às 8h da manhã de domingo, dia 03/07.","title":"Atenção"},"maintenance_access_profile":"Manutenção de perfis de acesso","make_sure_file_extension_csv":"Ocorreu um erro ao importar. Verifique se a extensão do arquivo é .csv","manage_events":"Gerenciar Cursos","manager":"Gerente","manager_not_allowed":"Gestor não permitido","manager_not_found":"Não foi possivel encontrar o Gestor de id: %{id}","manual_score":{"add_btn":"Adicionar pontuação","created_at":"Feito em","made_by":"Pessoa que efetuou","messages":{"fail":{"create":"Falhou ao adicionar os pontos","permission":"Sinto muito, seu perfil não tem a permissão necessária!"},"success":{"create":"Pontuação somada"}},"scores_assigned":"Pontuações atribuídas","title":"Pontuação manual"},"manufacturing_industry":"Manufatura / Indústria","mark_as_approved_if":"Aprovar aluno se:","mark_as_paid":"Marcar como Pago","mark_as_refunded":"Marcar como reembolsado","marketing_communication_advertising":"Marketing, Comunicação e Publicidade","mass_action_being_processed":"Ação em massa em andamento","mass_action_cant_issue_certfificates":"Não é possível emitir os certificados ","mass_action_cant_issue_certfificates_notification_body":"Participantes não foram aprovados ","mass_action_cant_issue_certfificates_with_signature_notification_body":"Participantes não foram aprovados ou precisam da assinatura do certificado ","mass_action_cant_issued_all_ceritificates_notification_body":"Emissão de certificado. Alguns participantes não tiveram o certificado emitido porque não estavam aprovados. ","mass_action_cant_reenroll_participants":"Não é possível realizar a reinscrição em massa.","mass_action_cant_send_emails":"Não é possível enviar os e-mails.","mass_action_cant_send_emails_notification_body":"Usuários inativ