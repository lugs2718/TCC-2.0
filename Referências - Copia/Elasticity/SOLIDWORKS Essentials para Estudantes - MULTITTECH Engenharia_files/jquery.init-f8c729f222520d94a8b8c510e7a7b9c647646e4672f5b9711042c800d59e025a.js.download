ios","not_found_item":"No se encontraron artículos","not_found_participant":"Este usuario no está inscrito en ningún curso.","not_found_student_with_external_id":"No se pudo encontrar un usuario con este external_id","not_information":"No informado","not_more_page":"No hay páginas para cargar","not_started":"No iniciados","not_valid":"No es válido","notification":"Notificaciones","notification_sound_mute":"Silenciar sonido de las notificaciones","notification_sound_unmute":"Activar sonido de las notificaciones","notifications":{"ai_content":{"course_created":"Curso creado con éxito!","course_created_description":"Su curso fue generado por Soph.ia y está listo para visualización","error_limit_token_ai_generation":"Todos los créditos disponibles han sido utilizados. Para continuar, comuníquese con el soporte o espere la renovación.","error_limit_token_ai_generation_title":"Límite de créditos alcanzado","errors":{"error_generating_ai":"Ocorreu um erro na geração do seu curso"},"files_processed_successfully":"Archivos procesados con éxito!","files_processed_successfully_description":"Puede retomar la creación de su curso ahora","image_generation_completed":"Imágenes generadas con éxito!","image_generation_completed_description":"Las imágenes de su curso fueron generadas con éxito.","sync_content_indexing_completed_content":"Su contenido ha sido indexado y ya puede ser utilizado por la IA.","sync_content_indexing_completed_title":"Indexación de contenido completada"},"ai_generated_report":{"content":"Vea el análisis del cuestionario %{content} respondido.","title":"Análisis generado"},"competencies":{"in_app":{"role_interest_declared":{"content":"%{collaborator} declaró interés en la función %{role}.","title":"Interés en función declarado"}}},"contact":"Contacto","content_model":{"regeneration_completed":"Regeneraciones completadas — Las regeneraciones de los diseños del modelo %{model_name} han finalizado."},"import_agent":{"questionnaire_imported":"Questionario importado con éxito!","questionnaire_imported_description":"Su questionario fue importado y está listo para visualización."},"migrations":{"historic_bank":"Aviso de mantenimiento programado. Debido a mejoras de infraestructura, podrían presentarse inestabilidades entre el sábado (05/10) a las 22 horas y el domingo (05/11) a las 07 horas.","hubspot":"¡Estamos migrando nuestra plataforma de soporte para proporcionarle la mejor experiencia posible! Si nota alguna inestabilidad durante este proceso, envíe su solicitud a support@twygo.com. Ah, y recuerda: nuestro equipo está disponible de lunes a viernes, en horario comercial. ¡Estamos aquí para ayudar!","microservices":"Aviso de mantenimiento programado. El chat no estará disponible desde el viernes (16/08/24) a las 22:00 horas hasta el sábado (17/08/24) a las 8:00 horas para actualizaciones tecnológicas.","mysql":"Mantenimiento Programado. La plataforma estará indisponible desde el 09/02/2024 (viernes) a partir de las 22:00 hasta el 10/02/2024 (sábado) a las 18:00 (hora de Brasilia) para mejoras en nuestra base de datos.","rails_7":{"api":"Servicio no disponible debido a mantenimiento programado. Retorno del servicio el 25/07/2026 a las 23:59 (-3 GTM).","login":"Incapaz de iniciar sesión. Plataforma en mantenimiento programado. Retorno de servicios el 25/07/2026 a las 23:59 (-3 GTM).","main_notification":"Aviso de mantenimiento programado. La plataforma no estará disponible el sábado (25/07/26) desde las 16:00 horas hasta las 23:59 horas, para realizar mejoras, actualizaciones de seguridad y optimización del sistema."},"scheduled_maintenance":"Aviso de mantenimiento programado. La plataforma no estará disponible el sábado (25/07/26) desde las 16:00 horas hasta las 23:59 horas, para realizar mejoras, actualizaciones de seguridad y optimización del sistema."},"organization_chart_archives":{"processing":{"default_file_name":"o arquivo","error_content":"Não foi possível concluir a indexação do arquivo %{file_name}. Envie o arquivo novamente para tentar processar.","error_title":"Erro na indexação do documento","success_content":"O arquivo %{file_name} foi processado e está disponível com resumo gerado pela IA.","success_title":"Documento indexado com sucesso"}},"pdi":{"in_app":{"admin_acted":{"content":"%{admin} (administrador) actuó en el PDI de %{colab}","title":"Admin actuó en el PDI de %{colab}"},"aprovado":{"content":"Tu PDI del ciclo %{ciclo} fue aprobado","title":"PDI aprobado"},"aprovado_lider":{"content":"Aprobaste el PDI de %{colab}","title":"PDI aprobado"},"campaign_deadline_warning":{"content":"La campaña %{campaign} termina el %{end_date}. Revisa si tienes acciones abiertas o atrasadas y actualiza su situación.","title":"La campaña %{campaign} termina en 14 días"},"campaign_started":{"create":{"content":"La campaña %{campaign} comenzó. Crea tu PDI hasta el %{end_date}.","title":"Crea tu PDI"},"update":{"content":"La campaña %{campaign} comenzó. Actualiza tu PDI, o conclúyelo y crea uno nuevo, hasta el %{end_date}.","title":"Actualiza tu PDI"}},"cancelado":{"content":"%{actor} canceló tu PDI. Ya no cuenta en los indicadores","title":"PDI cancelado"},"cancelado_lider":{"content":"Cancelaste el PDI de %{colab}","title":"PDI cancelado"},"concluido":{"content":"%{colab} concluyó el PDI y espera tu validación","title":"PDI esperando tu validación"},"devolvido":{"content":"%{actor} devolvió tu PDI para ajustes","title":"PDI devuelto para ajustes"},"devolvido_lider":{"content":"Devolviste el PDI de %{colab} para ajustes","title":"PDI devuelto para ajustes"},"nao_iniciado_lembrete":{"content":"%{actor} te recordó que aún no creaste tu PDI. Ingresa a Desarrollo y comienza.","title":"Crea tu PDI"},"reaberto":{"content":"Tu PDI fue reabierto y volvió a En curso. Puedes editarlo de nuevo","title":"PDI reabierto"},"reaberto_lider":{"content":"Reabriste el PDI de %{colab}","title":"PDI reabierto"},"reativado":{"content":"Tu PDI fue reactivado y volvió a En curso","title":"PDI reactivado"},"reativado_lider":{"content":"Reactivaste el PDI de %{colab}","title":"PDI reactivado"},"reprovado":{"content":"%{actor} rechazó tu PDI","title":"PDI rechazado"},"reprovado_lider":{"content":"Rechazaste el PDI de %{colab}","title":"PDI rechazado"},"submetido":{"content":"%{colab} envió un PDI para tu aprobación","title":"Nuevo PDI para aprobación"},"sugestao_criada":{"content":"Una nueva sugerencia de contenido fue creada en tu PDI","title":"Nueva sugerencia en tu PDI"},"sugestao_pendente_7d":{"content":"Tienes una sugerencia pendiente de decisión hace más de 7 días","title":"Sugerencia pendiente en tu PDI"},"validado":{"content":"Tu PDI fue validado por tu líder de equipo y está concluido","title":"PDI concluido"},"validado_lider":{"content":"Validaste la conclusión del PDI de %{colab}","title":"PDI concluido"}}},"performance":{"in_app":{"actor_system":"Sistema","calibrate_team":{"content":"%{actor} te pide que evalúes a tu equipo en la campaña %{campaign}.","title":"Evalúa a tu equipo"},"consensus_validation":{"disagreed":{"content":"%{collaborator} no estuvo de acuerdo con el resultado del consenso de desempeño.","title":"Desacuerdo con el consenso"},"pending":{"content":"El consenso de tu evaluación de desempeño fue finalizado. Revisa el resultado y registra si estás de acuerdo o en desacuerdo.","title":"Revisión del consenso"}},"feedback_received":{"content":"%{actor} registró un feedback para ti. Accede para visualizar.","title":"Recibiste un feedback"},"indicate_led_pairs":{"content":"%{actor} te pide que indiques los pares de evaluación de tus liderados en la campaña %{campaign}.","title":"Indica los pares de tus liderados"},"init_performance":{"content":"%{actor} informa que el ciclo de la campaña %{campaign} ha comenzado. Acompaña tu avance.","title":"Ciclo de desempeño iniciado"},"manual_reminder":{"content":"Aún no respondiste la evaluación de %{evaluatee} en la campaña %{campaign}. Plazo: %{due_date}.","self_content":"Aún no respondiste tu autoevaluación en la campaña %{campaign}. Plazo: %{due_date}.","title":"Recordatorio de evaluación pendiente"},"nine_box_model_recalculated":{"content":"Los ciclos en curso que usaban el modelo \\"%{model}\\" se recalcularon con la escala nueva. Quien fue movido a mano en la calibración permanece en la caja donde fue colocado.","title":"Recálculo del 9-box finalizado"},"peer_performance":{"content":"%{actor} te pide que evalúes a tus pares en la campaña %{campaign}.","title":"Evalúa a tus pares"},"subordinate_performance":{"content":"%{actor} te pide que evalúes a tu líder en la campaña %{campaign}.","title":"Evalúa a tu líder"}}},"pop_up":{"login_monthly_limit":"No se puede continuar con el inicio de sesión, comuníquese con el administrador del entorno."},"question_list_ai_form":{"error_body":"Nuestro equipo de soporte está disponible en el chat para resolver este problema.","error_title":"Ocurrió un error en la generación de su questionario","success_body":"Acceda al questionario creado con base en las actividades que seleccionó","success_title":"Questionario generado"},"screen_top":{"admin":{"active_users_limit":"Se ha alcanzado el límite de usuarios activos. Actualice para aumentar el límite de su cuenta.","active_users_warning":"Su plan llegó al 90% de los usuarios activos registrados. Actualice o libere más acceso desactivando usuarios.","logins_limit":"Se ha alcanzado el límite de usuarios con inicios de sesión en el mes. Actualice para aumentar el límite de inicio de sesión.","logins_warning":"Según el promedio de inicios de sesión en su organización, estimamos que su plan superará el límite de inicio de sesión en el mes actual. Contrata más accesos para evitar el bloqueo de nuevos inicios de sesión.","storage_limit":"El almacenamiento ha alcanzado el 100%. Actualice su plan o libere espacio eliminando contenido no utilizado.","storage_limit_additional":"El almacenamiento ha alcanzado el 100%. Comuníquese con el administrador de su entorno principal para actualizar o liberar más espacio eliminando el contenido no utilizado.","storage_warning":"Su plan ha alcanzado el 90% del espacio de almacenamiento. Para evitar que se le bloquee la carga de contenido nuevo, solicite más almacenamiento o libere espacio eliminando contenido no utilizado.","warning_clone_in_progress":"Su ambiente está siendo configurado! Algunos cursos y contenidos pueden no estar visibles aún, pero ya puede navegar y usar la plataforma normalmente.","warning_trial_days_left":"Todavía tienes %{days_left} días para probar Twygo. Para no perder los datos de tus pruebas y seguir usando la plataforma, contacta con nuestro equipo comercial."},"clone":{"got_it":"Entendido"},"external":{"warning_clone_in_progress":"Su ambiente está siendo configurado! Algunos cursos y contenidos pueden no estar visibles aún, pero ya puede navegar y usar la plataforma normalmente."},"external_user":{"active_users_limit":"No se puede continuar con el registro, comuníquese con el administrador de la organización."},"instructor":{"storage_limit":"El almacenamiento ha alcanzado el 100 % antes de ponerse en contacto con el administrador de su organización.","storage_limit_additional":"El almacenamiento ha alcanzado el 100%. Comuníquese con su administrador para actualizar o liberar más espacio eliminando el contenido no utilizado."},"manager_class":{"active_users_limit":"Se ha alcanzado el límite de usuarios. Póngase en contacto con el administrador de su organización.","active_users_limit_additional_environment":"Se ha alcanzado el límite de usuarios. Por favor, contacte al administrador del entorno."}},"studio_copilot":{"activity_not_generated":"La actividad \\"%{activity}\\" no fue generada. Inténtalo de nuevo.","generation_failed_generic":"La generación con IA fue interrumpida por un fallo. Inténtalo de nuevo.","generation_failed_title":"Fallo en la generación con IA","slides_failed_title":"Fallo en la generación de diapositivas","template_design_without_content":"La actividad \\"%{activity}\\" no fue generada: el diseño del modelo \\"%{template}\\" no tiene contenido.","template_without_designs":"El modelo \\"%{template}\\" no tiene ningún diseño de lección o página."}},"notify_certificate":"Notificar la certificación","number":{"currency":{"format":{"delimiter":".","format":"%u %n","precision":2,"separator":",","significant":false,"strip_insignificant_zeros":false,"unit":"R$"}},"format":{"delimiter":".","precision":3,"round_mode":"default","separator":",","significant":false,"strip_insignificant_zeros":false},"human":{"decimal_units":{"format":"%n %u","units":{"billion":"Mil millones","million":"Millón","quadrillion":"Cuatro mil millones","thousand":"mil","trillion":"Billón","unit":""}},"format":{"delimiter":".","precision":2,"significant":true,"strip_insignificant_zeros":true},"storage_units":{"format":"%n %u","units":{"byte":{"one":"Byte","other":"Bytes"},"eb":"EB","gb":"GB","kb":"KB","mb":"MB","pb":"PB","tb":"TB"}}},"percentage":{"format":{"delimiter":".","format":"%n %"}},"precision":{"format":{"delimiter":"."}}},"number_registered_is_greater":"El número de entradas registradas es mayor que el límite (%{limit}).","oauth":{"complete_to_register":"Completa tus datos para finalizar tu registro."},"obs":"Observaciones","oi_paggo":"Hola Paggo","on_off_lights":"Apagar/Encender las luces","on_topics_found_by":"Ningún tópico encontrado para la búsqueda por","onboarding":{"email_invalid":"Correo Electrónico registrado","step_01":{"description":"\\u003cp\\u003ePara comenzar a usar Twygo, necesitamos crear una organización.\\u003c/p\\u003e \\u003cp\\u003e Aquí puede ofrecer cursos personalizados para sus estudiantes. \\u003c/p\\u003e","name":"Su nombre","name_placeholder":"Nombre completo","organization_name":"Nombre de su organización","organization_url":"URL en Twygo","organization_url_tip":"Sin espacios en blanco o caracteres especiales"},"step_02":{"organization_phone":"Teléfono","organization_phone_placeholder":"(99) 9 9999-9999","organization_site":"Sitio","organization_site_placeholder":"http://seudominio.com","organization_users":"Número de Alumnos","user_email":"E-mail","user_email_placeholder":"nome@seudominio.com"},"step_03":{"confirm_password":"Confirme su Contraseña","description":"\\u003cp\\u003eEstamos finalizando su registro, por favor informe una contraseña.\\u003cbr\\u003e\\u003csmall\\u003e* Mínimo 6 caracteres\\u003c/small\\u003e\\u003c/p\\u003e","password":"Contraseña"},"step_04":{"default_color_infor":"*Botones de Acciones, íconos del menú y selecciones","default_color_text_infor":"*Texto del sistema","description":"\\u003cp\\u003eUsted puede personalizar los colores y el logo de su página. ¡Más tarde, usted podrá personalizar otras partes del producto! \\u003c/p\\u003e","logo_infor":"* PNG, JPG o GIF\\u003cbr\\u003e ** Máxima de 60px de altura","organization_name":"Adelante, deje a Twygo con la cara de  {{name}}"},"welcome":"¡Bienvenido a Twygo!","welcome_mobile":"Bienvenido a"},"online_debit":"Débito online (TEF)","open_public_chat_content":"Abrir chat público de contenido","order_number":"Nº Orden","ordering_of_question":"Orden de la Pregunta","org_clone":{"coverage_entities":{"assessments_competency":"Evaluaciones de competencia","assessments_performance":"Evaluaciones de desempeño","assessments_total":"Evaluaciones (total)","box_placements":"Posicionamientos nine-box","campaigns":"Campañas","communities":"Comunidades","cycles":"Ciclos","journey_tasks":"Tareas de jornada","journeys":"Jornadas","organization_chart_competencies":"Competencias del organigrama","organization_chart_roles":"Funciones del organigrama","organization_goals":"Metas (PDI)","performance_entries":"Retroalimentación","reward_store_categories":"Categorías de la tienda de premios","reward_store_rewards":"Premios de la tienda","users":"Usuarios"},"create":{"enqueued":"Clon de %{organization} en cola. Siga el estado en el historial."},"delete":{"button":"Eliminar organización","confirm":"¿Eliminar la organización clonada? Esto dispara la exclusión de la organización (no es hard-delete).","enqueued":"Exclusión disparada — la organización clonada será eliminada.","not_deletable":"No se puede eliminar (clon en curso, sin organización destino, o ya eliminado)."},"errors":{"demo_access_into_existing_target":"El acceso de demostración no aplica cuando el destino es una organización existente: el clon no redefine la contraseña de un usuario real del destino. Borre el correo y la contraseña del acceso de demostración, o deje en blanco el ID de la organización destino.","destination_invalid":"Organización destino inválida (no existe o es igual al origen).","domain_creation_failed":"No fue posible crear el dominio predeterminado tras %{attempts} intentos: %{reason}","domain_failure_unknown":"save devolvió false sin mensaje de error","feature_disabled":"El clon de organización no está habilitado para esta organización.","generic":"Ocurrió un error al procesar el clon.","organization_required":"Ingrese un ID de organización origen válido.","target_busy_timeout":"Destino ocupado por otro clon más allá del tiempo límite de espera."},"form":{"contract_plan":"Contrato (plan) de la organización clonada","contract_plan_blank":"Sin contrato (clonar sin plan)","contract_plan_hint":"Plan usado para crear el contrato de la nueva organización (activo, mensual, con los créditos del plan). Opcional.","demo_user_email":"Acceso de demostración (correo del usuario en el origen)","demo_user_email_hint":"Correo de un usuario de la organización de origen que se convertirá en el acceso de demostración. El acceso mostrado en el detalle del clon es el correo que ese usuario tiene EN EL DESTINO: con la anonimización activada, el correo anonimizado; con la anonimización desactivada, el correo real de la persona. En blanco = sin acceso de demostración.","demo_user_password":"Contraseña del acceso de demostración","demo_user_password_hint":"Contraseña a definir para ese usuario en la organización clonada. En blanco = el sistema genera una y la muestra en el detalle del clon.","modules_hint":"Marque los subsistemas a copiar. Desmarcar no rompe el clon — solo no copia ese ítem, y su cobertura se ignora en el estado. Atención: varios dependen de Usuarios (sin ellos, perfiles/evaluaciones/PDI etc. vienen vacíos).","modules_title":"Qué clonar","origin_organization_id":"ID de la organización origen","origin_organization_id_hint":"Ingrese el ID numérico de la organización que se clonará.","overwrite_existing":"Sobrescribir lo que ya existe en el destino","overwrite_existing_hint":"Solo aplica cuando el destino es una org existente. Sin marcar (predeterminado) = mantiene lo que el destino ya tiene. Marcado = sobrescribe identidad/config/DHO con los datos del origen. El contenido nunca se duplica.","preserved_user_email":"Usuario a preservar en el randomize (correo)","preserved_user_email_hint":"Correo de un usuario de la organización origen que NO será anonimizado, para poder iniciar sesión en la org clonada. En blanco = preserva a quien disparó el clon.","randomize":"Anonimizar datos (randomize)","randomize_hint":"Si está marcado, los nombres y correos de los usuarios copiados serán anonimizados.","submit":"Iniciar clon","subtitle":"Crea una copia completa de una organización en una nueva organización destino.","target_name":"Nombre de la organización destino","target_name_hint":"Nombre que se asignará a la nueva organización creada.","target_organization_id":"ID de la organización destino (existente)","target_organization_id_hint":"En blanco = crea una organización nueva (predeterminado). Completado = clona DENTRO de esa organización existente (actualiza/combina).","title":"Nuevo clon de organización"},"inactivate":{"button":"Inactivar organización","confirm":"¿Inactivar la organización clonada? Sigue existiendo, pero queda inactiva/inaccesible.","done":"Organización clonada inactivada.","not_inactivatable":"No se puede inactivar (clon en curso, sin organización destino, o ya eliminado).","target_missing":"La organización destino de este clon ya no existe."},"index":{"actions_menu":"Acciones","active_banner":{"one":"%{count} clon en curso","other":"%{count} clones en curso"},"auto_refresh_note":"Se actualiza automáticamente cada 5 segundos","column_created_at":"Fecha","column_duration":"Duración","column_origin":"Organización origen","column_status":"Estado","column_target":"Organización destino","column_triggered_by":"Iniciado por","empty":"Aún no se han ejecutado clones.","empty_async":"La clonación de organización se ejecuta en segundo plano (cola Sidekiq). En cuanto disparas una, aparece aquí de inmediato — no hace falta esperar a que termine para verla. Cada ejecución pasa por los estados de abajo:","empty_detail_hint":"Haz clic en \\"Ver detalles\\" en cualquier ejecución para seguir la cobertura por entidad y el informe por módulo.","empty_stuck_body":"Si una ejecución queda en cola por mucho tiempo, la cola de Sidekiq puede no estar consumiendo jobs. Verifica que los workers de Sidekiq estén activos.","empty_stuck_title":"¿Atascado en \\"En cola\\"?","legend":{"completed":"finalizado con éxito, sin alertas.","degraded":"finalizado, pero algunos elementos se omitieron o fallaron — revisa el detalle.","failed":"interrumpido por un error — mira el mensaje en el detalle.","queued":"esperando en la cola — un worker de Sidekiq tomará el job.","running":"ejecutándose ahora — copiando datos del origen al destino."},"new_button":"Nuevo clon","pagination_summary":"Mostrando %{shown} de %{total}","polling_hint":"Hay ejecuciones en cola o en curso. Esta página se actualiza automáticamente cada 5 segundos.","refresh_button":"Actualizar","show_link":"Ver detalles","subtitle":"Historial de clones ejecutados vía sys admin.","title":"Clones de organización"},"menu":{"index":"Clones de Organización"},"modules":{"access_profiles":"Permisos (perfiles y administradores)","assessments":"Evaluaciones (competencia y desempeño)","box_placements":"Nine Box","branding":"Identidad visual (logo, colores e imágenes)","certificates":"Certificado (plantilla y configuración)","communities":"Comunidades internas (participantes y reglas de entrada automática)","companies":"Empresas (con direcciones)","competency_events":"Eventos de competencia","content":"Contenido de aprendizaje (cursos, rutas, comunidades)","cycles_campaigns":"Ciclos y campañas","feature_flags":"Feature flags (Flipper)","gamification":"Gamificación (trofeos y configuraciones)","journeys":"Jornadas (fases, tareas, equipo y ejecuciones)","nine_box_models":"Modelos de 9-box","org_config":"Configuración de la org (campos, página, tags)","orgchart":"Organigrama (funciones y competencias)","pdi":"PDI (metas)","performance_entries":"Feedback","question_lists":"Listas de preguntas","reward_store":"Tienda de premios (moneda, catálogo, billeteras y canjes)","succession":"Sucesión","use_modes":"Modo de uso (menús)","user_assignments":"Asignaciones de usuario","users":"Usuarios"},"recover":{"cannot_revert":"Nada para revertir (este clon no llegó a crear una organización).","help":"El clon falló a la mitad. Puedes mantener la organización parcial y continuar desde donde paró (solo completa lo que faltó), o revertir (eliminar la organización creada). Atención: al retomar un clon randomizado, el usuario preservado vuelve al valor por defecto (quien disparó el clon).","not_recoverable":"Solo se puede recuperar un clon que falló.","resume_button":"Mantener organización y continuar","resume_confirm":"¿Continuar el clon reutilizando la organización ya creada?","resume_enqueued":"Clon re-encolado — continuará desde donde paró.","revert_button":"Revertir (eliminar organización)","revert_confirm":"¿Eliminar la organización parcial creada por este clon? Esto dispara la exclusión de la organización.","revert_enqueued":"Reversión disparada — la organización creada será eliminada.","title":"Recuperación"},"report_modules":{"access_profiles":"Permisos (perfiles y administradores)","assessments":"Evaluaciones","box_placements":"Posicionamientos nine-box","branding":"Identidad visual","certificates":"Certificado","communities":"Comunidades","companies":"Empresas","competency_events":"Eventos de competencia","content":"Contenido de aprendizaje","cycles_campaigns":"Ciclos y campañas","demo_access":"Acceso de demostración","feature_flags":"Feature flags (Flipper)","gamification":"Gamificación","journeys":"Jornadas","nine_box_models":"Modelos de 9-box","org_config":"Configuración de la org","orgchart":"Organigrama","pdi":"PDIs","performance_entries":"Retroalimentación","question_lists":"Listas de preguntas","reward_store":"Tienda de premios","succession":"Sucesiones","user_assignments":"Asignaciones de usuario"},"show":{"contract_plan":"Contrato (plan):","coverage_entity":"Entidad","coverage_origin":"Origen","coverage_pct":"Cobertura","coverage_target":"Destino","coverage_title":"Cobertura por entidad","created_at":"Iniciado en","demo_access_help":"Usa estas credenciales para entrar en la organización clonada. La contraseña fue definida por este clon y solo vale en esta organización — no cambia la contraseña del usuario en la organización de origen.","demo_access_login":"Acceso (correo en el destino):","demo_access_origin_email":"Usuario elegido en el origen:","demo_access_password":"Contraseña:","demo_access_title":"Acceso de demostración","edit_plan_button":"Editar plan","failed_title":"El clon falló.","false":"Não","mailer_block_note":"Envío de correo BLOQUEADO en esta organización clonada: los usuarios copiados son personas reales y recibirían un correo de bienvenida con contraseña. Para liberarlo cuando el ambiente se use de verdad, desactive el bloqueo en la configuración de la organización.","mirror_note":"Los cursos de tipo espejo (compartidos desde otra organización) no se clonan — pertenecen a la organización de origen del uso compartido y son de solo lectura. Las alertas relacionadas con esos cursos son esperadas y no indican una falla en el clon.","no_con