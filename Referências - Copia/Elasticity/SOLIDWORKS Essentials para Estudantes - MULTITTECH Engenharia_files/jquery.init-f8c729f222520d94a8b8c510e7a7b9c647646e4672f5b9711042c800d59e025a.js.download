var safePreventEvent;

safePreventEvent = function(e) {
  if (e.preventDefault) {
    e.preventDefault();
  } else {
    if (e.stop) {
      e.stop();
    }
  }
  e.returnValue = false;
  if (e.stopPropagation) {
    return e.stopPropagation();
  }
};
String.prototype.truncate = function(size, str) {
  if (typeof str !== "string") {
    str = "...";
  }
  if (this.length > size) {
    return this.substring(0, size) + str;
  } else {
    return this;
  }
};

$('body').click(function(event) {
 if (!$(event.target).closest('.hideOnClickOut').length) {
      $('.hideOnClickOut').hide().removeClass("hideOnClickOut");
  };
});

$("#email_recommendation").bind("ajax:before", function() {
  $(".loading_email_recommendation").show();
}).bind("ajax:complete", function() {
  $(".loading_email_recommendation").hide();
  $.modal.close();
});


$("#new_email").bind("ajax:before", function() {
  $(".loading_new_email").show();
}).bind("ajax:complete", function() {
  $(".loading_new_email").hide();
  $.modal.close();
});


$("#change_email").bind("ajax:before", function() {
  $(".loading_change_email").show();
}).bind("ajax:complete", function() {
  $(".loading_change_email").hide();
  $.modal.close();
});
