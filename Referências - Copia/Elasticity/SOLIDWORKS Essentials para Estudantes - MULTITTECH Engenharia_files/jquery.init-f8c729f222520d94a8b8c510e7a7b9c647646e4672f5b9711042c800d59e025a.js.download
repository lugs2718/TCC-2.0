":"The 9-box model could not be saved.","vertical_axis_name_required":"The vertical axis name is required.","vertical_cuts_not_ascending":"On each axis, cut 1 must be lower than cut 2."},"set_default":{"success":"Default model updated."},"update":{"success":"9-box model successfully updated."}}},"no_active_attempt_found":"No active attempt found","no_active_organization_found_in_file":"An error occurred while importing. No active organization found in file.","no_attachment":"There is no attachment.","no_attemp_made":"No attempt made","no_available_img":"There is no image available.","no_available_video":"There are no videos available.","no_comment":"No comment","no_comment_student":"No comments for this student","no_courses":"No courses","no_courses_found":"No courses found","no_date":"No date","no_event_found":"No event found","no_event_suggestions":"There are no course recommendations at this time. Try completing your list of interests to get results.","no_file_selected":"No file selected","no_future_events":"No future events available ","no_link_professionals":"No links were found between professional and requirements.","no_manager_found":"No Manager Found!","no_organization_with_this_id":"There is no Organization with this ID","no_organizations_marked_for_inactivation":"An error occurred while importing. No organizations marked for inactivation.","no_question_to_copy":"No questions to be copied","no_questions_enabled":"No questions enabled","no_questions_registered":"No questions registered","no_related_professional_profile":"No professional profile associated!","no_results_found":"No results found","no_skills_related":"There are no skills associated.","no_terms_found_for_id":"No terms found for the specified ID","no_terms_found_for_locale_and_term_type":"No terms found for the specified locale and term type","no_topics":"No topics","no_tracks_for_user":"No Learning Path to show for this user","no_uploaded_files":"No file uploaded","no_users_linked":"No Users linked","none_registered":"None registered","not_a_member_yet":"Not a member yet?","not_allowed_pagseguro":"Not allowed by PagSeguro","not_allowed_subdomain":"Cannot use subdomain","not_content_for_this_activity":"No content was available for this activity.","not_found":"No users found","not_found_item":"No items found","not_found_participant":"This user is not enrolled in any courses.","not_found_student_with_external_id":"Could not find a user with this external_id","not_information":"Uninformed","not_more_page":"There are no pages to load","not_started":"Not initiated","not_valid":"Not valid","notification":"Notifications","notification_sound_mute":"Mute notification sound","notification_sound_unmute":"Unmute notification sound","notifications":{"ai_content":{"course_created":"Course created successfully!","course_created_description":"Your course was generated by Soph.ia and is ready for viewing","error_limit_token_ai_generation":"All available credits have been used. To continue, contact support or wait for renewal.","error_limit_token_ai_generation_title":"Credit limit reached","errors":{"error_generating_ai":"Ocorreu um erro na geração do seu curso"},"files_processed_successfully":"Files processed successfully!","files_processed_successfully_description":"You can resume the creation of your course now","image_generation_completed":"Images generated successfully!","image_generation_completed_description":"The images of your course were generated successfully.","sync_content_indexing_completed_content":"Your content has been indexed and can now be used by AI.","sync_content_indexing_completed_title":"Content indexing completed"},"ai_generated_report":{"content":"See the analysis of the questionnaire %{content} answered.","title":"Generated analysis"},"competencies":{"in_app":{"role_interest_declared":{"content":"%{collaborator} declared interest in the %{role} role.","title":"Role interest declared"}}},"contact":"Contact","content_model":{"regeneration_completed":"Regenerations completed — The design regenerations for model %{model_name} are complete."},"import_agent":{"questionnaire_imported":"Questionnaire imported successfully!","questionnaire_imported_description":"Your questionnaire was imported and is ready for viewing."},"migrations":{"historic_bank":"Scheduled maintenance notice. Due to infrastructure improvements, instabilities may occur between Saturday (05/10) at 10pm and Sunday (05/11) at 7am.","hubspot":"We are migrating our support platform to provide the best possible experience for you! If you notice any instability during this process, please send your request to support@twygo.com. Oh, and remember: our team is available from Monday to Friday, during business hours. We are here to help!","microservices":"Scheduled maintenance notice. Chat will be unavailable from Friday (08/16/24) at 10:00 PM until Saturday (08/17/24) at 8:00 AM for technology upgrades.","mysql":"Scheduled maintenance. The platform will be unavailable from 02/09/2024 (Friday) from 22:00 until 02/10/2024 (Saturday) at 18:00 (Brasília time) for improvements to our database.","rails_7":{"api":"Service unavailable due to scheduled maintenance. Return of service on 07/25/2026 at 11:59 pm (-3 GTM).","login":"Unable to login. Platform undergoing scheduled maintenance. Return of services on 07/25/2026 at 11:59 pm (-3 GTM).","main_notification":"Scheduled maintenance notice. The platform will be unavailable on Saturday (07/25/26) from 4:00 pm until 11:59 pm for improvements, security updates and system optimization."},"scheduled_maintenance":"Scheduled maintenance notice. The platform will be unavailable on Saturday (07/25/26) from 4:00 pm until 11:59 pm for improvements, security updates and system optimization."},"organization_chart_archives":{"processing":{"default_file_name":"o arquivo","error_content":"Não foi possível concluir a indexação do arquivo %{file_name}. Envie o arquivo novamente para tentar processar.","error_title":"Erro na indexação do documento","success_content":"O arquivo %{file_name} foi processado e está disponível com resumo gerado pela IA.","success_title":"Documento indexado com sucesso"}},"pdi":{"in_app":{"admin_acted":{"content":"%{admin} (administrator) acted on the PDI of %{colab}","title":"Admin acted on the PDI of %{colab}"},"aprovado":{"content":"Your PDI for cycle %{ciclo} has been approved","title":"PDI approved"},"aprovado_lider":{"content":"You approved the PDI of %{colab}","title":"PDI approved"},"campaign_deadline_warning":{"content":"The %{campaign} campaign ends on %{end_date}. Check whether you have open or overdue actions and update their status.","title":"The %{campaign} campaign ends in 14 days"},"campaign_started":{"create":{"content":"The %{campaign} campaign has started. Create your PDI by %{end_date}.","title":"Create your PDI"},"update":{"content":"The %{campaign} campaign has started. Update your PDI, or complete it and create a new one, by %{end_date}.","title":"Update your PDI"}},"cancelado":{"content":"%{actor} cancelled your IDP. It no longer counts towards the indicators","title":"IDP cancelled"},"cancelado_lider":{"content":"You cancelled the IDP of %{colab}","title":"IDP cancelled"},"concluido":{"content":"%{colab} completed the IDP and is awaiting your validation","title":"IDP awaiting your validation"},"devolvido":{"content":"%{actor} returned your PDI for adjustments","title":"PDI returned for adjustments"},"devolvido_lider":{"content":"You returned the PDI of %{colab} for adjustments","title":"PDI returned for adjustments"},"nao_iniciado_lembrete":{"content":"%{actor} reminded you that you haven\'t created your PDI yet. Go to Development and get started.","title":"Create your PDI"},"reaberto":{"content":"Your IDP was reopened and is back to In progress. You can edit it again","title":"IDP reopened"},"reaberto_lider":{"content":"You reopened %{colab}\'s IDP","title":"IDP reopened"},"reativado":{"content":"Your IDP was reactivated and is back to In progress","title":"IDP reactivated"},"reativado_lider":{"content":"You reactivated the IDP of %{colab}","title":"IDP reactivated"},"reprovado":{"content":"%{actor} rejected your PDI","title":"PDI rejected"},"reprovado_lider":{"content":"You rejected the PDI of %{colab}","title":"PDI rejected"},"submetido":{"content":"%{colab} submitted a PDI for your approval","title":"New PDI for approval"},"sugestao_criada":{"content":"A new content suggestion was created in your PDI","title":"New suggestion in your PDI"},"sugestao_pendente_7d":{"content":"You have a suggestion pending decision for over 7 days","title":"Pending suggestion in your PDI"},"validado":{"content":"Your IDP was validated by your team leader and is now completed","title":"IDP completed"},"validado_lider":{"content":"You validated the completion of %{colab}\'s IDP","title":"IDP completed"}}},"performance":{"in_app":{"actor_system":"System","calibrate_team":{"content":"%{actor} asks you to evaluate your team for campaign %{campaign}.","title":"Evaluate your team"},"consensus_validation":{"disagreed":{"content":"%{collaborator} disagreed with the performance consensus result.","title":"Consensus disagreement"},"pending":{"content":"The consensus of your performance assessment has been finalized. Review the result and register whether you agree or disagree.","title":"Consensus review"}},"feedback_received":{"content":"%{actor} registered a feedback for you. Open it to read.","title":"You received a feedback"},"indicate_led_pairs":{"content":"%{actor} asks you to select the evaluation peers for your team members in campaign %{campaign}.","title":"Select your team members\' peers"},"init_performance":{"content":"%{actor} reports that the cycle for campaign %{campaign} has started. Track your progress.","title":"Performance cycle started"},"manual_reminder":{"content":"You have not answered the assessment of %{evaluatee} in the %{campaign} campaign yet. Due date: %{due_date}.","self_content":"You have not answered your self-assessment in the %{campaign} campaign yet. Due date: %{due_date}.","title":"Pending assessment reminder"},"nine_box_model_recalculated":{"content":"The in-progress cycles using the model \\"%{model}\\" were recalculated with the new scale. Anyone moved by hand in the calibration stays in the box where they were placed.","title":"9-box recalculation finished"},"peer_performance":{"content":"%{actor} asks you to evaluate your peers for campaign %{campaign}.","title":"Evaluate your peers"},"subordinate_performance":{"content":"%{actor} asks you to evaluate your leader for campaign %{campaign}.","title":"Evaluate your leader"}}},"pop_up":{"login_monthly_limit":"Unable to continue with login, contact the environment administrator."},"question_list_ai_form":{"error_body":"Our support team is available in the chat to resolve this problem.","error_title":"An error occurred in the generation of your questionnaire","success_body":"Access the questionnaire created based on the activities you selected","success_title":"Questionnaire generated"},"screen_top":{"admin":{"active_users_limit":"Your active user limit has been affected. Please upgrade to increase your account limit.\\n","active_users_warning":"Your plan reached 90% of registered active users. Upgrade or free up more access by inactivating users.","logins_limit":"The limit of users with logins in the month has been reached. Upgrade to increase the login limit.","logins_warning":"Based on the average logins in your organization, we estimate that your plan will exceed the login limit in the current month. Buy more accesses to avoid blocking new logins.","storage_limit":"Storage has reached 100%. Upgrade your plan or free up space by deleting unused content.","storage_limit_additional":"Storage has reached 100%. Please contact your primary environment administrator to upgrade or free up more space by deleting unused content.","storage_warning":"Your plan has reached 90% of storage space. To avoid being blocked from uploading new content, request more storage or free up space by deleting unused content.","warning_clone_in_progress":"Your environment is being configured! Some courses and contents may not be visible yet, but you can already use the platform normally.","warning_trial_days_left":"You still have %{days_left} days to try Twygo. In order not to lose your test data and continue using the platform, contact our commercial team."},"clone":{"got_it":"Understood"},"external":{"warning_clone_in_progress":"Your environment is being configured! Some courses and contents may not be visible yet, but you can already use the platform normally."},"external_user":{"active_users_limit":"Unable to proceed with registration, please contact the organization administrator."},"instructor":{"storage_limit":"Storage has reached 100% between contact your organization administrator.","storage_limit_additional":"Storage has reached 100%. Please contact your administrator to upgrade or free up more space by deleting unused content."},"manager_class":{"active_users_limit":"The user limit has been reached. Contact your organization\'s administrator.","active_users_limit_additional_environment":"The user limit has been reached. Please contact the environment administrator."}},"studio_copilot":{"activity_not_generated":"The activity \\"%{activity}\\" was not generated. Please try again.","generation_failed_generic":"The AI generation was interrupted by a failure. Please try again.","generation_failed_title":"AI generation failed","slides_failed_title":"Slides generation failed","template_design_without_content":"The activity \\"%{activity}\\" was not generated: the design of the model \\"%{template}\\" has no content.","template_without_designs":"The model \\"%{template}\\" has no lesson or page design."}},"notify_certificate":"Notify Certification","number":{"currency":{"format":{"delimiter":",","format":"%u%n","precision":2,"separator":".","significant":false,"strip_insignificant_zeros":fal