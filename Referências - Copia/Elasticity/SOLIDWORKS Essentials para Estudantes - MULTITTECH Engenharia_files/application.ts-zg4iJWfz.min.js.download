days (period)",update_inscriptions:"Update access days for current subscribers",update_courses_days_to_expire:"Replace the access days of courses with those defined in the learning path",restrict_access_period:"Restrict access outside of the hours configured in usage mode",allow_attachments:"Enable attachment upload on subscription",attachment_description:"Attachment request message",has_recertification:"Allow re-enrollment",block_registrations_without_active_grant:"Block enrollments from companies without an active grant",block_registrations_without_registered_company:"Block enrollments from unregistered companies"},placeholder:{email:"Your contact email",days_to_expire:"Enter the days",attachment_description:"Describe the requested documentation or files"},tooltip:{allow_subscription_by:"Restricts who can register for this content: companies, individuals, or both. This configuration affects the registration screen: if both options are selected, the user will be asked to choose between an individual or a company during registration.",allow_attachments:"Allows users to send files during subscription.",email:"Shown on the public content page as the channel for enrollment questions.",days_to_expire:"Set the number of days after enrollment that the user will have access to the content.",validity:"How the deadline is calculated. The package has two clocks and whichever ends first applies: the access period, the same for every enrollee, and the individual access days, counted per person from enrollment. 0 days means no limit by days, so only the period applies. While the person accesses through the package, the package deadline prevails over the content's own validity. Content that is in more than one of the person's packages follows the longest access.",package_days_to_expire:"Number of access days each person gets from their enrollment in the package. 0 means no limit by days, so only the access period applies.",update_inscriptions:"When changing the content validity period, allows applying this change to current subscribers, updating the individual expiration date of each one. The new expiration date will be calculated from the subscription date.",update_individual_access_days_for_current_subscribers:"When changing the content validity period, allows applying this change to current subscribers, updating the individual expiration date of each one. The new expiration date will be calculated from the subscription date.",update_courses_days_to_expire:"When changing the content validity period, allows applying this change to linked courses, replacing the individual access days of each course. The new expiration date of each course will be calculated according to the validity period defined in the track.",restrict_access_period:"For this configuration to be effective, access times must be set in your environment. This setting can be configured in the Navigation > Usage Mode menu.",has_recertification:"Lets approved learners, those who finished the course, or whose expiration date has passed re-enroll to retake the content and renew their certification.",block_registrations_without_active_grant:"Only companies with an active grant reaching this content can enroll (Companies > Grants). A grant on other contents does not count. The rule also applies to an individual who names the company in their professional data.",block_registrations_without_registered_company:"When enabled, only companies already registered in this environment can enroll in contents. If the given CNPJ is not found, the enrollment is blocked and the company is not registered automatically. The rule also applies to individuals who inform a company in their professional data."},validation:{email:"Enter a valid email",positive_number:"Enter a positive number",allow_at_least_one:"Select at least one registration modality",attachment_description_required:"Message is required if attachment upload is enabled"},errors:{event_id_required:"Event ID is required"}},additional_fields:{age:{label:"Age",placeholder:"Ex: 18-25 years, 26-35 years, All ages..."},difficulty:{label:"Difficulty",placeholder:"Ex: Beginner, Intermediate, Advanced, Expert..."},tone_of_voice:{label:"Tone of voice",placeholder:"Ex: Formal, Casual, Motivational, Technical, Professional..."},user_profile:{label:"Audience profile",placeholder:"Ex: Professionals starting in leadership..."},language:{label:"Language",placeholder:"Select language",options:{portuguese:"Portuguese",english:"English",spanish:"Spanish"}},additional_information:{label:"Additional information",placeholder:"Ex: Specific context information, special requirements, preferred methodology..."},workload:{label:"Suggested workload",placeholder:"HH:MM:SS"},has_questionnaire:{label:"Include questionnaire",options:{0:"No",1:"Yes"}},questionCount:{label:"No. of questions displayed",tooltip:"Quantity of questions that the students will answer, limited to a maximum of 100 questions."},alternativesPerQuestion:{label:"No. of alternatives per question"},multipleChoiceQuestions:{label:"Multiple choice"},singleChoiceQuestions:{label:"Single choice"},openTextQuestions:{label:"Open/Text"},valueRangeQuestions:{label:"Value range",tooltip:"Students place variations from 1 to 5 for each question"},responseVisualization:{label:"Response visualization",tooltip:"Select how the user will view the correction of the questionnaire, being able to be, only the score, the options they answered or the correct answers to the question",options:{score_only:"Show only score",only_answered:"Show answered",answered_and_correct:"Show answered and correct"}},showLimitApproval:{label:"Configure response visualization and approval percentage"},questionDisplay:{label:"Question display",tooltip:"Select how the questions will be displayed in each attempt of the questionnaire",options:{different_questions:"Show different questions each attempt",same_questions:"Show the same questions",random_questions:"Show questions randomly",follow_order:"Show questions in the order they were defined"}},minimumScore:{label:"Minimum score (%)",tooltip:"Enter the minimum percentage of correct answers to obtain approval in the questionnaire"},approvalPercentage:{label:"% of approval in the final score",tooltip:"This field is used for you who uses more than one questionnaire in the content and wants them to have different percentages in the total sum of all questionnaires"},attempts:{label:"Attempts",tooltip:"Maximum number of attempts allowed for the questionnaire. If it is 0(zero) = unlimited attempts",options:{unlimited:"Unlimited",1:"1",2:"2",3:"3",5:"5",10:"10"}},requiredQuestions:{label:"Required questions",tooltip:"Participant cannot complete a questionnaire without answering the required questions"},allowParticipantComments:{label:"Permit participant to comment on the questions",tooltip:"Permit participant to comment on the questions"},allowInstructorOpinion:{label:"Permit instructor to give an opinion",tooltip:"Permit instructor to give an opinion"},requireApprovalToComplete:{label:"Require approval to complete the activity",tooltip:"When enabled, the activity will only be completed after the participant is approved in the questionnaire. Until approved (or while waiting review), the activity will remain pending, without registering progress or score. Survey questionnaires are completed once submitted, regardless of this parameter."},questionnaireQuantity:{label:"Quantity of questionnaires",tooltip:"Quantity of questionnaires that will be created using the same configuration. Is considered from the total quantity of activities of the course",options:{one_per_course:"1 for the entire course",one_per_phase:"1 for each phase",at_end_of_course_and_each_phase:"At the end of the course and in each phase"}}},placeholder:{course_name:"Ex: Marketing Digital, Programming Python, Photography...",target_audience:"Ex: Beginners, Sellers, Engineers...",objective:"Ex: Train students to understand the fundamentals of Python programming."},values_radio_of_assessments:{0:"No, only content of the lessons",1:"Yes, include questionnaires at the end"},assessment_settings:{include_assessments:"Assessment settings"},question_count:{label:"Number of questions",placeholder:"Ex: 5",min:"The number of questions must be at least 1"},required_questions:{label:"Required questions",tooltip:"Participant cannot complete a questionnaire without answering the required questions"},file_upload:{file_upload_header:"Send the files that will be used to create the course",additional_orientation:"Send documents with a maximum of 100 pages."},content_details:{include_content_details:"Include the basic data of the course you want to create"},generated_activities_form:{select_activities:"Select the activities you want to include"},audio_selection:{title:"Choose the voice to narrate your classes",description:"Select the voice that best fits the tone of your course. You can listen to a sample of each voice before choosing.",example_text:"Example text:",description_example:"Hello! Welcome. In this training on strategic leadership, we will learn about a case of organizational resilience and discuss the importance of assertive feedback. We will also explore together the meaning of the phrase 'active learning enhances autonomy' and how it applies in daily life. In addition, we will cover topics such as gamification and metacognition.",voice_selected:"Voice selected:",play_sample:"Play sample",duration:"Duration",no_audios:"No voices available",loading:"Loading audio voices...",loading_title:"Loading audio examples",loading_description:"This may take a few seconds",errors:{load_failed:"Error loading audio voices. Please try again.",play_failed:"Error playing audio. Please try again."}},error:"Error saving the form",success:"Form saved successfully",validation:{theme:{required:"The course theme is required and cannot be empty"},targetAudience:{required:"The target audience is required and cannot be empty"},numberOfLessons:{required:"