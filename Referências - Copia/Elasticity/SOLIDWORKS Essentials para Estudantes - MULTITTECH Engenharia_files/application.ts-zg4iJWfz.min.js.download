er the start day",start_day_min:"The start day must be greater than zero",duration_required:"Enter the duration",duration_min:"The duration must be greater than zero"}}}}}},Ide={en:{translations:{title:"Security",tabs:{login:"Login",magicLink:"Magic link"},tooltips:{loginMethods:"Select the methods that users can use to access your environment.",cpfEnabled:"Users with CPF login will not receive email notifications, unless they also have a registered email.",socialNetworksEnabled:"Enabling this option will allow users to log in to the environment using their LinkedIn, Facebook, Google, or Apple account. This option also enables user creation using these methods if the environment allows user registration via the login screen.",magicLinkEnabled:"Magic Link is a way to authenticate via a link, without the user needing to enter a username and password. If your environment has Magic Link enabled, it automatically becomes a login method. To change Magic Link settings, go to Security > Magic Link.",magicLinkLoginStandard:"When the magic link is the default login method, all new users registered in the environment or through the API will receive the first access via magic link in their email.",tabTitle:"The magic link is a way to authenticate through a link, without the user having to enter login and password. ",apiEnabled:"When enabled, allows users with access to the API key of your environment to consult and create users with magic links.",emailEnabled:"When enabled, allows the magic link to be available to be sent to the user's email registered in the environment.",generateForAll:"Allows generating a new magic link for all users in your environment. When clicking this button, all current magic links will be immediately updated.",loginExpirationEnabled:"If activated, when an enrolled user watches an activity and does not interact (like clicking or moving the mouse) for the configured time, we will ask them to confirm that they are still online. If they do not confirm, the session will be ended and they will need to log in again."},login:{title:"Login Methods",description:"Configure available authentication methods",form:{title:"Login Methods",sections:{standardLogin:{title:"Standard Login"},loginExpiration:{title:"Login Expiration"}},fields:{emailEnabled:{label:"By email",description:"Allow users to login through email"},cpfEnabled:{label:"By CPF",description:"Allow users to login through CPF"},socialNetworksEnabled:{label:"By social networks",description:"Allow users to login through social networks"},magicLinkEnabled:{label:"By magic link",description:"Allow users to login through magic link"},magicLinkLoginStandard:{label:"Make magic link standard login method",description:"When enabled, magic link will be the default login method for new users"},loginExpirationEnabled:{label:"Enable login expiration by inactivity time during learning",description:"Configure inactivity time for session expiration"},inactiveTime:{label:"Inactivity time",description:"Time in minutes to consider user inactive",placeholder:"00:00",unit:"min"}},buttons:{save:"Save",cancel:"Cancel"},success:{updated:"Login settings updated successfully!"},errors:{updateFailed:"Error updating login settings",loadFailed:"Error loading login settings"},validation:{invalidConfiguration:"Invalid configuration",inactiveTime:{required:"Inactivity time is required when login expiration is enabled",min:"Inactivity time must be greater than or equal to 0",format:"Inactivity time must be in HH:MM format",range:"Inactivity time must be greater than or equal to 1 minute and less than or equal to 24 hours"}}}},magicLink:{title:"Configuration of Magic link",description:"Configure the options for authentication by magic link",form:{section:{title:"General Settings"},fields:{isEnabled:{label:"Enable magic link",description:"Allow users to login through magic links"},apiEnabled:{label:"Allow to treat magic link via API"},emailEnabled:{label:"Allow to send magic link by email"},inativeTimeMagicLinkEnable:{label:"Enable expiration time",tooltip:"Define the validity of Magic Links in the environment. After the configured time, the links expire automatically and new ones are generated for users."},inativeTimeMagicLink:{label:"Expire after",description:"Number of hours for magic link expiration",unit:"hours"},disabled:{helpText:"This field will be available only when Magic link is enabled"}},buttons:{save:"Save",cancel:"Cancel",generateMagicLinkForAll:"Generate new magic link for all users",disabledTooltip:"Enable Magic link first to use this functionality"},success:{updated:"New magic links are being generated",title:"Settings saved successfully"},errors:{updateFailed:"Error updating Magic link settings",loadFailed:"Error loading security settings"},validation:{inativeTimeMagicLink:{min:"Expiration time must be greater than or equal to 1",max:"Expiration time must be less than or equal to 9999"}}},modal:{title:"Attention when generating a new magic link for all users",description:"This feature updates the magic links for all active users registered. When saving the changes, users will not be able to access the environment using the old link and it will be necessary to resend the new ones.",buttons:{cancel:"Cancel",confirm:"Generate"}},enableModal:{title:"Enable Magic link",description:"You are about to enable the authentication system via Magic link. This feature will allow users to login through special links sent by email. Do you want to continue?",buttons:{cancel:"Cancel",confirm:"Enable"}},emailEnabledModal:{title:"Attention when enabling Magic link sending by email",message:"This feature allows the magic link to be available to be sent to the user's email registered in the environment. Your environment uses CPF as the default login method, only users with registered email will receive the magic link by email.",buttons:{cancel:"Cancel",confirm:"OK, I understand"}},magicLinkContractRequiredModal:{title:"Ops! This option is not available in your pl