iones"},actions:{edit:"Editar",editTitle:"Editar persona"},moreRoles:"+{{count}}",rolesPopover:{title:"Funciones de {{name}} ({{count}})"},empty:"No hay personas con los filtros actuales."},lossProbability:{very_low:"Muy baja",low:"Baja",medium:"Media",high:"Alta",updateSuccess:"Probabilidad actualizada con éxito",updateError:"No fue posible actualizar la probabilidad. Inténtalo de nuevo."},edit:{title:"Editar persona",sections:{profile:"Datos de la persona",roles:"Funciones y probabilidad"},fields:{photo:"Foto",photoReplace:"Sustituir imagen",photoRemove:"Eliminar imagen",first_name:"Nombre",last_name:"Apellido",email:"Correo electrónico",cpf:"Documento",role:"Cargo",function:"Función",department:"Área",manager:"Responsable",organization_chart_roles:"Funciones",organizationChartRolesTooltip:"En este campo definirás las funciones que esta persona desempeña en el día a día.",roles:"Funciones",rolesTooltip:"Selecciona las funciones que esta persona desempeña. La adherencia y la preparación se calculan automáticamente con base en las competencias.",rolesPlaceholder:"Seleccione o escriba para crear una función...",adherence:"Adherencia",readiness:"Preparación",loss_probability:"Probabilidad de pérdida",lossProbabilityTooltip:"Probabilidad porcentual estimada de que la persona deje la organización en el próximo ciclo.",lossProbabilityOrigin:{updatedBy:"Actualizado por la evaluación de {{evaluator}} en el ciclo {{cycle}}.",previousValue:"Valor anterior: {{previous}}"}},placeholder:{manager:"Seleccione un líder de equipo"},readiness:{ready_now:"Listo ahora",six_to_twelve:"3-6 meses",twelve_to_twenty_four:"6-12 meses",future:"12+ meses"},buttons:{save:"Guardar",cancel:"Cancelar",back:"Volver",addRole:"Agregar función",removeRole:"Eliminar función"},toasts:{updateSuccess:"Datos actualizados con éxito",updateError:"No fue posible actualizar. Inténtalo de nuevo.",roleCreateSuccess:"Función creada con éxito",roleCreateError:"No fue posible crear la función. Inténtalo de nuevo."