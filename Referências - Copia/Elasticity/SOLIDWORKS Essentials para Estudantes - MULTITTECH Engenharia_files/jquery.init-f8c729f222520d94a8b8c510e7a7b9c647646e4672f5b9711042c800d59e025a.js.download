our account in a few minutes.","send_paranoid_instructions":"If your e-mail exists in our database, you will receive an email with instructions about how to confirm your account in a few minutes.","unconfirmed":"Unconfirmed"},"failure":{"already_authenticated":"You are already signed in.","apple_hide_email":"For the login to be carried out, disable the option Hide my email","inactive":"Your account was not activated yet.","invalid":"Invalid login or password.","invalid_cnpj":"Invalid EIN","invalid_cpf":"Invalid Taxpayer\'s ID","invalid_login":"Invalid login or password.","invalid_session":"Your session has been terminated because you logged in from another device. Please log in again.","invalid_token":"Invalid authentication token.","last_attempt":"Last_Attempt","locked":"Your account is locked.","not_found_in_database":"Database for categories ","timeout":"Your session expired, please sign in again to continue.","unallowed":"Login not allowed, contact the admin.","unauthenticated":"You need to sign in or sign up before continuing.","unconfirmed":"You have to confirm your account before continuing.","unconfirmed_in_course":"Your subscription is pending. After confirmation, you will receive an email with access instructions."},"mailer":{"confirmation_instructions":{"subject":"Confirmation instructions"},"email_changed":{"subject":"Email Changed"},"password_change":{"subject":"Password Changed"},"reset_password_instructions":{"subject":"Reset password instructions"},"shared_mailer":{"accept_sharing":"Accept sharing","click_to_view":"click here","click_to_view_capitalize":"Click here","course_content":"Content:","end_share_subject":"Sharing ended","end_sharing":"The administrator has terminated the sharing. Your users will no longer be able to access the content.","from":"From:","new_share_subject":"New share","or":"Or","reactivate_sharing":"The administrator has reactivated the sharing. Your users will be able to access the content again.","reactivate_sharing_subject":"Sharing reactivated","shared_content_received":"You have received new content shared from another environment. Accept the content to start sharing it with your users.","to_receiver":"To:","to_view":"to view.","view_shared_content":"to view shared content."},"unlock_instructions":{"subject":"Unlock Instructions"}},"omniauth_callbacks":{"failure":"Unable to authorize login via %{kind} because %{reason}.","success":"Successfully authorized from %{kind} account."},"passwords":{"confirm_your_account_before":"Before continuing, check your email and confirm your account.","no_token":"No_Token","send_instructions":"If your email is registered, within minutes you will receive instructions to reset your password.","send_paranoid_instructions":"If your e-mail exists on our database, you will receive a password recovery link on your e-mail","updated":"Your password was changed successfully. You are now signed in.","updated_not_active":"Password changed successfully, proceed with login."},"registrations":{"destroyed":"Bye! Your account was successfully cancelled. We hope to see you again soon.","inactive_signed_up":"You have signed up successfully. To login, you must confirm your  e-mail using the link we sent to your address.","signed_up":"Welcome! You are logged in. If unauthorized, you will receive a confirmation by e-mail.","signed_up_but_inactive":"You signed up successfully. To login, you must confirm your e-mail using the link we sent to your address.","signed_up_but_locked":"Your account was successfully created. However, we could not log you in as your account is locked.","signed_up_but_unconfirmed":"A message with the confirmation link was sent to your email address. Please click on the link to activate your account.","update_needs_confirmation":"You updated your account successfully, however we must confirm your new email address. Kindly click on the link we sent you to confirm your email address.","updated":"You updated your account successfully.","updated_but_not_signed_in":"Your account has been updated successfully, but since your password was changed, you need to sign in again."},"sessions":{"already_signed_out":"Signed out successfully.","signed_in":"Signed in successfully.","signed_out":"Signed out successfully."},"unlocks":{"send_instructions":"You will receive an email with instructions about how to unlock your account in a few minutes.","send_paranoid_instructions":"If your account exists, you will receive an email with instructions about how to unlock it in a few minutes.","unlocked":"Your account was successfully unlocked. You are now signed in."}},"dho_imports":{"create":{"success":"Import received. Processing happens in the background."},"errors":{"action_description_required":"Fill in descricao_acao.","assessment_type_required":"Fill in the tipo_avaliacao column.","axis_name_required":"Fill in both axis names of the 9box model.","axis_score_required":"Fill in eixo_x and eixo_y.","campaign_already_exists":"The campaign \\"%{name}\\" already exists in this cycle. Choose Update or Create under \\"Records already imported\\".","campaign_cycle_required":"Fill in the campaign ciclo column.","campaign_name_required":"Fill in the campaign name.","campaign_not_found":"Campaign \\"%{name}\\" was not found in the organization.","campaign_repeated_in_sheet":"The campaign \\"%{name}\\" appears more than once on the Campanhas sheet with different data. Use one row per campaign.","campaign_required":"Fill in the campanha column.","consensus_assessment_ambiguous":"This collaborator has a consensus assessment in more than one campaign of this cycle, so the acceptance could not be recorded. Record it from the campaign screen.","consensus_assessment_not_found":"There is no consensus assessment for this collaborator in this cycle, so the acceptance could not be recorded.","cuts_out_of_order":"On each axis, cut 1 must be lower than cut 2.","cycle_already_exists":"A cycle named \\"%{name}\\" already exists (in the organization or duplicated in the spreadsheet).","cycle_name_required":"Fill in the cycle name.","cycle_not_found":"Cycle \\"%{name}\\" was not found (neither in the spreadsheet nor in the organization).","cycle_question_list_change_blocked":"The cycle \\"%{name}\\" already has answered assessments on another questionnaire. Changing the questionnaire would leave the old scores orphaned: use the cycle current questionnaire or import it as a new cycle.","cycle_required":"Fill in the ciclo column.","date_required":"Fill in column %{column} with a valid date (dd/mm/yyyy).","duplicated_headers":"Duplicated columns in the spreadsheet: %{headers}. Each column must appear only once.","email_not_found":"No collaborator with email %{email} was found in the organization.","email_required":"Fill in email_colaborador.","end_before_start":"The end date is earlier than the start date.","errors_truncated":"Showing %{shown} of %{total} errors, with at least one example of each kind. Fix them and import again to see the rest.","feature_disabled":"DHO import is not enabled for this organization.","feedback_already_exists":"This feedback has already been imported for this collaborator on this date. Choose Update or Create under \\"Records already imported\\".","feedback_description_required":"Fill in the descricao column.","feedback_kind_required":"Fill in the tipo column.","file_required":"Upload an .xlsx file.","file_too_large":"The file exceeds the 10 MB size limit.","headers_mismatch":"Spreadsheet columns do not match the template. Missing: %{missing}. Unrecognized: %{unexpected}.","invalid_assessment_type":"Invalid value \\"%{value}\\" in the tipo_avaliacao column. Use: %{allowed}.","invalid_axis_scale":"Invalid axis scale (%{start} to %{end}). Use numbers, with the end greater than the start. Leave both columns empty to use the cycle questionnaire scale.","invalid_axis_score":"Invalid value \\"%{value}\\" in %{column}. Use a number from %{min} to %{max}.","invalid_boolean":"Invalid value \\"%{value}\\" in column %{column}. Use sim or nao.","invalid_closing_model":"Invalid value \\"%{value}\\" in the modelo_fechamento column. Use one of: %{allowed}.","invalid_consensus_agreement":"Invalid value \\"%{value}\\" in the concordou_consenso column. Use one of: %{allowed}.","invalid_cut":"Invalid cut in %{column} (value \\"%{value}\\"). Use a whole number from %{min} to %{max}, as a percentage.","invalid_date":"Invalid value \\"%{value}\\" in column %{column}. Use a date in dd/mm/yyyy format.","invalid_discrepancy_threshold":"Invalid value \\"%{value}\\" in the limite_divergencia column. Use a number.","invalid_duplicate_action":"Invalid duplicate handling option.","invalid_enum_value":"Invalid value \\"%{value}\\" in column %{column}. Accepted values: %{allowed}.","invalid_evaluator_type":"Invalid value \\"%{value}\\" in the tipo_avaliador column. Use one of: %{allowed}.","invalid_feedback_kind":"Invalid value \\"%{value}\\" in the tipo column. Use one of: %{allowed}.","invalid_file_type":"The file must be .xlsx (template downloaded from the platform).","invalid_kind":"Invalid import type.","invalid_nine_box_axis":"Invalid value \\"%{value}\\" in the eixo_9box column. Use one of: %{allowed}.","invalid_participant_kind":"Participant type \\"%{value}\\" is invalid. Accepted values: %{allowed}.","invalid_potential":"Invalid value \\"%{value}\\" in the potencial column. Use a whole number from 1 to 5.","invalid_scale":"Invalid scale (%{start} to %{end}). Use whole numbers, with the start between 0 and 9, the end greater than the start and at most 10, totalling 2 to 11 levels.","invalid_score":"Invalid value \\"%{value}\\" in the nota column. Use a number.","invalid_status":"Invalid status \\"%{value}\\". Accepted values: %{allowed}.","invalid_weight":"Invalid value \\"%{value}\\" in the %{column} column. Use a whole number from 0 to 100.","nine_box_model_already_exists":"The 9box model \\"%{name}\\" already exists. Choose Update under \\"Records already imported\\" to overwrite its cuts and box names.","nine_box_model_name_required":"Fill in the 9box model name.","nine_box_model_not_found":"The organization has no 9box model configured. Set up the model before importing placements.","nine_box_seed_failed":"The 9box placement of cycle %{cycle} could not be computed from the imported scores.","no_sheet_with_data":"No sheet in the spreadsheet has data. Fill in at least one sheet of the template before importing.","not_found":"Import not found.","organization_required":"Organization is required.","participant_campaign_not_in_sheet":"The campaign \\"%{name}\\" is not on the Campanhas sheet. The campanha column takes the campaign name, not the cycle name.","participant_required_fields":"Fill in campanha and email_colaborador.","pdi_already_exists":"A PDI titled \\"%{title}\\" already exists for this collaborator.","pdi_title_required":"Fill in titulo_pdi.","performance_score_not_found":"No consolidated performance result was found for this collaborator in this campaign.","placement_already_exists":"A 9box placement already exists for this collaborator in this cycle.","placement_not_created":"Could not save the 9box placement: %{message}.","potential_required":"Fill in the potencial column.","question_ambiguous_between_sections":"The question \\"%{question}\\" exists in more than one section of the questionnaire \\"%{question_list}\\" and the Avaliações sheet does not say the section. Make the question texts distinct in the questionnaire.","question_list_name_required":"Fill in the formulario column with the name of the cycle questionnaire.","question_list_not_found":"This campaign does not have a questionnaire configured to receive answers.","question_not_in_existing_question_list":"The question \\"%{question}\\" does not exist in the questionnaire \\"%{question_list}\\", which is already in use. The import does not add questions to an existing questionnaire: use the exact text of the registered question or a new questionnaire name.","question_required":"Fill in the pergunta column.","question_text_required":"Fill in the pergunta column.","respondent_required":"Select at least one respondent for the cycle (auto_avaliacao, avaliacao_lider, avaliacao_liderado or avaliacao_pares).","scale_required":"Fill in escala_inicio and escala_fim to create the questionnaire named in formulario.","score_not_in_alternatives":"The score %{value} does not match any alternative of the multiple-choice question (accepted values: %{allowed}).","score_out_of_scale":"Score %{value} is outside the questionnaire scale (%{start} to %{end}).","score_required":"Fill in the nota column.","sheet_missing":"Sheet \\"%{sheet}\\" was not found in the spreadsheet. Use the template downloaded from the platform.","too_many_rows":"The sheet has %{count} data rows; the limit is %{limit}.","unexpected":"Unexpected error during the import. Try again or contact support.","weights_required":"The media_ponderada closing model requires at least one weight greater than zero (peso_auto, peso_lider, peso_liderado or peso_pares). Without a weight, the final score is not calculated.","wrapup_already_exists":"This collaborator already has a closing wrap-up for this cycle."},"import":{"default_comment":"Placement imported from the 9box spreadsheet.","default_objective_title":"General actions","failure":"Import failed. No data was saved — fix the errors and import again.","success":"Import completed successfully."},"list":{"success":"Imports listed successfully."},"list_errors":{"success":"Errors listed successfully."},"template":{"columns":"Columns: %{columns}.","cycle_migration":{"assessments_consensus":"The consenso tipo_avaliador is a third assessment, filled in by the leader together with the led person, and it is the one that becomes the final score when the cycle has modelo_fechamento set to consenso. Only fill it in if the cycle really had that consensus conversation.","assessments_evaluator":"The email_avaliador column must contain the e-mail of whoever answered. When tipo_avaliador is auto, repeat the evaluatee e-mail.","assessments_heading":"Avaliações sheet","assessments_kind":"The tipo_avaliador column accepts auto, lider, consenso, liderado, pares: auto is the self-assessment, lider is the direct manager assessment, liderado is the assessment by the people the person leads and pares are the peers.","assessments_question":"The pergunta column must contain the exact text of a question from the Perguntas sheet of the same questionnaire.","assessments_row":"Each row is the score of one question answered by one evaluator for one evaluatee. Repeat ciclo, campanha, evaluatee, evaluator and tipo_avaliador on every row of the same assessment, one row per question.","assessments_score":"The nota column accepts a number within the questionnaire scale defined on the Ciclos sheet.","campaigns_all_company":"The toda_empresa column accepts sim or nao. With sim, every active collaborator joins the campaign and the Participantes sheet is only used to register exceptions.","campaigns_heading":"Campanhas sheet","campaigns_peer_window":"The indicacao_pares_inicio and indicacao_pares_fim columns only make sense when the cycle has avaliacao_pares set to sim. Leave them empty otherwise.","campaigns_row":"Use one row per campaign. The ciclo column must contain the name of a cycle from the Ciclos sheet or of a cycle that already exists in the organization.","campaigns_status":"The status column accepts rascunho, ativo, encerrado (default rascunho).","campaigns_windows":"The indicacao_pares, avaliacao, pdi and fechamento column pairs delimit the window of each stage and must fall within the campaign period, in the order the stages happen.","closing_consensus":"The concordou_consenso column records whether the led person agreed with the consensus assessment and accepts concordou, discordou, pendente. Only fill it in for cycles that had a consensus assessment.","closing_date":"The data column is the date on which the closing happened. When it is left empty, the import date is used.","closing_heading":"Fechamento sheet","closing_leader":"The email_lider column is who signs the wrap-up. When it is left empty, the wrap-up is recorded on behalf of whoever ran the import.","closing_row":"Use one row per collaborator per cycle. This sheet records the written wrap-up from the leader at the cycle closing.","closing_texts":"The comentario, pontos_fortes, pontos_a_desenvolver and recomendacoes columns accept free text and make up the content of the wrap-up.","cycles_assessment_type":"The tipo_avaliacao column defines which assessment runs in the cycle and accepts desempenho.","cycles_closing_model":"The modelo_fechamento column defines how the final score comes out: consenso uses the score of the consensus assessment (tipo_avaliador consenso in the Avaliações sheet) when it exists and, without it, the average of the assessments; media_ponderada uses the average weighted by the cycle weights and requires those weights to be configured; apenas_lider uses the leader score. Accepted values: media_ponderada, apenas_lider, consenso.","cycles_dates":"The data_inicio must be earlier than or equal to the data_fim.","cycles_divergence":"The limite_divergencia column accepts a number: when two assessments of the same collaborator differ by more than this limit, the consolidation flags the divergence. Leave it empty to not flag anything.","cycles_heading":"Ciclos sheet","cycles_nine_box_model":"The modelo_9box column links the cycle to a 9box model by name, either one from the Modelo 9box sheet or one already existing in the organization. When left empty, the cycle uses the organization default model.","cycles_question_list":"The formulario column is the name of the cycle questionnaire. If a questionnaire with that name already exists in the organization, it is reused; if it does not exist, the import creates a new one with the questions from the Perguntas sheet.","cycles_question_list_reuse":"If the questionnaire already exists and has questions, every spreadsheet question must exist in it; extra questions in the questionnaire are kept and the import does not add questions to a questionnaire in use. A questionnaire created on the screen with multiple-choice questions and no scale consolidates on the product 0 to 1 scale; to migrate 1 to 5 scores, prefer a new questionnaire name, which the import creates on the given scale.","cycles_respondents":"The auto_avaliacao, avaliacao_lider, avaliacao_liderado and avaliacao_pares columns define who answers the assessment. Mark at least one with sim.","cycles_row":"Use one row per cycle. The cycle name is the reference used in the Campanhas, Avaliações, 9box and Fechamento sheets, so write it exactly the same in all of them.","cycles_scale":"The escala_inicio and escala_fim columns define the score scale of the questionnaire and are only used when it is created. If the questionnaire already exists, its scale is kept and these columns are ignored.","cycles_stages":"The pdi and feedback_ciclo columns indicate which optional stages the cycle will have and accept sim or nao. 9box calibration is no longer a cycle stage — it is available whenever the performance assessment is enabled.","cycles_status":"The status column accepts rascunho, ativo, encerrado. When it is left empty, the cycle is created as a draft.","feedbacks_author":"The email_autor column is who recorded the feedback. When it is left empty, the record stays on behalf of whoever ran the import.","feedbacks_heading":"Feedbacks sheet","feedbacks_kind":"The tipo column accepts feedback, reconhecimento, preocupacao, anotacao.","feedbacks_row":"Use one row per record. This sheet brings the continuous feedback and notes history, which does not belong to a specific cycle.","feedbacks_visibility":"The visivel column indicates whether the collaborator sees the record and accepts sim or nao.","general_booleans":"The yes/no columns accept only sim or nao, without accents. When the column is left empty, the value considered is nao.","general_columns":"Do not add new columns and do not change the order of the existing ones.","general_dates":"Fill in dates in the dd/mm/yyyy format (for example: 01/03/2026). Cells formatted as dates in Excel and the yyyy-mm-dd format are also accepted.","general_example":"Row 1 of each sheet is the header and row 2 has a filled-in example. Delete the example row before sending your data.","general_heading":"General rules","general_limit":"Each sheet accepts at most 2000 data rows. For larger volumes, split the import into more than one file.","general_required":"The columns marked with * on this instructions sheet are required. Rows without those values are rejected and listed in the error report.","general_required_sheets":"No sheet is required: the import only needs Ciclos or Campanhas to have at least one data row. The others can stay empty, and each filled sheet enables one part of the migration.","general_sheets":"Do not rename the sheets or the columns: the import looks for exactly the names already on the spreadsheet, in the same order.","intro":"Migrates a whole cycle at once: the cycle setup, the campaigns, the questionnaire, the scores per question, the 9box placement, the wrap-up and the feedbacks. Fill in only the sheets you have — each sheet enables one part of the migration.","linking_campaign":"Campaign (nome column on Campanhas, campanha column on Avaliações and Participantes): identified by name within the cycle, with the same duplicates handling.","linking_cycle":"Cycle (nome column on Ciclos and ciclo column on the other sheets): a cycle with the same name is updated or rejected according to the duplicates option chosen when sending the file. The other sheets may reference a cycle that already existed in the organization.","linking_feedbacks":"Feedbacks: a feedback already imported for the same employee is updated or rejected according to the duplicates option, so re-importing the file does not duplicate.","linking_heading":"Records linked by name","linking_intro":"Several records are located by name, ignoring letter case and surrounding spaces. When the name already exists in the organization, the import links to the existing record instead of creating another one.","linking_nine_box_model":"9box model (modelo_9box column): by name, either one from the Modelo 9box sheet or one already registered. A model with the same name on the sheet is updated or rejected according to the duplicates option.","linking_people":"People: always by e-mail, and they must already exist in the organization — the import does not create people.","linking_question":"Question (pergunta column on Perguntas and Avaliações): reused by text within the questionnaire and section. The eixo_9box column only changes the axis when filled.","linking_question_list":"Questionnaire (formulario column): if one with that name already exists, it is reused and the escala_inicio and escala_fim columns are ignored — its scale prevails.","linking_scores":"Scores (Avaliações sheet) and placement (9box sheet) do not go through the duplicates option: the spreadsheet value always prevails, so re-importing updates without duplicating.","nine_box_fallback":"When there is no marked question, it is this sheet that places the collaborator on the 9box.","nine_box_heading":"9box sheet","nine_box_model_axes":"The eixo_horizontal and eixo_vertical columns are the names of the two matrix axes as HR sees them (for example, Performance and Potential).","nine_box_model_boxes":"The caixa_1 to caixa_9 columns are the names of the nine matrix boxes, in position order: boxes 1 to 3 form the bottom row, 4 to 6 the middle row and 7 to 9 the top row. Within each row, the order goes from the low to the high band of the horizontal axis.","nine_box_model_boxes_optional":"Leaving a box empty keeps the classic name for that position. The low, medium and high levels of each box are derived from the position and are not filled in the spreadsheet.","nine_box_model_cuts":"Cuts are given as percentages, from 0 to 99, and split each axis into three bands: cut 1 is where the low band ends and cut 2 is where the medium band ends. Above cut 2 is the high band.","nine_box_model_cuts_order":"On each axis, cut 1 must be lower than cut 2. The classic values are 33 and 67.","nine_box_model_heading":"Modelo 9box sheet","nine_box_model_row":"This sheet is optional and migrates the 9box matrix configuration along with the cycle. Use one row per model. Without it, the import uses the 9box model already configured in the organization.","nine_box_override":"When this sheet brings a collaborator who already has the axes calculated from the answers, it wins: the placement is saved as a recalibration made by the committee, preserving the quadrant the calculation had generated.","nine_box_precedence":"When there is a question marked with eixo_9box as desempenho or potencial on the Perguntas sheet, both axes are calculated from the answers on the Avaliações sheet and this sheet is not needed.","nine_box_quadrant":"There is no quadrant column: each axis score is converted to a position from 0% to 100% and the quadrant is derived from the cuts of the cycle 9box model, either the one given in the Modelo 9box sheet or the organization default.","nine_box_reason":"The motivo column records the justification for the placement and shows up in the calibration history.","nine_box_scale":"The eixo_x (horizontal axis) and eixo_y (vertical axis) columns are filled in the scale you used to measure, declared in the escala_inicio and escala_fim columns of the row itself. That way you fill in the score as it is in your base, without converting anything.","nine_box_scale_default":"When escala_inicio and escala_fim are left empty, the cycle questionnaire scale defined in the Ciclos sheet is used. If the cycle has no questionnaire, the scale considered goes from 0 to 10.","order_assessments":"4. Fill in the Avaliações sheet with one row per answered question.","order_campaigns":"2. Fill in the Campanhas sheet, referencing the cycles by name.","order_closing":"7. Fill in the Fechamento and Feedbacks sheets with the history you have.","order_cycles":"1. Fill in the Ciclos sheet with the cycle setup and the questionnaire name.","order_heading":"Filling order","order_nine_box":"6. Fill in the 9box sheet only if the axes do not come from the answers or if there is a committee recalibration.","order_nine_box_model":"5. Fill in the Modelo 9box sheet if you want to migrate the matrix configuration too, and reference the model in the modelo_9box column of the Ciclos sheet.","order_processing":"The import processes the sheets in that same order, it is all or nothing and reports errors indicating the sheet and the spreadsheet row.","order_questions":"3. Fill in the Perguntas sheet with the questionnaire questions and the 9box axes.","participants_campaign":"The campanha column takes the name of a campaign from the Campanhas sheet, not the cycle name.","participants_heading":"Participantes sheet","participants_row":"This sheet is optional: whoever has an answer on the Avaliações sheet already joins the campaign automatically. Use it only to include people without answers or to register exceptions.","participants_type":"The tipo column accepts avaliado, excecao (default avaliado). Use excecao to remove from the campaign someone included automatically by toda_empresa.","questions_axis":"The eixo_9box column indicates whether the question feeds one of the 9box axes and accepts nenhum, desempenho, potencial. Use desempenho for the horizontal axis, potencial for the vertical axis and nenhum for the questions that only count towards the score.","questions_form":"The formulario column must repeat exactly the name used in the formulario column of the Ciclos sheet.","questions_heading":"Perguntas sheet","questions_reuse":"If the questionnaire already exists in the organization and already has questions, every question on this sheet must exist in it (text is compared ignoring accents, punctuation and case). Extra questions in the questionnaire are kept; a spreadsheet question missing from it is rejected.","questions_row":"Use one row per questionnaire question. The questionnaire is built from this sheet, together with the formulario, escala_inicio and escala_fim columns of the Ciclos sheet.","questions_section_column":"The secao column groups related questions (for example, the name of a questionnaire block) and is optional. When it is left empty, the question is not grouped into any section.","requirements_assessments":"Each row is one answered question. Scores outside the questionnaire scale are rejected.","requirements_campaigns":"The referenced cycle must be on the Ciclos sheet or already exist in the organization.","requirements_closing":"concordou_consenso requires the employee to have a consensus assessment in the cycle.","requirements_cycles":"Ciclos or Campanhas must have data. An empty tipo_avaliacao becomes desempenho and an empty formulario uses the cycle name.","requirements_feedbacks":"titulo, email_autor and visivel are optional.","requirements_heading":"Summary per sheet: what is required","requirements_intro":"Required = the column must be filled in every row of the sheet. A fully empty sheet never raises an error; optional columns can be left blank.","requirements_line":"%{sheet} sheet — optional. Required columns: %{required}. Optional: %{optional}. %{note}","requirements_nine_box":"Without escala_inicio and escala_fim, the axes use the cycle questionnaire scale and, without one, 0 to 10.","requirements_nine_box_model":"Cuts are percentages from 0 to 99, in ascending order. The nine caixa_N columns are optional.","requirements_participants":"Whoever has an answer on the Avaliações sheet already joins the campaign without being listed here.","requirements_questions":"Questions that already exist in the questionnaire are reused (text compared ignoring accents, punctuation and case). If the questionnaire already has questions, every spreadsheet question must exist in it and missing ones are rejected; a new questionnaire is created with the sheet\'s questions.","title":"Cycle migration template"},"nine_box":{"avaliacoes_campaign":"The campanha column must contain the exact name of a performance evaluation campaign for that cycle.","avaliacoes_cycle":"The ciclo column must contain the exact name of a cycle already registered in the organization.","avaliacoes_evaluatee":"The email_avaliado column must contain the email of the evaluated collaborator, already registered in the organization.","avaliacoes_evaluator":"The email_avaliador column must contain the email of whoever answered. When tipo_avaliador is auto, it can repeat the evaluatee\'s email.","avaliacoes_heading":"Avaliações sheet","avaliacoes_kind":"The tipo_avaliador column accepts auto, lider and has a dropdown list in the sheet: auto is a self-assessment, lider is the manager\'s assessment.","avaliacoes_question":"The pergunta column must contain the exact question text. The same text (in the same section) is treated as the same question across all rows.","avaliacoes_result":"The collaborator\'s final performance is calculated from all imported answers, following the consolidation method already configured on the cycle (self-assessment, manager or consensus).","avaliacoes_row":"Each row represents the score of one question answered by an evaluator for an evaluatee. Repeat cycle, campaign, evaluatee, evaluator and evaluator type on every row of the same evaluation, one row per question.","avaliacoes_score":"The nota column accepts a number, on the scoring scale used by the campaign.","avaliacoes_section":"The secao column is optional and groups related questions (e.g. the name of a questionnaire block). If the section or the question do not exist yet in the campaign, the import creates them automatically with the given text.","general_columns":"Do not add new columns and do not change the order of the existing columns.","general_example":"Row 1 of each sheet is the header and row 2 has a filled-in example. Delete the example row before sending your data.","general_heading":"General rules","general_limit":"Each sheet accepts a maximum of 2000 data rows. For larger volumes, split the import into more than one file.","general_required":"Columns marked with * on this instructions sheet are required. Rows missing these values are rejected and appear in the error report.","general_sheets":"Do not rename the sheets or the columns: the import looks for exactly the names already on the spreadsheet, in the same order.","intro":"Fill in the Avaliações sheet with the performance answers and the Potencial sheet with each collaborator\'s potential. The matrix quadrant is calculated automatically by the import.","order_avaliacoes":"2. Fill in the Avaliações sheet with one row per answered question.","order_cycles":"1. Confirm that the cycle and the campaign are already registered in the organization.","order_heading":"Fill-in order","order_potencial":"3. Fill in the Potencial sheet with the potential of each collaborator that appears on the Avaliações sheet.","order_processing":"The import reports errors indicating the sheet and the spreadsheet row.","potencial_comment":"The comentario column is optional and accepts free text.","potencial_cycle":"The ciclo column must be the same one used on the Avaliações sheet for that collaborator.","potencial_email":"The email_colaborador column must contain the email of a user already registered in the organization, with answers on the Avaliações sheet in the same cycle.","potencial_heading":"Potencial sheet","potencial_row":"Each row represents a collaborator\'s potential in a cycle. Repeating the same cycle and collaborator updates the existing placement, according to the option chosen on the import screen for duplicate records.","potencial_score":"The potencial column accepts a score from 1 to 5, set manually (the system does not yet calculate potential automatically), and has a dropdown list in the sheet.","quadrant_1":"1 — Underperforming (low performance, low potential)","quadrant_2":"2 — Effective (medium performance, low potential)","quadrant_3":"3 — Specialist (high performance, low potential)","quadrant_4":"4 — Questionable (low performance, medium potential)","quadrant_5":"5 — Core player (medium performance, medium potential)","quadrant_6":"6 — High performer (high performance, medium potential)","quadrant_7":"7 — Enigma (low performance, high potential)","quadrant_8":"8 — Strong performer (medium performance, high potential)","quadrant_9":"9 — Star (high performance, high potential)","quadrants_heading":"How the quadrant is calculated","quadrants_intro":"The final quadrant (1 to 9) is calculated automatically by crossing performance (calculated from the Avaliações sheet) with potential (Potencial sheet). There is no column to type the quadrant.","quadrants_tiers_performance":"Performance (0 to 10 scale, calculated from the answers): up to 4 = low, up to 8 = medium, above 8 = high.","quadrants_tiers_potential":"Potential (1 to 5 scale): 1 and 2 = low, 3 and 4 = medium, 5 = high.","title":"9box import template"},"validation":{"error_message":"Select one of the accepted values for this column: %{values}.","error_title":"Invalid value"}}},"dho_migration":{"confirm":{"enqueued":"Import confirmed and reprocessed. Track the status on this screen.","not_awaiting_confirmation":"The import is not awaiting confirmation."},"create_assessment_campaign":{"name":"Competencies Assessment Campaign (DHO)"},"create_competency_assessment_list":{"list_name":"Competencies Assessment (DHO)"},"discard":{"done":"Import discarded. The organization is free for a new import.","not_awaiting_confirmation":"The import is not awaiting confirmation."},"download":{"not_available":"No report available for this import."},"errors":{"csv_at_least_one":"Upload at least one CSV file.","c