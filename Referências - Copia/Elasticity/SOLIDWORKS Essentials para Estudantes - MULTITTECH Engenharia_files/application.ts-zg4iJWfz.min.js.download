adas no ambiente."},list:{fields:{function:"Função de negócio",description:"Descrição",business_role_group:"Grupo de função de negócio",competencies:"Competências",professionals:"Pessoas",executors:"Executores",risk:"Risco",minimumExecutors:"Mínimo de executores",successors:"Sucessores",criticality:"Criticidade",areas:"Áreas",team_leader:"Líder de equipe"},risk:{low:"Baixo",medium:"Médio",high:"Alto",critical:"Crítico"},criticality:{low:"Baixa",medium:"Média",high:"Alta",critical:"Crítica"},actions:{delete:"Excluir",confirmDestroyMessage:"Esta ação não pode ser desfeita. Tem certeza que deseja excluir esta função de negócio?",confirmRemoveFromAreaMessage:"Esta ação não pode ser desfeita. Ao remover esta função da área, as pessoas vinculadas a ela nesta área perderão o vínculo com a função. Deseja continuar?",successDestroyMessage:"Função de negócio excluída com sucesso",errorDestroyMessage:"Erro ao excluir função de negócio",successionActions:"Ações"}},edit:{title:"Editar função de negócio",newTitle:"Criar função de negócio",tabs:{identification:"Identificação",assignedPeople:"Pessoas atribuídas",documents:"Documentos",competencies:"Competências",continuity:"Continuidade"},fields:{name:"Nome da função de negócio",description:"Descrição",testColor:"Cor de teste",business_role_group:"Grupo de função de negócio"},placeholder:{name:"Digite o nome da função de negócio",description:"Descreva a função de negócio...",business_role_group:"Selecione ou crie um grupo"},tooltip:{name:"Digite o nome que identifica esta função de negócio (ex: Desenvolvedor Frontend, Analista de Vendas).",description:"Descreva as responsabilidades e atribuições desta função de negócio",business_role_group:"Agrupe funções de negócio semelhantes para organizar listas e relatórios."},buttons:{save:"Salvar",cancel:"Cancelar",back:"Voltar",generateWithAI:"Gerar com IA"},validation:{name:{required:"O nome da função de negócio é obrigatório",maxLength:"O nome da função de negócio deve ter no máximo {max}