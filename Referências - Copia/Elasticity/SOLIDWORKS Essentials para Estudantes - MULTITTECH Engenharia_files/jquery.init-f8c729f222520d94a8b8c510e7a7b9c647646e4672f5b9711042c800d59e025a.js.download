settings_game_rules":"Game rules","settings_integrations":"Integrations","settings_organization":"Organization","settings_panels":"Panels","settings_plan":"Plan and subscription","settings_profiles":"Profiles and permissions","settings_security":"Security","shared_events":"Shares","signin":"Login","signup":"Register","skills":"Skills","subscribe":"Enrolled","subscription":"Subscription","succession_continuity":"Continuity","succession_continuity_actions":"Response actions","succession_continuity_analysis":"Individual analysis","succession_continuity_dashboard":"General dashboard","succession_continuity_individual_analysis":"Individual analysis","succession_continuity_parameters":"Parameters","succession_continuity_response_actions":"Response actions","suggested_events":"Suggested Events","team":"Team","team_leader_feedback_log":"Feedback and notes","team_leader_journey_agenda":"Agenda","team_leader_journey_executions":"Executions","team_leader_journey_standard":"Standard Journey","team_leader_journeys":"Journeys","team_leader_management_group":"Team management","team_leader_nine_box_view":"9-Box","team_leader_pdi":"IDP","team_leader_performance_development":"Development","team_leader_plans_and_goals":"Plans and Goals","team_leader_succession":"Continuity","team_leader_succession_actions":"Response actions","team_leader_succession_analysis":"Individual analysis","team_leader_succession_dashboard":"Overview dashboard","team_learning":"Learning","team_management_group":"Team management","team_records":"Team records","team_training_effectiveness":"Training effectiveness","toggle_menu":"Expand or collapse menu","trail":"My Learning Path","training_effectiveness":"Training effectiveness","user_panels":"User panels","users":"Users","versions_history":"VersionS HIstory","view_plans":"Check our plans","visualize_documentation":"View documentation"},"menu_tag":"Menu","message_duplicate_record_email":"User is already associated on the learning path: %{duplicate_record_email}","message_instructor":"Your course instructor %{event_name} sent you a message: \\u003cbr/\\u003e","message_onboarding_step_1":"To start using, we need to create your account, please enter your data.","message_onboarding_step_2":"We are completing your registration, now we need your organization\'s data and that\'s it.","message_students":"Message to student(s):","migration_partner_message":{"maintenance_notice":"\\u003cstrong\\u003eATTENTION:\\u003c/strong\\u003e The migration of your additional environment is scheduled for Friday, 06/26 starting at \\u003cstrong\\u003e7pm\\u003c/strong\\u003e! Your environment will be unavailable from \\u003cstrong\\u003eFriday (06/26)\\u003c/strong\\u003e at \\u003cstrong\\u003e7pm\\u003c/strong\\u003e until \\u003cstrong\\u003eSunday (06/28)\\u003c/strong\\u003e at \\u003cstrong\\u003e8am\\u003c/strong\\u003e. Some settings will not be migrated, so it is essential to check the details.","maintenance_notice_fallback":"Scheduled maintenance notice: The platform will be unavailable on a date and time to be announced.","maintenance_notice_link_text":"Learn more","maintenance_notice_modal":{"description":"Here you will find the information, including what will be migrated, the benefits, what will not be transferred and important guidance to follow the process.","intro":"We will perform a data migration on your additional environment on 06/26.","sections":[{"title":"What is being migrated","items":["Courses","Learning paths","Packages","General settings","Enrollments","Users","Engagement","Learning (Progress, Performance, Score)","Certificates","All other platform settings"]},{"title":"What are the benefits of the migration","items":["Ability to share content between your environments, choosing the free copy or controlled copy format","Ability to create content and quizzes directly from the additional environment","Ability to use our AI tools in the additional environment","Environment ready to receive future Twygo updates"]},{"title":"Why the migration is being made","items":["New features are arriving at Twygo","Older environments will not receive these updates","Soon, some older features will no longer be updated, leaving the additional environment outdated"]},{"title":"Changes","items":["Content that has quizzes with \\"Text\\" or \\"File\\" type questions will be migrated to the additional environment in the \\"Free copy\\" model. That is, the original content will remain in the main environment with all its history, and a copy of the content will be made to the additional environment, which can now edit it completely."]},{"title":"What will NOT be migrated","items":["If you used the \\"Communities\\" option in your additional environment, this information will not be migrated, so all news, discussions and interactions from this menu will not be transferred."],"note":"However, in the new environment, the use of this feature will remain available and you will be able to create new communities normally."},{"title":"Final guidance","items":["This migration is necessary so that your environment is up to date and compatible with all the new features.","The data migration will be performed only on your additional environment; the main environment will not have any changes.","If you have any impediment to the migration on this date or have additional questions about the process, contact the Twygo Support team via chat or by e-mail at suporte@twygo.com."]}]},"maintenance_notice_modal_title":"Additional environment migration – Twygo"},"min_length_json_error":"Provide at least 1 Student and 1 Content.","minimum_quantity_for_plan":"The minimum quantity for this plan is ","minimum_term_for_plan":"The minimum deadline for this plan is ","minimum_time_permanence":{"clock_title":"Minimum length of stay to complete this content.","modal_content":"When exiting this screen, the minimum stay time counter will be reset to zero. Are you sure you want to quit?","modal_title":"The dwell time counter will be reset.