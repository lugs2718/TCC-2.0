ift_edicao_de_conteudos:"Facelift edición de contenidos",nova_carga_horaria:"personalización del tipo de experiencia y carga de trabajo en minutos",horario_de_acesso:"Horario de acceso",assinatura_no_certificado:"Firma en el certificado",paineis_do_usuario:"Paneles del usuario",registros_avaliacao:"Registros de aprendizaje"},singleFeatureDetails:{registros_avaliacao:{title:"Sé un BETA tester y conoce Registros de aprendizaje de primera mano",customIntroduction:[{text:"Te invitamos al "},{text:"BETA de Registros de aprendizaje",bold:!0},{text:": la central para acompañar, validar y exportar todo lo que tu equipo aprende, dentro y fuera de Twygo."}],feature1:{title:"📊 Visión de todo el entorno:",description:"Acompaña en un panel los registros emitidos, pendientes, vencidos y rechazados, con la lista completa en un solo lugar."},feature2:{title:"✅ Validación en el flujo:",description:"Aprueba o rechaza los registros externos pendientes y registra experiencias para cualquier colaborador."},feature3:{title:"📦 Extracción masiva:",description:"Exporta registros y evidencias de una vez; recibes una notificación en cuanto el paquete queda listo."},betaWarning:"Por ser una versión BETA, puede recibir ajustes a lo largo del uso. Al final del período, se pondrá a disposición un formulario de feedback rápido"},paineis_do_usuario:{customIntroduction:[{text:"Te invitamos a participar del "},{text:"BETA",bold:!0},{text:" de "},{text:"Paneles del usuario",bold:!0},{text:", una nueva experiencia de "},{text:"dashboard",bold:!0},{text:", ahora construida con una estructura más flexible basada en "},{text:"widgets",bold:!0},{text:" 🚀"}],feature1:{title:"📊 Nuevo dashboard con más organización:",description:"Reestructuramos el dashboard del usuario, manteniendo la información principal como progreso, certificados, contenidos en curso y ranking, ahora en un formato más organizado y adaptable."},feature2:{title:"🧩 Gestión de paneles:",description:{text1:"Accede a la pestaña ",bold1:"Paneles",text2:", en la configuración de navegación, para organizar, reordenar y estructurar la información del dashboard, incluida la creación de pestañas."}}},horario_de_acesso:{feature1:{icon:"schedule",title:"⏰ Control de horario de acceso por modo de uso:",description:{text1:"ahora es posible definir ",bold1:"días",text2:" y ",bold2:"horarios de acceso",text3:" para los usuarios, de acuerdo con el modo de uso definido en tu entorno."}},feature2:{icon:"lock",title:"🔒 Restricción fuera del horario:",description:{text1:"fuera del horario configurado, el acceso puede ser ",bold1:"bloqueado",text2:" ",bold2:"automáticamente",text3:", garantizando más control en el uso de la plataforma."}}},analise_creditos_ia_beta_test:{feature1:{title:"💡 Control de créditos de IA más práctico: ",description:"Ahora puedes definir qué funcionalidades de IA deseas utilizar en tu organización y seguir fácilmente el uso de los créditos, incluyendo saldo disponible e historial de consumo."}}},betaWarning:"Por tratarse de una versión BETA, pueden ocurrir ajustes durante el uso.",betaWarningSecond:"Tu experiencia es muy importante y al final del período de pruebas, se pondrá a disposición un breve formulario de retroalimentación",betaWarningThird:"será disponible",multipleFeatures:{introduction:"Estamos emocionados de invitarte a participar en el BETA de dos mejoras que hacen la gestión de contenidos aún más flexible y precisa 🚀",collapseText:"Al convertirte en tester BETA podrás contribuir al desarrollo de la nueva funcionalidad, probándola de primera mano y dando tu opinión sobre lo que se puede mejorar. Y no te preocupes, puedes dejar la prueba cuando quieras.",collapseAttention:{bold:"Atención:",text:"Al participar, estas funcionalidades se",boldText:"activarán para todo tu entorno",text2:", permitiéndote utilizarlas y evaluarlas libremente durante este período de pruebas."},features:{experienceTypeCustomization:{title:"Personalización del tipo de experiencia",description:{text1:"Ahora puedes definir cómo se identificará el contenido en tu entorno, eligiendo exactamente cómo el estudiante visualiza cada contenido. Con el nuevo campo ",bold:'"Tipo de experiencia"',text2:", es posible personalizar etiquetas como ",italic:"Workshop, Masterclass, Bootcamp, Ebook",text3:", entre otros, yendo más allá de los formatos estándar."},description_bottom:"👉 Esta etiqueta es visible para el estudiante en el catálogo de contenidos, facilitando la comprensión de la experiencia ofrecida."},configurableWorkload:{title:"Carga horaria configurable en minutos",description:"¡La configuración de carga horaria es ahora más precisa! Ahora es posible definir el tiempo del contenido también en minutos, y no solo en horas."}}}},notification:{youAreInTheMode:"Estás en el modo",ofFuncionality:"de la funcionalidad",whichGoesUpTo:"que llega hasta",betaEndDate:"20/11",interruptBetaTest:"Interrumpir prueba BETA",answerResearch:"Responder investigación"},survey:{satisfactionLevel:"¿Cuál es tu nivel de satisfacción con la funcionalidad en relación a:",veryInSatisfied:"Muy insatisfecho",inSatisfied:"Insatisfecho",neutral:"Neutral",satisfied:"Satisfecho",verySatisfied:"Muy satisfecho",title:{onlyFeedback:"Cuéntanos sobre tu experiencia",beforeCancel:"Antes de cancelar la prueba BETA, cuéntanos sobre tu experiencia",endOfBeta:"La prueba BETA de la funcionalidad",endOfBetaEnd:"ha llegado a su fin. ¡Cuéntanos como fue tu experiencia "},buttonText:{onlyFeedback:"Enviar respuestas",beforeCancel:"Enviar e interrumpir la prueba",endOfBeta:"Enviar"},questions:{userXP:"¿Experiencia del usuario?",contributionToImproveManagement:"¿Contribución para mejorar la gestión de tus cursos/universidad corporativa?",contributionToImproveLearningExperience:"¿Contribución para mejorar la experiencia de aprendizaje de los alumnos?",contributionToIncreaseEngagement:"¿Contribución para aumentar el compromiso de los alumnos?",contributionToFacilitateCreation:"¿Contribución para facilitar la creación de nuevo conteni